#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Unkeny — moteur de jeu 2D sur NKCanvas (C++17)
==============================================
Il COMPOSE ce que le depot porte deja, et n'en reecrit rien :
  NKECS       entites, composants, requetes
  NKCollision formes 2D deja ecrites (Circle2D, Box2D, Capsule2D...)
  NKPhysics   corps rigides, solveur, joints
  NKCanvas    rendu 2D, coquille d'application (NkCanvasApp), zone sure
  NKGui       liste d'affichage et polices

⚠️ NKRENDERER EST ABSENT DE CETTE LISTE, ET C'EST LE POINT.
NKCanvas et NKRenderer sont EXCLUSIFS par regle du depot : une fenetre utilise
l'un ou l'autre, jamais les deux (NKCanvas possede ses propres backends, il
n'est pas un client de NKRHI). Noge est le moteur 3D sur NKRenderer ; Unkeny est
le moteur 2D sur NKCanvas. Ajouter NKRenderer ici casserait la presentation.

Emplacement : Engine/Unkeny — un moteur vit dans Engine.
Son editeur   : Applications/UnkenyEditor — un outil vit dans Applications, et
                il consomme le moteur, jamais l'inverse.

A inclure depuis le workspace racine (Nkentseu.jenga) :

    with include("Engine/Unkeny/Unkeny.jenga"):
        pass
"""

from Jenga import *
from jengaconfig import *


with project("Unkeny"):
    language("C++")
    cppdialect("C++17")
    location(".")

    nkentseudependson(
        ["NKPlatform", "NKCore", "NKMemory", "NKContainers", "NKMath",
         "NKLogger", "NKTime", "NKStream", "NKFileSystem", "NKEvent",
         "NKWindow", "NKCanvas", "NKFont", "NKImage", "NKGui",
         "NKECS", "NKCollision", "NKPhysics"],
        selfexport="Unkeny",
        extra_includes=["src"],
    )

    files([
        "src/**.cpp",
    ])

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}")

    # ===== Windows ================================================================
    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])

    # ===== Linux ==================================================================
    with filter("system:Linux && options:linux-backend=headless || system:Linux && options:headless"):
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-headless/%{prj.name}")
        targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}-headless")

    with filter("system:Linux && options:linux-backend=xcb"):
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-xcb/%{prj.name}")
        targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}-xcb")

    with filter("system:Linux && options:linux-backend=wayland"):
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-wayland/%{prj.name}")
        targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}-wayland")

    # ===== macOS ==================================================================
    with filter("system:macOS"):
        usetoolchain("clang-native")

    # ===== Android ================================================================
    with filter("system:Android"):
        usetoolchain("android-ndk")
        androidminsdk(24)
        androidtargetsdk(34)
        androidcompilesdk(34)
        androidabis(["armeabi-v7a", "arm64-v8a", "x86", "x86_64"])

    # ===== HarmonyOS ==============================================================
    with filter("system:HarmonyOS"):
        usetoolchain("ohos-ndk")

    # ===== Web ====================================================================
    with filter("system:Web"):
        usetoolchain("emscripten")

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

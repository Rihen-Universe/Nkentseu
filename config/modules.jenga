    "NKAnimation"    : _m("NKENTSEU_ANIMATION",    ["NKPlatform", "NKCore", "NKMemory", "NKContainers", "NKLogger", "NKMath", "NKFileSystem"]),
    "NKNavigation"   : _m("NKENTSEU_NAVIGATION",   ["NKPlatform", "NKCore", "NKMemory", "NKContainers", "NKLogger", "NKMath", "NKCollision"]),

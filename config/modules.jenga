    "NKAgent"        : _m("NKENTSEU_AGENT",         ["NKPlatform", "NKCore", "NKMemory", "NKContainers", "NKMath", "NKLogger", "NKTensor", "NKRL", "NKInfer"]),
    "NKEvolve"       : _m("NKENTSEU_EVOLVE",        ["NKPlatform", "NKCore", "NKMemory", "NKContainers", "NKMath", "NKLogger"]),
    # NKCivilization (Phase 5) : agents Phase 4 comme entites NKECS — depend de
    # NKECS (Runtime) et NKAgent, JAMAIS d'Engine/Noge (pas de remontee de couche).
    "NKCivilization" : _m("NKENTSEU_CIVILIZATION",  ["NKPlatform", "NKCore", "NKMemory", "NKContainers", "NKMath", "NKLogger", "NKTensor", "NKRL", "NKAgent", "NKECS"]),
    # NKEmbodied (Phase 6) : abstraction capteurs/actionneurs + corps simule,
    # boucle perception -> decision (NKAgent) -> action. Ne depend PAS de
    # Kernel/Bare au Jalon 1 (cf ROADMAP : Jalon 3 = branchement reel).
    "NKEmbodied"     : _m("NKENTSEU_EMBODIED",      ["NKPlatform", "NKCore", "NKMemory", "NKContainers", "NKMath", "NKLogger", "NKTensor", "NKRL", "NKAgent"]),
    "NKGen"          : _m("NKENTSEU_GEN",           ["NKPlatform", "NKCore", "NKMemory", "NKContainers", "NKMath", "NKLogger", "NKTensor", "NKAutograd", "NKNN"]),
    "NKGpt"          : _m("NKENTSEU_GPT",           ["NKPlatform", "NKCore", "NKMemory", "NKContainers", "NKMath", "NKLogger", "NKTensor", "NKAutograd", "NKNN", "NKOptim", "NKFileSystem", "NKTime", "NKData"]),
    "NKSpeech"       : _m("NKENTSEU_SPEECH",        ["NKPlatform", "NKCore", "NKMemory", "NKContainers", "NKMath", "NKLogger"]),


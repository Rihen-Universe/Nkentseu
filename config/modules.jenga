    "NKGLSlang"      : _m(None, [], includes=["%{NKGLSlang.location}"]),       # glslang : <glslang/Public/ShaderLang.h>
    "NKSPIRVCross"   : _m(None, [], includes=["%{NKSPIRVCross.location}/src"]),# SPIRV-Cross
    "NKShaderc"      : _m(None, [], includes=["%{NKShaderc.location}/include"]),
    # Mbed-TLS (TLS/HTTPS, C pur) — opt-in via NK_ENABLE_TLS (cf NKNetwork.jenga) :
    "NKMbedTLS"      : _m(None, [], includes=["%{NKMbedTLS.location}/include"]),
}

# Retro-compat : anciennes cles courtes ("core", "rhi"...) -> nom de projet exact.
_ALIASES: dict = {
    "platform": "NKPlatform", "core": "NKCore", "memory": "NKMemory",
    "containers": "NKContainers", "math": "NKMath", "threading": "NKThreading",
    "logger": "NKLogger", "filesystem": "NKFileSystem", "stream": "NKStream",
    "time": "NKTime", "reflection": "NKReflection", "serialization": "NKSerialization",
    "network": "NKNetwork", "event": "NKEvent", "window": "NKWindow", "canvas": "NKCanvas",
    "nksl": "NKSL", "rhi": "NKRHI", "renderer": "NKRenderer", "image": "NKImage",
    "font": "NKFont", "ecs": "NKECS", "camera": "NKCamera", "collision": "NKCollision", "physics": "NKPhysics", "animphysics": "NKAnimPhysics", "animation": "NKAnimation", "navigation": "NKNavigation", "ui": "NKUI", "audio": "NKAudio", "xr": "NKXR",
    "noge": "Noge", "engine": "Noge", "nkentseu": "Noge", "glad": "NKGlad", "gui": "NKGui",
}

# =============================================================================
# SECTION 3 : HELPERS INTERNES
# =============================================================================

def _resolve_key(name: str):
    """Nom de projet exact (NKCore) OU ancienne cle courte (core) -> cle canonique."""
    n = (name or "").strip()
    if n in _REGISTRY:
        return n
    low = n.lower()
    if low in _ALIASES:
        return _ALIASES[low]
    for k in _REGISTRY:
        if k.lower() == low:
            return k
    return None


def _require_key(name: str, who: str) -> str:
    k = _resolve_key(name)
    if k is None:
        raise KeyError(
            f"[modules.jenga] {who} : module inconnu '{name}'.\n"
            f"  Modules disponibles : {sorted(_REGISTRY.keys())}"
        )
    return k


def _includes_of(key: str) -> list:
    """Includedirs d'un module : surcharge si fournie, sinon %{<cle>.location}/src."""
    e = _REGISTRY.get(key)
    if e is None:
        return []
    if e.get("includes") is not None:
        return list(e["includes"])
    return [f"%{{{key}.location}}/src"]


def _collect_transitive(key: str, visited: set) -> None:
    """DFS : remplit `visited` avec key + toutes ses dependances transitives."""
    if key in visited:
        return
    visited.add(key)
    entry = _REGISTRY.get(key)
    if entry is None:
        return
    for d in entry["deps"]:
        _collect_transitive(_resolve_key(d) or d, visited)


# =============================================================================
# SECTION 4 : useglobalkind / useappdeps (compat — cas particuliers)
# =============================================================================

def useglobalkind(modulename: str) -> None:
    """
    LIB : declare kind + macro d'export du module courant, et emet les defines
    _STATIC_LIB de toutes ses dependances transitives (mode STATIC).
    A appeler dans `with project("NKxxx"):`. Accepte nom complet ou cle courte.
    """
    key = _require_key(modulename, "useglobalkind")
    kindexport(_GLOBAL_KIND, _REGISTRY[key]["export"])

    # Backend de fenetrage : AUSSI par ce chemin de compatibilite. L'oublier ici
    # laissait 4 projets (DemoRW, Pong copy, Pong2, RendererSandbox) sans le
    # define ni les dossiers par backend — donc exposes a la meme violation
    # d'ODR que celle corrigee dans nkentseudependson(). Un projet UTILISATEUR
    # qui suit l'exemple de DemoRW heriterait du defaut.
    _emit_linux_backend_defines(True)

    if _GLOBAL_KIND != ProjectKind.STATIC_LIB:
        return
    visited: set = set()
    _collect_transitive(key, visited)
    visited.discard(key)
    dep_defines = [
        f"{_REGISTRY[d]['export']}_STATIC_LIB"
        for d in visited
        if d in _REGISTRY and _REGISTRY[d]["export"]
    ]
    if dep_defines:
        defines(sorted(dep_defines))


def useappdeps(*modulekeys: str) -> None:
    """
    APP : emet les defines _STATIC_LIB pour les modules listes + leur transitif
    (mode STATIC). Ne configure PAS le kind. Accepte noms complets ou cles courtes.
    """
    # Backend de fenetrage : emis AVANT le retour anticipe ci-dessous, sinon en
    # mode SHARED_LIB une application n'aurait ni le define ni ses dossiers par
    # backend. C'est une APP : sorties dans Build/Bin/<cfg>-<sys>-<backend>.
    _emit_linux_backend_defines(False)

    if _GLOBAL_KIND != ProjectKind.STATIC_LIB:
        return
    visited: set = set()
    for name in modulekeys:
        _collect_transitive(_require_key(name, "useappdeps"), visited)
    dep_defines = [
        f"{_REGISTRY[d]['export']}_STATIC_LIB"
        for d in visited
        if d in _REGISTRY and _REGISTRY[d]["export"]
    ]
    if dep_defines:
        defines(sorted(dep_defines))


# =============================================================================
# SECTION 5 : nkentseudependson — LE helper general
# =============================================================================

class _DepSpec:
    """Specification d'une dependance avec modificateurs (cf. dep())."""
    __slots__ = ("name", "include", "link", "kind")
    def __init__(self, name, include=True, link=True, kind=None):
        self.name = name; self.include = include; self.link = link; self.kind = kind


def dep(name: str, include: bool = True, link: bool = True, kind=None) -> "_DepSpec":
    """
    Modificateur de dependance pour nkentseudependson([...]) :
      • include=False : pas d'includedir (link + dependson seulement, API privee).
      • link=False    : pas de link/dependson (includedir seulement, header-only).
      • kind="static" | "dynamic" : force le linkage de CETTE dep (sinon = global).
                        "dynamic" -> aucun define _STATIC_LIB pour cette dep.
    Ex. : dep("NKGlad", link=False), dep("NKAudio", include=False), dep("X", kind="dynamic")
    """
    return _DepSpec(name, include=include, link=link, kind=kind)


def nkentseudependson(deps=None, selfexport=None, extra_includes=None, extra_links=None, extra_defines=None) -> None:
    """
    Gere TOUT le graphe de dependances d'un projet (app OU lib) en un appel :
    emet includedirs + (links) + dependson + defines(_STATIC_LIB), transitif resolu.

    deps : liste de noms de modules (str) et/ou dep(...) pour les modificateurs.
           Pour une LIB, peut etre omis (les deps directes viennent du registre).
    selfexport : nom de CE module (mode LIB). Declare alors son kind + macro
           d'export (kindexport) et NE LINKE PAS les deps NK (juste dependson +
           includedirs + defines). Sinon = mode APP (link des deps).
    extra_includes / extra_links / extra_defines : ajouts SPECIFIQUES a ce projet
        (SDK Vulkan, libs systeme, son propre "src", externals...) — hors registre.

    Ex. (application) :
        nkentseudependson(["NKCanvas", "NKAudio", "NKUI", "NKNetwork"],
                          extra_includes=["src"])
    Ex. (lib) :
        nkentseudependson(["NKWindow", "NKFont", "NKImage", "NKGlad"],
                          selfexport="NKCanvas")
    """
    # 0. Mode LIB : selfexport = nom de CE module -> declare son kind/export et
    #    NE linke PAS ses deps NK (juste dependson). Mode APP sinon (link deps).
    is_lib  = selfexport is not None
    selfkey = _require_key(selfexport, "nkentseudependson") if is_lib else None
    if is_lib:
        kindexport(_GLOBAL_KIND, _REGISTRY[selfkey]["export"])
    if deps is None:
        deps = list(_REGISTRY[selfkey]["deps"]) if is_lib else []

    # 1. Normaliser en specs + indexer les deps explicitement listees (modificateurs).
    explicit: dict = {}
    for d in deps:
        spec = d if isinstance(d, _DepSpec) else _DepSpec(d)
        key = _require_key(spec.name, "nkentseudependson")
        explicit[key] = spec

    # 2. Fermeture transitive (les deps transitives prennent le comportement par defaut).
    visited: set = set()
    for key in explicit:
        _collect_transitive(key, visited)

    # 3. Construire les listes a emettre.
    # LIB : ses propres includes ("src" + "pch") sont toujours au meme endroit par
    # convention -> ajoutes AUTOMATIQUEMENT (pas besoin de les passer en
    # extra_includes). "pch" inexistant (lib sans PCH) = -I ignore, sans effet.
    inc: list = ["src", "pch"] if is_lib else []
    lnk: list = []
    dpn: list = []
    defs: list = []
    for key in sorted(visited):
        e = _REGISTRY.get(key)
        if e is None:
            continue
        spec = explicit.get(key)              # None => dependance transitive
        want_inc  = spec.include if spec else True
        want_link = spec.link    if spec else True

        if want_inc:
            inc += _includes_of(key)
        if want_link and e.get("linkable", True):
            dpn.append(key)
            if not is_lib:            # une LIB ne linke pas ses deps NK (juste dependson)
                lnk.append(key)

        # static define : pour les deps dont on inclut les headers, en mode static.
        if spec is not None and spec.kind == "dynamic":
            is_static = False
        elif spec is not None and spec.kind == "static":
            is_static = True
        else:
            is_static = (_GLOBAL_KIND == ProjectKind.STATIC_LIB)
        if want_inc and is_static and e.get("export"):
            defs.append(f"{e['export']}_STATIC_LIB")

    # 4. Extras specifiques au projet (hors registre).
    if extra_includes:
        inc += list(extra_includes)
    if extra_links:
        lnk += list(extra_links)
    if extra_defines:
        defs += list(extra_defines)

    # 5. Emettre (dedup en preservant l'ordre pour les includes/links).
    def _dedup(seq):
        seen = set(); out = []
        for x in seq:
            if x not in seen:
                seen.add(x); out.append(x)
        return out

    if inc:
        includedirs(_dedup(inc))
    if lnk:
        links(_dedup(lnk))
    if dpn:
        dependson(_dedup(dpn))
    if defs:
        defines(sorted(set(defs)))

    # 6. Backend de fenetrage Linux : TOUS les projets doivent voir le MEME
    #    define ET ecrire dans des dossiers SEPARES par backend.
    _emit_linux_backend_defines(is_lib)


# =============================================================================
# BACKEND DE FENETRAGE LINUX — pourquoi ce define doit etre PARTOUT
# =============================================================================
# NkWindow.h inclut une classe native DIFFERENTE selon le backend choisi
# (NkXCBWindow, NkXLibWindow, NkWaylandWindow), et ces classes n'ont pas la meme
# taille. sizeof(NkWindow) depend donc du backend, et tout ce qui contient une
# fenetre change de disposition memoire avec lui.
#
# Tant que ce define n'etait pose que dans les Applications/*.jenga, les modules
# du moteur compilaient en detection AUTOMATIQUE (repli XLib) pendant que
# l'application compilait en XCB : deux dispositions de la meme classe dans un
# seul binaire — une violation d'ODR. Symptome observe : segfault au demarrage
# de NKCode/XCB dans LoadUiFont, parce que mFontPrefs etait lu 8 octets a cote.
# La variante XLib ne fonctionnait que par COINCIDENCE, son choix correspondant
# au repli auto-detecte.
#
# Les .jenga des modules reglaient deja objdir/targetdir par backend (pour que
# les artefacts ne se melangent pas) mais JAMAIS le define — d'ou l'illusion que
# la separation par backend etait complete.
#
# ATTENTION : ne pas tenter de poser ces defines au niveau WORKSPACE. Dans
# Jenga, defines() n'agit que s'il existe un projet ou une toolchain courante ;
# hors projet, l'appel est ignore SILENCIEUSEMENT (Core/Api.py, def defines).
# C'est ici, dans le helper que chaque projet appelle, que le define porte.
# =============================================================================
# SEPARATION DES DOSSIERS DE SORTIE — indissociable du define
#
# Poser le define ne suffit PAS : il faut aussi que chaque backend ait ses
# propres dossiers d'objets et de bibliotheques. Sinon un build INCREMENTAL
# melange les deux, et le defaut d'ODR revient par une autre porte :
#
#   1. `build --linux-backend xlib` compile NKContainers.a avec XLIB_ONLY
#      dans Build/Lib/Debug-Linux/ ;
#   2. `build --linux-backend xcb` retrouve ce meme chemin « a jour » et ne
#      le RECOMPILE PAS — la bibliotheque reste en XLIB_ONLY ;
#   3. NKEditorKit, lui, avait deja ses dossiers par backend et compile en
#      XCB_ONLY.
#   -> deux dispositions memoire dans un seul binaire -> segfault au demarrage.
#
# Constate en pratique : un build PROPRE fonctionnait, un build incremental
# apres l'autre backend plantait. Seuls 18 modules sur 57 declaraient ces
# dossiers dans leur .jenga ; les 39 autres partageaient Debug-Linux.
# On les emet donc ICI, au meme endroit que le define, pour que les deux ne
# puissent plus diverger.
def _emit_linux_backend_defines(is_lib: bool = True) -> None:
    # Les bibliotheques vont dans Build/Lib/<cfg>-<sys>-<backend>, les
    # executables dans Build/Bin/<cfg>-<sys>-<backend>/<projet> : meme
    # convention que celle deja ecrite a la main dans les 18 .jenga.
    outroot = "Lib" if is_lib else "Bin"
    outleaf = "" if is_lib else "/%{prj.name}"

    def _dirs(suffix: str) -> None:
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-" + suffix + "/%{prj.name}")
        targetdir("%{wks.location}/Build/" + outroot + "/%{cfg.buildcfg}-%{cfg.system}-" + suffix + outleaf)

    with filter("system:Linux && options:linux-backend=xcb"):
        defines(["NKENTSEU_FORCE_WINDOWING_XCB_ONLY"])
        _dirs("xcb")
    with filter("system:Linux && options:linux-backend=wayland"):
        defines(["NKENTSEU_FORCE_WINDOWING_WAYLAND_ONLY"])
        _dirs("wayland")
    with filter("system:Linux && options:linux-backend=headless || system:Linux && options:headless"):
        defines(["NKENTSEU_FORCE_WINDOWING_NOOP_ONLY"])
        _dirs("headless")
    # XLib reste sur Build/Lib/<cfg>-<sys> SANS suffixe : c'est le backend par
    # defaut, et changer son chemin invaliderait tous les caches existants
    # ainsi que les scripts qui pointent dessus.
    with filter("system:Linux && options:linux-backend=xlib || system:Linux && !options:linux-backend && !options:headless"):
        defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])

    # correction de pose et de clip). CPU pur, headless, Foundation seule.
    # ATTENTION : ne depend PAS de NKPhysics, et ce n est pas un oubli -- tout y est
    # CINEMATIQUE, jamais dynamique. Le jour ou le pont sera cree, il se branche sur
    # NKPhysics/NkRagdoll (qui expose deja Build/ReadPose/SetActive/SetPoseTargets),
    # jamais sur un second pont. Voir l en-tete de NKAnimPhysics.jenga.
    "NKAnimPhysics"  : _m("NKENTSEU_ANIMPHYSICS",  ["NKPlatform", "NKCore", "NKMemory", "NKContainers", "NKLogger", "NKMath"]),
    # NKAnimation : substrat d animation (clips, blend, HFSM, reciblage, motion

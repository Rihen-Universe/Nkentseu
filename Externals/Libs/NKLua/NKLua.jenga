#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# AUTEUR : TEUGUIA TADJUIDJE Rodolf Séderis — Rihen
"""
NKLua — Lua 5.5.1 (MIT, Lua.org, PUC-Rio), bibliothèque TIERCE copiée sans modification (voir LISEZMOI.md).
Agent scripts-2, 25/11/2026 (ordre de Rodolf : AngelScript, Lua, puis PocketPy).

- Cible à part, bibliothèque statique en C du seul code tiers (sdk/lua/src), sans lua.c ni luac.c (les
  interpréteurs autonomes, qui ont leur main). Ses avertissements sont coupés ICI seulement (-w).
- Aucun banc ici : un banc d'une cible C serait compilé en C (Jenga : le banc hérite du langage de son
  parent). Le banc de la bibliothèque seule et l'hôte vivent dans Noge :
  Engine/Noge/tests/test_lua_*.cpp et Engine/Noge/src/Noge/ECS/Scripting/Lua/.

Usage : dependson(["NKLua"]) ; includedirs(["%{NKLua.location}/sdk/lua/src"]) ; links(["NKLua"]).
"""
from Jenga import *
from jengaconfig import *

with project("NKLua"):
    staticlib()
    language("C")
    location(".")

    includedirs(["sdk/lua/src"])
    files([
        "sdk/lua/src/*.c",
        "sdk/lua/src/*.h",
    ])
    # Les interpréteurs autonomes (main) ne font pas partie de la bibliothèque.
    excludefiles(["sdk/lua/src/lua.c", "sdk/lua/src/luac.c"])
    # Code tiers : ses avertissements ne sont pas les nôtres ; coupés pour CETTE cible seulement.
    buildoptions(["-w"])

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain("nk-windows-clang-mingw")
    with filter("system:Windows && options:windows-runtime=uwp"):
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-uwp/%{prj.name}")
        targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}-uwp")
    with filter("system:Android"):
        buildoptions(["-fPIC"])
    with filter("system:Linux || system:macOS || system:Android || system:iOS"):
        defines(["LUA_USE_POSIX"])
    with filter("config:Debug"):
        defines(["_DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

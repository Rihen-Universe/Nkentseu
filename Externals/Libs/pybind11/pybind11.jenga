#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
pybind11 (v2.13.6) — HEADER-ONLY. Rien a compiler : il suffit d'ajouter le
repertoire include/ aux includedirs du consommateur.

Usage dans un autre .jenga (PAS de links) :
    includedirs(["%{pybind11.location}/include"])   # <pybind11/embed.h>, <pybind11/pybind11.h>

Necessite un compilateur C++14 minimum (Nkentseu compile deja en C++17+) et
d'etre linke avec l'embeddable Python (voir Externals/Libs/PythonEmbed) pour
tout usage de pybind11::scoped_interpreter/PYBIND11_EMBEDDED_MODULE.
"""
from Jenga import *

with project("pybind11"):
    staticlib()
    language("C++")
    location(".")
    includedirs(["include"])
    # Header-only : aucun fichier source. Les consommateurs ajoutent l'include path.
    files([])
    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}")

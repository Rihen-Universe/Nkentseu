#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
NKFileSystem – Gestion système de fichiers (C++17)
==================================================
Système de gestion de fichiers haute performance avec support
cross-platform, file watching, et path manipulation.

Contenu (src/NKFileSystem/) :
  NkFileSystem.h/cpp   => Classe principale + infos système
  NkFile.h/cpp         => Opérations fichier (R/W/Seek)
  NkDirectory.h/cpp    => Navigation répertoires
  NkPath.h/cpp         => Manipulation chemins (cross-platform)
  NkFileWatcher.h/cpp  => Monitoring changements fichiers (async)
"""

from Jenga import *
from jengaconfig import *

with project("NKFileSystem"):
    nkentseudependson(
        ["NKCore", "NKPlatform", "NKMemory", "NKContainers", "NKThreading", "NKLogger"],
        selfexport="NKFileSystem",
        extra_includes=["src", "pch"],
    )

    language("C++")
    cppdialect("C++17")
    location(".")

    pchheader("pch/pch.h")
    pchsource("pch/pch.cpp")

    files([
        "src/NKFileSystem/**.cpp",
        "src/NKFileSystem/**.h",
    ])

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}")

    with filter("system:Windows && options:windows-runtime=uwp"):
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-uwp/%{prj.name}")
        targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}-uwp")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
    with filter("system:UWP || system:Windows && options:windows-runtime=uwp"):
        usetoolchain("xbox-clang")
    with filter("system:Linux"):
        links(["pthread"])
    with filter("system:macOS"):
        usetoolchain("clang-native")
        links(["pthread"])
    with filter("system:Android"):
        usetoolchain("android-ndk")
        links(["log"])
    with filter("system:HarmonyOS"):
        # NDK OHOS clang (meme contrainte qu'Android)
        usetoolchain("ohos-ndk")
        # rawfile.z : NkFile.cpp appelle OH_ResourceManager_* pour lire les
        # ressources empaquetees dans le HAP. Declarer ce besoin ICI plutot que
        # dans chaque application est la seule facon qu'il ne soit pas oublie :
        # une archive statique ne lie rien, et le manque ne se voyait qu'au
        # CHARGEMENT de l'application finale — « relocating failed: symbol not
        # found ... OH_ResourceManager_CloseRawFile64 » — apres quoi le module
        # natif n'etait jamais charge et le code C++ ne demarrait pas du tout.
        # Jenga propage les bibliotheques systeme des dependances : toute
        # application utilisant NKFileSystem en herite desormais.
        links(["hilog_ndk.z", "rawfile.z"])
    with filter("system:Web"):
        usetoolchain("emscripten")
    with filter("system:XboxSeries || system:XboxOne"):
        usetoolchain("xbox-clang")

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG", "NKENTSEU_DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

    # Tests unitaires/stress (desktop uniquement)
    with filter("(system:Linux || system:macOS || (system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne)) && !system:Android && !system:iOS || system:Web"):
        with test():
            testfiles(["tests/**.cpp"])

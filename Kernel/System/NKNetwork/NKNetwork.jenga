#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
NKNetwork – Système de réflexion runtime (C++17)
==================================================
Système complet de réflexion permettant l'introspection de types,
classes, propriétés et méthodes. Support des macros de registration.

Contenu (src/NKNetwork/) :
  NkType.h/cpp         => Information type (RTTI sans dépendance std)
  NkClass.h/cpp        => Description classe
  NkProperty.h/cpp     => Propriété member
  NkMethod.h/cpp       => Méthode membre avec invocation
  NkRegistry.h/cpp     => Registre global + macros
"""

from Jenga import *
from jengaconfig import *
import os

# TLS/HTTPS : ACTIVE PAR DEFAUT depuis le 2026-08-11 (backend mbed-TLS, C pur,
# cross-compile pour toutes les plateformes y compris iOS).
#
# POURQUOI CE CHANGEMENT DE DEFAUT. Il etait auparavant opt-in par la variable
# NK_ENABLE_TLS, et l'oubli ne se voyait qu'a l'execution : toute requete vers une
# adresse en https rendait un code 0. Or le web est aujourd'hui en https quasi
# partout — un client HTTP sans TLS ne sert a rien dans les faits, et son absence
# se paie en heures de diagnostic pour un reglage qu'on ne pouvait pas deviner.
# Un defaut qu'il faut penser a activer pour que la chose marche est un mauvais
# defaut.
#
# NK_DISABLE_TLS=1 permet de s'en passer (cible embarquee sans pile TLS, ou
# construction volontairement minimale).
# ⚠️ REVENU EN OPTION le 2026-08-11. Active par defaut, mbed-TLS a fait
# DISPARAITRE la lecture des PDF dans la meme construction : un document qui
# rendait 21 Mo de contenu et 2 000 000 d'operations n'etait plus ouvert du tout.
# Les deux ne coexistent pas encore, et une fonctionnalite qui en casse une autre
# en silence ne peut pas etre un defaut. A rouvrir quand la cause sera trouvee
# (piste : conflit de symbole entre mbed-TLS et le decompresseur du PDF).
_TLS_OPT = os.getenv("NK_ENABLE_TLS", "").strip().lower()
_WANT_MBEDTLS = _TLS_OPT in ("1", "true", "on", "yes", "mbedtls")

_NET_DEPS = ["NKCore", "NKPlatform", "NKMemory", "NKContainers", "NKLogger", "NKThreading", "NKMath", "NKTime", "NKFileSystem"]
_NET_INCLUDES = ["src", "pch"]
_NET_DEFINES = []
if _WANT_MBEDTLS:
    _NET_DEPS.append("NKMbedTLS")
    _NET_INCLUDES.append("%{wks.location}/Externals/Libs/NKMbedTLS/include")
    _NET_DEFINES.append("NKENTSEU_HTTP_USE_MBEDTLS")


with project("NKNetwork"):
    nkentseudependson(
        _NET_DEPS,
        selfexport="NKNetwork",
        extra_includes=_NET_INCLUDES,
        extra_defines=_NET_DEFINES,
    )

    language("C++")
    cppdialect("C++17")
    location(".")

    pchheader("pch/pch.h")
    pchsource("pch/pch.cpp")

    files([
        "src/NKNetwork/**.cpp",
        "src/NKNetwork/**.h",
    ])

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}")

    with filter("system:Windows && options:windows-runtime=uwp"):
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-uwp/%{prj.name}")
        targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}-uwp")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        # Winsock : socket/bind/listen/htons/getaddrinfo... Le module se COMPILAIT
        # sans, mais toute application qui le lie echouait a l'edition de liens
        # (« undefined reference to __imp_ntohs »). Le manque ne s'est vu qu'au
        # premier executable Windows a dependre de NKNetwork.
        links(["ws2_32"])
    with filter("system:UWP || system:Windows && options:windows-runtime=uwp"):
        usetoolchain("xbox-clang")
    with filter("system:Linux"):
        links(["pthread"])
    with filter("system:macOS"):
        usetoolchain("clang-native")
    with filter("system:Android"):
        usetoolchain("android-ndk")
        links(["log"])
    with filter("system:HarmonyOS"):
        # NDK OHOS clang (meme contrainte qu'Android)
        usetoolchain("ohos-ndk")
        links(["hilog_ndk.z"])
    with filter("system:Web"):
        usetoolchain("emscripten")
    with filter("system:XboxSeries || system:XboxOne"):
        usetoolchain("xbox-clang")

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG", "NKENTSEU_DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

    # Tests unitaires/stress (desktop uniquement)
    with filter("(system:Linux || system:macOS || (system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne)) && !system:Android && !system:iOS || system:Web"):
        with test():
            testfiles(["tests/**.cpp"])

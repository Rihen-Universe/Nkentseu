#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
NKTensor — tenseurs n-dim CPU (NKAI, C++17)
===========================================
Brique de base du sous-système IA : tableaux n-dimensionnels + opérations
(élémentaires, broadcasting, matmul, réductions), backend CPU.

Backend GPU (NKRHI compute) = Jalon 3 : ajouter NKRHI aux dépendances à ce
moment-là. Pour l'instant, dépendances CPU uniquement (Foundation).
Namespace : nkentseu::ai. Cf Kernel/AI/ARCHITECTURE.md.
"""

from Jenga import *
from jengaconfig import *

with project("NKTensor"):
    language("C++")
    cppdialect("C++17")
    location(".")

    # Backend GPU (Jalon 3) : NKRHI compute + NKSL (kernels écrits en NkSL,
    # convertis via glslang/SPIRV-Cross). Cf src/NKTensor/NkTensorGpu.{h,cpp}.
    # NKGlad est indispensable ici : NKRHI expose NkDeviceInitInfo.h, qui inclut
    # <glad/egl.h> sur Android/HarmonyOS. Sans le repertoire d'include de NKGlad,
    # NkTensorGpu.cpp echoue en "fatal error: 'glad/egl.h' file not found" et tout
    # build mobile d'une application qui tire NKTensor (dont renderdemo) est bloque.
    _tensorDeps = ["NKCore", "NKPlatform", "NKMemory", "NKContainers", "NKMath", "NKLogger",
                   "NKRHI", "NKSL", "NKGLSlang", "NKSPIRVCross"]
    if USE_NKGLAD:
        _tensorDeps.append("NKGlad")

    nkentseudependson(
        _tensorDeps,
        selfexport="NKTensor",
        extra_includes=["src", "%{wks.location}/Externals"],
    )

    files([
        "src/NKTensor/**.cpp",
        "src/NKTensor/**.h",
    ])

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}")

    with filter("system:Windows && options:windows-runtime=uwp"):
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-uwp/%{prj.name}")
        targetdir("%{wks.location}/Build/Lib/%{cfg.buildcfg}-%{cfg.system}-uwp")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
    with filter("system:UWP || system:Windows && options:windows-runtime=uwp"):
        usetoolchain("xbox-clang")
    with filter("system:macOS"):
        usetoolchain("clang-native")
    with filter("system:Android"):
        usetoolchain("android-ndk")
    with filter("system:HarmonyOS"):
        usetoolchain("ohos-ndk")
    with filter("system:Web"):
        usetoolchain("emscripten")
    with filter("system:XboxSeries || system:XboxOne"):
        usetoolchain("xbox-clang")

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

    # Tests / démos (desktop uniquement)
    with filter("(system:Linux || system:macOS || (system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne)) && !system:Android && !system:iOS || system:Web"):
        with test():
            testfiles(["tests/**.cpp"])

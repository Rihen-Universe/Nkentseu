#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
NogeDemo — le PREMIER RESULTAT de Noge, de bout en bout (2026-09-30)
=====================================================================
Une scene 3D jouee par le VRAI chemin du moteur : NkApplication + NkEngineLayer
(ECS, pont physique NkPhysicsSystem, pont de rendu NkRenderSystem) et la carte
d'entree du noyau (NkInputMap, la meme qu'Unkeny). Sauver / recharger par
NkSceneSerializer. Voir Engine/Noge/ETAT_2026-09-30.md.

    jenga build --target NogeDemo
    ./Build/Bin/Debug-Windows/NogeDemo/NogeDemo.exe              (depuis la racine)
    ./Build/Bin/Debug-Windows/NogeDemo/NogeDemo.exe --selftest
    ./Build/Bin/Debug-Windows/NogeDemo/NogeDemo.exe --capture=Build/NogeDemo/capture.png

Plateformes : le code est celui du moteur (multi-plateformes) ; ce projet ne
declare aujourd'hui que Windows et Linux (Xlib), les deux chemins eprouves du
depot. Le reste suit le modele de PV3DE.jenga le jour ou il faut.
"""

from Jenga import *
from jengaconfig import *

with project("NogeDemo"):
    windowedapp()
    language("C++")
    cppdialect("C++17")
    location(".")

    files(["src/**.cpp"])

    # Meme fermeture transitive que PV3DE.jenga (Noge tire NKECS, NKRenderer,
    # NKSerialization, NKFileSystem, NKAudio/NKMedia/NKNetwork, NKRL/NKAgent),
    # SANS l'interface (ni NKGui ni NKEditorKit : un jeu, pas un editeur).
    nkentseudependson(
        ["Noge", "NKAgent", "NKRL", "NKTensor", "NKAudio", "NKMedia", "NKNetwork",
         "NKVFX", "NKRenderer", "NKAnima", "NKSL", "NKCollision", "NKPhysics", "NKNavigation",
         "NKSerialization", "NKFileSystem", "NKECS", "NKRHI", "NKReflection",
         "NKGLSlang", "NKSPIRVCross", "NKGlad", "NKCanvas", "NKFont", "NKImage",
         "NKEvent", "NKWindow", "NKLogger", "NKMath", "NKTime", "NKStream",
         "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading"],
        extra_includes=["src", "%{Noge.location}/src"]
                       + ([VULKAN_INCLUDE] if VULKAN_INCLUDE else []),
        extra_defines=[f"NKENTSEU_ENABLE_VULKAN_BACKEND={1 if WANT_VULKAN else 0}"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    # ===== Windows ================================================================
    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        windowedapp()
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        if VULKAN_LIB:
            libdirs([VULKAN_LIB])
        _WIN_LINKS = [
            "user32", "gdi32", "opengl32", "dwmapi", "shell32",
            "mf", "mfplat", "mfreadwrite", "mfuuid",
            "uuid", "ole32", "dinput8", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
            "winmm", "avrt", "ws2_32",  # NKRenderer (timeBeginPeriod), NKAudio, NKNetwork
        ]
        _IS_MINGW_R = "mingw" in TC_WINDOWS.lower()
        # ⚠️ vulkan-1 SEULEMENT si le SDK est la : NkDemoContact et
        #    NkDemoPiedsSurLaPente le lient en dur et ne se lient donc pas sur une
        #    machine sans SDK Vulkan (mesure du 2026-09-30, ETAT_2026-09-30.md).
        if WANT_VULKAN:
            _WIN_LINKS.append("vulkan-1")
            if not _IS_MINGW_R:
                _WIN_LINKS.extend(GLSLANG_LIBS_WINDOWS)
        links(_WIN_LINKS)

    # ===== Linux XLib =============================================================
    with filter("system:Linux && options:linux-backend=xlib || system:Linux && !options:linux-backend && !options:headless"):
        windowedapp()
        usetoolchain("clang-native")
        defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
        links(["pthread", "X11", "Xext", "GL"])

    with filter("config:Debug"):
        defines(["_DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

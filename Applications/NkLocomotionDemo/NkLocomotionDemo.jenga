"""NkLocomotionDemo — preuve d'exécution CPU-only pour le pont animation Noge
(Engine/Noge/ROADMAP.md, item G1.4 : Rigging/NkIKSolver.h + Anim/NkLocomotion.h).

Contexte : `jenga test` / `Noge_Tests` sont bloqués par une politique de
workspace ("Unit-test compilation/execution is disabled by workspace
policy") — indépendante de ce code. Cette petite application console
contourne le blocage (elle n'est PAS une TestSuite) pour prouver, par une
exécution réelle, qu'un personnage Noge (ECS) joue un blend Walk/Run
(délégué à renderer::NkBlendTree1D) avec IK des pieds actif (délégué à
renderer::NkIKSystem via NkIKSolver), zéro réimplémentation locale.
"""
from Jenga import *
from jengaconfig import *

with project("NkLocomotionDemo"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    # NOTE 2026-07-23 : NKSL (NkShaderConvert.cpp) reference des symboles
    # spirv_cross::*/glslang::* qui vivent dans NKSPIRVCross/NKGLSlang (deps
    # transitives de NKSL cote .jenga) -- mais le linker de l'executable final
    # ne les tire pas automatiquement d'un simple dependson("NKSL") (fuite de
    # propagation transitive du systeme de build, pas du code Noge/Anim).
    # Ajout explicite de NKGLSlang/NKSPIRVCross -- fix de configuration de
    # build, aucune ligne de logique IK/anim touchee.
    nkentseudependson(
        ["Noge", "NKRenderer", "NKRHI", "NKSL", "NKGLSlang", "NKSPIRVCross", "NKCollision", "NKPhysics",
         "NKSerialization", "NKFileSystem", "NKFont", "NKImage", "NKGlad",
         "NKECS", "NKEvent", "NKWindow", "NKMath", "NKTime", "NKLogger",
         "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading"],
        extra_includes=["src", "%{Noge.location}/src"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        links(["user32", "gdi32", "opengl32", "dwmapi", "shell32",
               "d3d11", "d3d12", "dxgi", "dxguid", "d3dcompiler", "uuid", "ole32"])

#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""NKCode — IDE cross-plateforme type VSCode, bati sur Jenga.

v1 : coquille NKEditorKit (sur NKGui) + explorateur de fichiers reel +
editeur multi-onglets + integration Jenga (build/run) + panneau sortie.
Le visuel (Blocks/Blueprint), UIBuilder, extensions, agents = phases suivantes.
"""

from Jenga import *
from jengaconfig import *
import os
import shutil
import subprocess


def _norm(p):
    return p.replace("\\", "/") if p else p


def _pkg_exists(pkg_name):
    if not shutil.which("pkg-config"):
        return False
    try:
        return subprocess.call(["pkg-config", "--exists", pkg_name],
                               stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL) == 0
    except Exception:
        return False


_VULKAN_SDK     = _norm(os.getenv("VULKAN_SDK", ""))
_VULKAN_INCLUDE = _norm(os.path.join(_VULKAN_SDK, "Include")) if _VULKAN_SDK else ""
_VULKAN_LIB     = _norm(os.path.join(_VULKAN_SDK, "Lib")) if _VULKAN_SDK else ""
_VULKAN_OPT     = os.getenv("NK_ENABLE_VULKAN", "auto").strip().lower()
if _VULKAN_OPT in ("0", "false", "off", "no"):
    _WANT_VULKAN = False
elif _VULKAN_OPT in ("1", "true", "on", "yes"):
    _WANT_VULKAN = True
else:
    _WANT_VULKAN = bool(_VULKAN_INCLUDE) or _pkg_exists("vulkan")


with project("NKCode"):
    windowedapp()
    language("C++")
    cppdialect("C++17")
    location(".")

    files(["src/**.cpp"])

    nkentseudependson(
        ["NKEditorKit", "NKCanvas", "NKGui", "NKWindow", "NKEvent", "NKGlad",
         "NKFont", "NKImage", "NKFileSystem", "NKThreading", "NKLogger", "NKMath", "NKTime",
         "NKStream", "NKContainers", "NKMemory", "NKCore", "NKPlatform"],
        extra_includes=["src", "src/NKCode", "%{NKGlad.location}/include"]
                       + ([_VULKAN_INCLUDE] if _VULKAN_INCLUDE else []),
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    apppublisher("Rihen Universe")
    appversion("0.1.0")
    licensefile("../../LICENSE")

    # ===== Windows ================================================================
    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        windowedapp()
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        if _VULKAN_LIB:
            libdirs([_VULKAN_LIB])
        _WIN_LINKS = [
            "user32", "gdi32", "opengl32", "dwmapi", "shell32", "comdlg32",
            "mf", "mfplat", "mfreadwrite", "mfuuid",
            "uuid", "ole32", "dinput8", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
        ]
        if _WANT_VULKAN:
            _WIN_LINKS.append("vulkan-1")
        links(_WIN_LINKS)

    # ===== Linux XLib (defaut) ===================================================
    with filter("system:Linux && options:linux-backend=xlib || system:Linux && !options:linux-backend && !options:headless"):
        windowedapp()
        usetoolchain("clang-native")
        defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
        links(["pthread", "X11", "Xext", "GL"])

    # ===== macOS ==================================================================
    with filter("system:macOS"):
        windowedapp()
        usetoolchain("clang-native")
        frameworks(["Cocoa", "QuartzCore", "OpenGL"])

    # ===== iOS ====================================================================
    # Rendu via Metal (NkContextFactory sélectionne automatiquement le backend
    # Metal sur iOS ; le loader NKGlad ne compile qu'un stub GLES, inoffensif).
    # Saisie via clavier logiciel UIKit (NkWindow::ShowSoftKeyboard) -> NkTextInputEvent.
    with filter("system:iOS"):
        windowedapp()
        frameworks(["UIKit", "QuartzCore", "Metal", "Foundation"])
        iosbundleid("com.rihen.nkentseu.nkcode")
        iosversion("0.1.0")

    # ===== Android ================================================================
    # IME complet (composition CJK, suggestions, dictée) : Activity Java custom
    # (NkNativeActivity) + InputConnection -> NkTextInputEvent. Sans le bloc Java,
    # le clavier natif basique (KeyCharacterMap) fonctionne quand même.
    with filter("system:Android"):
        windowedapp()
        usetoolchain("android-ndk")
        _NKCODE_ANDROID_LINKS = ["android", "log", "EGL", "GLESv3", "dl"]
        if _WANT_VULKAN:
            _NKCODE_ANDROID_LINKS.append("vulkan")
        links(_NKCODE_ANDROID_LINKS)
        androidapplicationid("com.rihen.nkentseu.nkcode")
        androidminsdk(24)
        androidtargetsdk(34)
        androidcompilesdk(34)
        # x86_64 inclus pour les émulateurs (MEmu / Android Studio AVD Intel).
        androidabis(["armeabi-v7a", "arm64-v8a", "x86", "x86_64"])
        androidnativeactivity(True)
        androidstl("c++_shared")
        androidjavafiles(["%{NKWindow.location}/src/NKWindow/Platform/Android/java/**.java"])
        androidactivityclass("com.nkentseu.window.NkNativeActivity")

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""NKCode — IDE cross-plateforme type VSCode, bati sur Jenga.

v1 : coquille NKEditorKit (sur NKGui) + explorateur de fichiers reel +
editeur multi-onglets + integration Jenga (build/run) + panneau sortie.
Le visuel (Blocks/Blueprint), UIBuilder, extensions, agents = phases suivantes.
"""

from Jenga import *
from jengaconfig import *
import os
import shutil
import subprocess


def _norm(p):
    return p.replace("\\", "/") if p else p


def _pkg_exists(pkg_name):
    if not shutil.which("pkg-config"):
        return False
    try:
        return subprocess.call(["pkg-config", "--exists", pkg_name],
                               stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL) == 0
    except Exception:
        return False


# Embarquement Jenga in-process (Phase 12 ROADMAP.md) : CPython embeddable
# vendorise dans Externals/Libs/PythonEmbed (voir NOTICE_NKENTSEU.md la-bas).
# sdk/ = fichiers de DEV (Python.h, python312.lib), jamais distribues avec
# NKCode ; runtime/ = ce qui sera copie a cote de NKCode.exe (voir Phase 3,
# NkEmbeddedJenga, pour l'etape de copie postbuild une fois le code reel en
# place). Chemins calcules depuis __file__ (repertoire de ce .jenga), pas un
# env var : PythonEmbed est TOUJOURS vendorise au meme endroit relatif.
## __file__ est RELATIF et le loader Jenga a deja fait chdir() dans le
## dossier de ce fichier au moment de l'exec (verifie empiriquement) ->
## os.path.abspath(__file__) double le chemin. On part du cwd directement.
_HERE           = _norm(os.getcwd())
_REPO_ROOT      = _norm(os.path.abspath(os.path.join(_HERE, "..", "..")))
_PYEMBED_DIR    = _REPO_ROOT + "/Externals/Libs/PythonEmbed"
_PYEMBED_INCLUDE = _PYEMBED_DIR + "/sdk/include"
_PYEMBED_LIBDIR  = _PYEMBED_DIR + "/sdk/libs"
_PYEMBED_LIBNAME = "python312"

# Runtime Linux : distribution RELOGEABLE (python-build-standalone), dont la
# disposition suit celle d'une installation UNIX — d'ou des chemins differents
# du paquet embarquable Windows (qui est a plat, avec un ZIP de stdlib).
_ZIG_LINUX          = _REPO_ROOT + "/Externals/Libs/ZigToolchain/linux"
_HAS_ZIG_LINUX      = os.path.isfile(_ZIG_LINUX + "/zig")

_PYEMBED_LINUX      = _PYEMBED_DIR + "/linux"
_PYEMBED_LINUX_VER  = "3.12"
_PYEMBED_LINUX_INC  = _PYEMBED_LINUX + "/include/python" + _PYEMBED_LINUX_VER
_PYEMBED_LINUX_LIB  = _PYEMBED_LINUX + "/lib"
_PYEMBED_LINUX_NAME = "python" + _PYEMBED_LINUX_VER
_HAS_PYEMBED_LINUX  = os.path.isdir(_PYEMBED_LINUX_INC)

# Sources Jenga a embarquer (tools/jenga-src/Jenga) : depot Jenga voisin, ou
# NKCODE_JENGA_SRC. Sans elles, l'interpreteur embarque n'a rien a executer.
# ── Sources Jenga a embarquer : on part du WHEEL, pas de l'arbre du depot ──
#
# Jenga definit SES PROPRES regles d'empaquetage dans pyproject.toml : quels
# paquets, quel echantillon d'exemples, et surtout l'exclusion explicite de
# `Exemples/Nkentseu/**` — 1,7 Go de sous-module, et les sources du MOTEUR,
# dont la diffusion serait une fuite de code proprietaire.
#
# Repliquer ces regles ici les dupliquerait et les ferait diverger a la
# premiere evolution. On extrait donc le wheel officiel (~1 Mo), qui EST le
# contenu que Jenga distribue. Le produire : ./cri.sh dans le depot Jenga.
def _jenga_depuis_wheel():
    import glob, zipfile, shutil
    racines = [_norm(os.getenv("NKCODE_JENGA_SRC", ""))] + [
        _norm(os.path.abspath(os.path.join(_REPO_ROOT, *([".."] * n) + ["MacShared", "Projets", "Jenga"])))
        for n in (2, 3, 4)
    ] + [_norm(os.path.abspath(os.path.join(_REPO_ROOT, "..", "Jenga")))]
    for r in racines:
        if not r or not os.path.isdir(r):
            continue
        whls = sorted(glob.glob(os.path.join(r, "dist", "*.whl")), key=os.path.getmtime, reverse=True)
        if not whls:
            continue
        stage = _norm(os.path.join(_REPO_ROOT, "Build", "_jenga-embed"))
        cible = os.path.join(stage, "Jenga")
        # Re-extrait a chaque evaluation : un wheel plus recent doit gagner,
        # sinon on embarquerait silencieusement une version perimee.
        if os.path.isdir(stage):
            shutil.rmtree(stage, ignore_errors=True)
        os.makedirs(stage, exist_ok=True)
        with zipfile.ZipFile(whls[0]) as z:
            for n in z.namelist():
                if n.startswith("Jenga/") and not n.endswith("/"):
                    z.extract(n, stage)
        if os.path.isdir(os.path.join(cible, "Core")):
            return stage, os.path.basename(whls[0])
    return "", ""

_JENGA_STAGE, _JENGA_WHL = _jenga_depuis_wheel()
_HAS_JENGA_SRC = bool(_JENGA_STAGE)
if _HAS_JENGA_SRC:
    print("[NKCode] Jenga embarque depuis le wheel : " + _JENGA_WHL)
else:
    print("[NKCode] ATTENTION : aucun wheel Jenga trouve (dist/*.whl) -> le paquet "
          "n'aura PAS de Jenga embarque, et les boutons Construire/Executer seront "
          "inoperants. Produisez-le avec ./cri.sh dans le depot Jenga.")

_VULKAN_SDK     = _norm(os.getenv("VULKAN_SDK", ""))
_VULKAN_INCLUDE = _norm(os.path.join(_VULKAN_SDK, "Include")) if _VULKAN_SDK else ""
_VULKAN_LIB     = _norm(os.path.join(_VULKAN_SDK, "Lib")) if _VULKAN_SDK else ""
_VULKAN_OPT     = os.getenv("NK_ENABLE_VULKAN", "auto").strip().lower()
if _VULKAN_OPT in ("0", "false", "off", "no"):
    _WANT_VULKAN = False
elif _VULKAN_OPT in ("1", "true", "on", "yes"):
    _WANT_VULKAN = True
else:
    _WANT_VULKAN = bool(_VULKAN_INCLUDE) or _pkg_exists("vulkan")


with project("NKCode"):
    windowedapp()
    language("C++")
    cppdialect("C++17")
    location(".")

    files(["src/**.cpp"])

    # Ressources de l'IDE embarquees dans TOUT paquet (deb/rpm/AppImage/targz,
    # zip/msi cote Windows) : polices, textures, logos, traductions, icons.cfg.
    #
    # La forme « source => destination » est indispensable ici. Sans elle,
    # dependfiles() place les fichiers relativement au WORKSPACE, soit
    # « Applications/NKCode/data/... ». Or NkAppFonts et NkAppIcons cherchent
    # « data/... » A COTE DE L'EXECUTABLE : le paquet s'installait sans que
    # l'application retrouve la moindre police ni icone.
    #
    # Ce que MakeNkCodeDist.py fait deja pour Windows est ainsi declare dans le
    # .jenga, donc valable pour toutes les plateformes d'un seul geste.
    dependfiles(["data => data"])

    # ── Jenga EMBARQUE : le runtime Python ET les sources Jenga suivent le
    #    paquet, pour que Construire/Executer marchent SANS rien installer.
    #
    # Les deux destinations sont celles que NkEmbeddedJenga::Configure() cherche
    # A COTE DE L'EXECUTABLE : tools/python-embed et tools/jenga-src/Jenga.
    # C'est la forme « source => destination » qui le permet ; sans elle, les
    # fichiers atterriraient sous Applications/NKCode/... et ne seraient jamais
    # retrouves.
    with filter("system:Linux"):
        if _HAS_PYEMBED_LINUX:
            dependfiles([_PYEMBED_LINUX + " => tools/python-embed"])
        # Compilateur PAR DEFAUT des cibles Linux : Zig, qui EST un clang
        # complet (`zig cc` / `zig c++`). llvm-mingw, embarque cote Windows,
        # produit des binaires Windows et n'a rien a faire ici.
        #
        # 216 Mo apres reduction aux cibles Linux, contre 996 Mo pour une
        # distribution LLVM officielle. NkEmbeddedJenga prefixe le PATH avec
        # tools/compilers/zig au demarrage, pour que Jenga le trouve.
        if _HAS_ZIG_LINUX:
            dependfiles([_ZIG_LINUX + " => tools/compilers/zig"])
        if _HAS_JENGA_SRC:
            # Le wheel porte DEJA les exclusions de Jenga (dont Nkentseu) :
            # rien a filtrer ici, et aucune regle dupliquee.
            dependfiles([_JENGA_STAGE + "/Jenga => tools/jenga-src/Jenga"])

    nkentseudependson(
        # NKNetwork : serveur WebSocket du pont IDE (NkIdeBridge) — NKCode se
        # declare aupres du CLI Claude Code et lui pousse son etat en temps reel.
        ["NKEditorKit", "NKCanvas", "NKGui", "NKWindow", "NKEvent", "NKGlad",
         "NKFont", "NKImage", "NKAudio", "NKMedia", "NKNetwork", "NKFileSystem", "NKThreading", "NKLogger",
         "NKMath", "NKTime", "NKStream", "NKContainers", "NKMemory", "NKCore", "NKPlatform"],
        # pybind11 est header-only (files([]), rien a compiler/lier) : simple
        # includedirs, pas un dependson NK-prefixe (evite un edge dependson/
        # link superflu, cf. NOTICE Externals/Libs/pybind11).
        # _PYEMBED_INCLUDE n'est PAS ajoute ici : le SDK CPython vendorise est
        # celui de Windows (pyconfig.h reclame <io.h>), et l'ajouter partout
        # cassait toute compilation Linux. Il est pose dans le filtre
        # « platforms:windows » plus bas, avec le define NKCODE_EMBED_PYTHON.
        extra_includes=["src", "src/NKCode", "%{NKGlad.location}/include", "%{pybind11.location}/include"]
                       + ([_VULKAN_INCLUDE] if _VULKAN_INCLUDE else []),
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    apppublisher("Rihen Universe")
    appversion("0.1.0")
    licensefile("../../LICENSE")

    # ===== Windows ================================================================
    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        windowedapp()
        usetoolchain(TC_WINDOWS)
        # NKCODE_EMBED_PYTHON : n'active le vrai NkEmbeddedJenga QUE sur Windows.
        # Le CPython vendorise est celui de Windows (son pyconfig.h reclame
        # <io.h>) ; ailleurs, NkEmbeddedJengaStub.cpp fournit la meme surface en
        # repondant « indisponible », et l'appelant retombe sur le `jenga` du
        # PATH — hypothese raisonnable sous Linux, ou Python est presque
        # toujours present.
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE", "NKCODE_EMBED_PYTHON=1"])
        includedirs([_PYEMBED_INCLUDE])
        if _VULKAN_LIB:
            libdirs([_VULKAN_LIB])
        libdirs([_PYEMBED_LIBDIR])
        _WIN_LINKS = [
            "user32", "gdi32", "opengl32", "dwmapi", "shell32", "comdlg32",
            "mf", "mfplat", "mfreadwrite", "mfuuid",
            "uuid", "ole32", "dinput8", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
            "winmm", "avrt",  # NKAudio : backend WASAPI (lecteur audio)
            _PYEMBED_LIBNAME,  # Jenga in-process (Phase 12) : voir NkEmbeddedJenga.h
        ]
        if _WANT_VULKAN:
            _WIN_LINKS.append("vulkan-1")
        links(_WIN_LINKS)

    # ===== Linux XLib (defaut) ===================================================
    with filter("system:Linux && options:linux-backend=xlib || system:Linux && !options:linux-backend && !options:headless"):
        windowedapp()
        usetoolchain("clang-native")
        defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
        # Xrandr : NkXLibWindow interroge les ecrans (XRRGetScreenResources,
        # XRRGetOutputPrimary...). La bibliotheque manquait dans cette liste, ce
        # qui ne se voyait pas tant que rien n'etait lie sous Linux.
        _LINUX_LINKS = ["pthread", "X11", "Xext", "Xrandr", "GL", "asound", "m", "util"]  # asound/m : NKAudio (ALSA)
        if _HAS_PYEMBED_LINUX:
            _LINUX_LINKS.append(_PYEMBED_LINUX_NAME)
        if _WANT_VULKAN:
            _LINUX_LINKS.append("vulkan")
        links(_LINUX_LINKS)

        # ── Jenga EMBARQUE (Phase 12) sous Linux ─────────────────────────────
        # Sans lui, les boutons Construire/Executer retombent sur un `jenga` du
        # PATH, absent chez un testeur — c'est exactement le retour beta #9/#10
        # deja encaisse sur Windows.
        #
        # rpath $ORIGIN : le binaire doit trouver libpython3.12.so A COTE DE LUI
        # une fois installe, sans LD_LIBRARY_PATH ni installation systeme. Sans
        # cela le paquet se lance chez nous (ou la lib est dans l'arbre du repo)
        # et pas chez le testeur.
        if _HAS_PYEMBED_LINUX:
            defines(["NKCODE_EMBED_PYTHON=1", 'NKCODE_PYEMBED_VER="' + _PYEMBED_LINUX_VER + '"'])
            includedirs([_PYEMBED_LINUX_INC])
            libdirs([_PYEMBED_LINUX_LIB])
            ldflags(["-Wl,-rpath,$ORIGIN/tools/python-embed/lib",
                     "-Wl,-rpath," + _PYEMBED_LINUX_LIB])


    # ===== Linux XCB ==============================================================
    # Les listes de liens viennent de Applications/DemoRW/demorw.jenga, ou les
    # trois backends Linux sont cables et eprouves ; on n'en reinvente pas.
    # Ajouts propres a NKCode : asound/m pour NKAudio (ALSA), absents de DemoRW.
    with filter("system:Linux && options:linux-backend=xcb"):
        windowedapp()
        usetoolchain("clang-native")
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-xcb/%{prj.name}")
        targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-xcb/%{prj.name}")
        defines(["NKENTSEU_FORCE_WINDOWING_XCB_ONLY"])
        _LINUX_XCB_LINKS = ["pthread", "xcb", "xcb-image", "xcb-icccm", "xcb-randr", "xcb-xfixes",
                            "X11", "X11-xcb", "Xext", "xkbcommon", "xkbcommon-x11", "GL",
                            "asound", "m", "util"]
        if _HAS_PYEMBED_LINUX:
            _LINUX_XCB_LINKS.append(_PYEMBED_LINUX_NAME)
        if _WANT_VULKAN:
            _LINUX_XCB_LINKS.append("vulkan")
        links(_LINUX_XCB_LINKS)
        ldflags(["-fuse-ld=lld"])

        # ── Jenga EMBARQUE (Phase 12) sous Linux ─────────────────────────────
        # Sans lui, les boutons Construire/Executer retombent sur un `jenga` du
        # PATH, absent chez un testeur — c'est exactement le retour beta #9/#10
        # deja encaisse sur Windows.
        #
        # rpath $ORIGIN : le binaire doit trouver libpython3.12.so A COTE DE LUI
        # une fois installe, sans LD_LIBRARY_PATH ni installation systeme. Sans
        # cela le paquet se lance chez nous (ou la lib est dans l'arbre du repo)
        # et pas chez le testeur.
        if _HAS_PYEMBED_LINUX:
            defines(["NKCODE_EMBED_PYTHON=1", 'NKCODE_PYEMBED_VER="' + _PYEMBED_LINUX_VER + '"'])
            includedirs([_PYEMBED_LINUX_INC])
            libdirs([_PYEMBED_LINUX_LIB])
            ldflags(["-Wl,-rpath,$ORIGIN/tools/python-embed/lib",
                     "-Wl,-rpath," + _PYEMBED_LINUX_LIB])


    # ===== Linux Wayland ==========================================================
    with filter("system:Linux && options:linux-backend=wayland"):
        windowedapp()
        usetoolchain("clang-native")
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-wayland/%{prj.name}")
        targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-wayland/%{prj.name}")
        # WAYLAND_DEFINES / WAYLAND_LINKS viennent de config/wayland.jenga, charge
        # une fois par Nkentseu.jenga et propage a tous les .jenga inclus.
        #
        # NE PAS recopier cette liste en dur. Elle est CONDITIONNELLE : si
        # pkg-config trouve libdecor-0, config/wayland.jenga ajoute A LA FOIS le
        # define NKENTSEU_WAYLAND_LIBDECOR et le lien `decor-0`. Une liste figee
        # ici donnait des modules moteur compiles AVEC libdecor (ils lisent la
        # config partagee) et une ligne de link SANS -ldecor-0 : une vingtaine de
        # `undefined reference to libdecor_*` a l'edition de liens.
        defines(WAYLAND_DEFINES)
        _LINUX_WL_LINKS = list(WAYLAND_LINKS) + ["asound", "m", "util"]  # asound/m : NKAudio (ALSA)
        if _HAS_PYEMBED_LINUX:
            _LINUX_WL_LINKS.append(_PYEMBED_LINUX_NAME)
        if _WANT_VULKAN:
            _LINUX_WL_LINKS.append("vulkan")
        links(_LINUX_WL_LINKS)

        # ── Jenga EMBARQUE (Phase 12) sous Linux ─────────────────────────────
        # Sans lui, les boutons Construire/Executer retombent sur un `jenga` du
        # PATH, absent chez un testeur — c'est exactement le retour beta #9/#10
        # deja encaisse sur Windows.
        #
        # rpath $ORIGIN : le binaire doit trouver libpython3.12.so A COTE DE LUI
        # une fois installe, sans LD_LIBRARY_PATH ni installation systeme. Sans
        # cela le paquet se lance chez nous (ou la lib est dans l'arbre du repo)
        # et pas chez le testeur.
        if _HAS_PYEMBED_LINUX:
            defines(["NKCODE_EMBED_PYTHON=1", 'NKCODE_PYEMBED_VER="' + _PYEMBED_LINUX_VER + '"'])
            includedirs([_PYEMBED_LINUX_INC])
            libdirs([_PYEMBED_LINUX_LIB])
            ldflags(["-Wl,-rpath,$ORIGIN/tools/python-embed/lib",
                     "-Wl,-rpath," + _PYEMBED_LINUX_LIB])


    # ===== macOS ==================================================================
    with filter("system:macOS"):
        windowedapp()
        usetoolchain("clang-native")
        # + Metal : les .mm Metal de NKCanvas compilent desormais sur macOS
        # (probe CI : _MTLCreateSystemDefaultDevice non resolu sans lui).
        frameworks(["Cocoa", "QuartzCore", "OpenGL", "Metal", "AudioToolbox", "CoreAudio", "AudioUnit"]) # NKAudio (CoreAudio)

    # ===== iOS ====================================================================
    # Rendu via Metal (NkContextFactory sélectionne automatiquement le backend
    # Metal sur iOS ; le loader NKGlad ne compile qu'un stub GLES, inoffensif).
    # Saisie via clavier logiciel UIKit (NkWindow::ShowSoftKeyboard) -> NkTextInputEvent.
    with filter("system:iOS"):
        windowedapp()
        frameworks(["UIKit", "QuartzCore", "Metal", "Foundation"])
        iosbundleid("com.rihen.nkentseu.nkcode")
        iosversion("0.1.0")

    # ===== Android ================================================================
    # IME complet (composition CJK, suggestions, dictée) : Activity Java custom
    # (NkNativeActivity) + InputConnection -> NkTextInputEvent. Sans le bloc Java,
    # le clavier natif basique (KeyCharacterMap) fonctionne quand même.
    with filter("system:Android"):
        windowedapp()
        usetoolchain("android-ndk")
        _NKCODE_ANDROID_LINKS = ["android", "log", "EGL", "GLESv3", "dl"]
        if _WANT_VULKAN:
            _NKCODE_ANDROID_LINKS.append("vulkan")
        links(_NKCODE_ANDROID_LINKS)
        androidapplicationid("com.rihen.nkentseu.nkcode")
        androidminsdk(24)
        androidtargetsdk(34)
        androidcompilesdk(34)
        # x86_64 inclus pour les émulateurs (MEmu / Android Studio AVD Intel).
        androidabis(["armeabi-v7a", "arm64-v8a", "x86", "x86_64"])
        androidnativeactivity(True)
        androidstl("c++_shared")
        androidjavafiles(["%{NKWindow.location}/src/NKWindow/Platform/Android/java/**.java"])
        androidactivityclass("com.nkentseu.window.NkNativeActivity")

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)


# ─────────────────────────────────────────────────────────────────────────────
# Banc de test du lecteur PDF (cible CONSOLE, hors application).
#
# Confronte l'analyseur a un corpus de PDF reels et n'affiche que des donnees
# STRUCTURELLES (nombre de pages, dimensions, etat). Volontairement separe de
# NKCode : un banc doit pouvoir tourner sans fenetre ni contexte graphique, et
# etre enchaine dans un script (son code de retour = le nombre d'echecs).
#
#   jenga build --target NkPdfProbe --config Debug
#   ./NkPdfProbe <dossier de PDF>
# ─────────────────────────────────────────────────────────────────────────────
with project("NkPdfProbe"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")

    files(["src/NKMedia/Pdf/**.cpp", "tools/PdfProbe.cpp"])
    includedirs(["src"])

    # L'analyseur PDF ne touche ni au rendu, ni a la fenetre, ni au son : on
    # reprend la liste de NKCode SANS la pile graphique/audio. NKImage n'est la
    # que pour NkDeflate (FlateDecode) ; NKStream et consorts sont ses
    # dependances TRANSITIVES, qu'il faut nommer EXPLICITEMENT — le premier
    # essai echouait sur « NKStream/NKIResource.h file not found ».
    nkentseudependson(
        ["NKFont", "NKImage", "NKFileSystem", "NKStream", "NKThreading", "NKLogger",
         "NKMath", "NKTime", "NKContainers", "NKMemory", "NKCore", "NKPlatform"],
    )

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)


# Verification NUMERIQUE du rastériseur de traces : chaque forme a une aire
# CONNUE, et la somme des couvertures doit la retrouver. Un rastériseur
# anti-aliase correct conserve l'aire — propriete facile a violer sans que ca
# se voie, et facile a mesurer.
#
#   jenga build --target NkPdfRasterTest --config Debug
with project("NkPdfRasterTest"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")

    files(["src/NKMedia/Pdf/NkPdfRaster.cpp", "tools/PdfRasterTest.cpp"])
    includedirs(["src"])

    # Le rastériseur ne depend QUE des conteneurs : aucun fichier, aucune image.
    nkentseudependson(["NKContainers", "NKMemory", "NKCore", "NKPlatform"])

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)


# Banc de RENDU : rend la 1re page de chaque PDF et MESURE le resultat
# (proportion de pixels peints, teintes distinctes). Une page blanche est le
# mode d'echec le plus vicieux d'un lecteur PDF — aucune erreur, rien a
# l'ecran — et c'est precisement ce que ce banc detecte.
with project("NkPdfRenderProbe"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")

    files(["src/NKMedia/Pdf/**.cpp", "tools/PdfRenderProbe.cpp"])
    includedirs(["src"])

    nkentseudependson(
        ["NKFont", "NKImage", "NKFileSystem", "NKStream", "NKThreading", "NKLogger",
         "NKMath", "NKTime", "NKContainers", "NKMemory", "NKCore", "NKPlatform"],
    )

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)


# Banc de diagnostic : lecture de fichiers (NkFile, apres le passage aux API
# larges de Windows) et fil de rendu PDF. Un « ca ne marche plus » ne se
# diagnostique pas en relisant le code : on exerce le chemin exact.
with project("NkFileWorkerTest"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")

    files(["src/NKMedia/Pdf/**.cpp", "src/NKCode/Shell/NkPdfWorker.cpp",
           "tools/FileWorkerTest.cpp"])
    includedirs(["src"])

    nkentseudependson(
        ["NKFont", "NKImage", "NKFileSystem", "NKStream", "NKThreading", "NKLogger",
         "NKMath", "NKTime", "NKContainers", "NKMemory", "NKCore", "NKPlatform"],
    )

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)

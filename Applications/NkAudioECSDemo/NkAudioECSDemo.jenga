"""NkAudioECSDemo — preuve d'exécution CPU-only pour Noge/ECS/Systems/NkAudioSystem.

Contexte : `jenga test` / `Noge_Tests` sont bloqués par une politique de
workspace ("Unit-test compilation/execution is disabled by workspace
policy") — indépendante de ce code. Cette petite application console
contourne le blocage (elle n'est PAS une TestSuite), même schéma que
Applications/NkEditableMeshDemo : elle prouve, par une exécution réelle,
que Engine/Noge/src/Noge/ECS/Systems/NkAudioSystem.cpp (pont ECS -> NKAudio,
ROADMAP.md Phase G1 item G1.1) fonctionne — une entité ECS avec
NkAudioSourceComponent joue réellement un WAV via audio::AudioEngine, vérifié
par assertions (audio::AudioEngine::IsPlaying/GetActiveVoices).
"""
from Jenga import *
from jengaconfig import *

with project("NkAudioECSDemo"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    nkentseudependson(
        ["Noge", "NKAudio", "NKMedia", "NKRenderer", "NKRHI", "NKSL", "NKCollision", "NKPhysics",
         "NKRL", "NKAgent", "NKSerialization", "NKFileSystem", "NKFont", "NKImage", "NKGlad",
         "NKECS", "NKEvent", "NKWindow", "NKMath", "NKTime", "NKLogger",
         "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading"],
        extra_includes=["src", "%{Noge.location}/src"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    # Embarque le dossier audio test (cf src/main.cpp : powerup.wav, bleep.wav).
    dependfiles(["../../Resources/Audio"])

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        links(["user32", "gdi32", "opengl32", "dwmapi", "shell32",
               "d3d11", "d3d12", "dxgi", "dxguid", "d3dcompiler", "uuid", "ole32",
               "winmm", "avrt"])

    with filter("system:Linux"):
        usetoolchain("clang-native")
        links(["pthread", "asound", "m"])

    with filter("system:macOS"):
        usetoolchain("clang-native")
        frameworks(["AudioToolbox", "CoreAudio", "CoreFoundation"])

    with filter("config:Debug"):
        defines(["_DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

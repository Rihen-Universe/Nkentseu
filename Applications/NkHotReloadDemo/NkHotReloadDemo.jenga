"""NkHotReloadDemo — jalon G2.3 : scripting C++ natif hot-reload (DLL).

Démo console CPU-only prouvant le cycle complet de Noge/ECS/Scripting/
NkScriptBridge (.h/.cpp) :

  1. compile un script utilisateur (scripts/HotCounterScript_v1.cpp, compteur
     +1 par tick, état sérialisé en JSON) en HotCounterScript.dll via un appel
     compilateur direct (clang++ msys64/ucrt64, celui du toolchain jenga —
     la compilation se fait à RUNTIME par la démo, aucun pré-build à gérer) ;
  2. la charge via NkScriptLoader::LoadDLL (shadow copy Windows + hooks
     mémoire NKMemory injectés), l'attache à une entité ECS (NkScriptHost)
     et la tick via NkScriptSystem ;
  3. recompile la V2 du script (scripts/HotCounterScript_v2.cpp, +2 par tick)
     par-dessus la même .dll, appelle NkScriptLoader::HotReload(world) ;
  4. vérifie par assertions que le compteur a CONTINUÉ depuis sa valeur
     (état capturé/restauré via Serialize/Deserialize) ET que le nouveau
     comportement (+2) est actif.

Exécution (depuis la racine du workspace, ou n'importe où avec
NKENTSEU_ROOT posé) : .\\Build\\Bin\\Release-Windows\\NkHotReloadDemo\\NkHotReloadDemo.exe
"""
from Jenga import *
from jengaconfig import *
import os


def _norm(p):
    return p.replace("\\", "/") if p else p


_VULKAN_SDK = _norm(os.getenv("VULKAN_SDK", ""))
_VULKAN_INCLUDE = _norm(os.path.join(_VULKAN_SDK, "Include")) if _VULKAN_SDK else ""
_VULKAN_LIB = _norm(os.path.join(_VULKAN_SDK, "Lib")) if _VULKAN_SDK else ""

with project("NkHotReloadDemo"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    nkentseudependson(
        ["Noge", "NKECS", "NKSerialization", "NKFileSystem", "NKStream",
         "NKLogger", "NKContainers", "NKMemory", "NKCore", "NKPlatform",
         "NKThreading", "NKTime", "NKMath"],
        extra_includes=["src", "%{Noge.location}/src"]
                       + ([_VULKAN_INCLUDE] if _VULKAN_INCLUDE else []),
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        if _VULKAN_LIB:
            libdirs([_VULKAN_LIB])
        links(["user32", "gdi32", "shell32", "uuid", "ole32"])

    with filter("system:Linux"):
        links(["pthread", "dl"])

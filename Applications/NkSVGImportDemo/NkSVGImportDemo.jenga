"""NkSVGImportDemo — preuve d'exécution CPU-only pour l'import SVG minimal
NkSVGIO::Import (ROADMAP Phase G1 item 3, incrément 2026-07-24).

Contexte : `jenga test` / les projets `*_Tests` sont bloqués par une
politique de workspace ("Unit-test compilation/execution is disabled by
workspace policy") -- indépendante de ce code (déjà rencontré et contourné
pour NkEditableMeshDemo/NkAssetIODemo le 2026-07-23). Cette application
console contourne le blocage (elle n'est PAS une TestSuite) pour prouver, par
une exécution réelle sur un SVG synthétique (formes/couleurs connues) et sur
un vrai fichier .svg du repo, que NkSVGIO::Import fonctionne : parsing via le
codec réel NkSVGCodec, construction de la hiérarchie minimale
NkVectorDocument -> NkArtboard -> NkVectorLayer -> NkVectorObject (voir
Engine/Noge/src/Noge/IO/NkSVGIO.cpp pour le détail des limites honnêtes).
"""
from Jenga import *
from jengaconfig import *

with project("NkSVGImportDemo"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    nkentseudependson(
        ["Noge", "NKRenderer", "NKRHI", "NKSL", "NKCollision", "NKPhysics",
         "NKSerialization", "NKFileSystem", "NKFont", "NKImage", "NKStream", "NKGlad",
         "NKECS", "NKEvent", "NKWindow", "NKMath", "NKTime", "NKLogger",
         "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading"],
        extra_includes=["src", "%{Noge.location}/src"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        links(["user32", "gdi32", "opengl32", "dwmapi", "shell32",
               "d3d11", "d3d12", "dxgi", "dxguid", "d3dcompiler", "uuid", "ole32"])

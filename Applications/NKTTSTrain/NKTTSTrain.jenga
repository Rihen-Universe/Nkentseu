"""NKTTSTrain — chargeur LJSpeech + entraînement TTS acoustique (NKSpeech + NKNN).

Étape 1 (actuelle) : prouver le pipeline de données (metadata.csv + WAV -> mel).
Console pure, CPU seul (le mel-spectrogramme = FFT radix-2 maison de NKSpeech).
La pile NN (NKNN/NKTrain/NKTensor) sera ajoutée à l'étape modèle."""
from Jenga import *
from jengaconfig import *

with project("NKTTSTrain"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    nkentseudependson(
        ["NKSpeech", "NKMath", "NKLogger", "NKContainers", "NKMemory", "NKCore", "NKPlatform"],
        extra_includes=["src"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        links(["user32"])

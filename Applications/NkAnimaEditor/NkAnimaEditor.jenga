#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""NkAnimaEditor — éditeur d'animation NkAnima (timeline) sur NKEditorKit.

App desktop : coquille d'éditeur dockable (NKEditorKit/NKGui) + panneau Timeline
branché sur NkAnimationEditor (logique d'édition de poses-clés, dans NKRenderer).
Charge un clip .nkanim, le rejoue (NkAnimationPlayer) et permet de scrubber /
insérer / supprimer / déplacer des poses-clés + undo/redo.
"""

from Jenga import *
from jengaconfig import *
import os
import shutil
import subprocess


with project("NkAnimaEditor"):
    windowedapp()
    language("C++")
    cppdialect("C++17")
    location(".")

    files(["src/**.cpp"])

    nkentseudependson(
        # NKCanvas RETIRE le 2026-09-01 : cette application injecte un renderer
        # NKRHI (NkEditorRHIRenderer) et n'inclut AUCUN en-tete NKCanvas. Elle le
        # liait uniquement parce que NKEditorKit l'imposait -- ce qui n'est plus
        # le cas. Contre-epreuve : le lien ci-dessous.
        ["NKEditorKit", "NKGui", "NKReflection", "NKWindow", "NKEvent", "NKGlad",
         "NKFont", "NKImage", "NKLogger", "NKMath", "NKTime", "NKStream", "NKFileSystem",
         "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading",
         "NKRHI", "NKRenderer", "NKSL", "NKSerialization", "NKCollision", "NKPhysics"],
        extra_includes=["src", "src/NkAnimaEditor", "%{wks.location}/Integrations",
                        "%{NKGlad.location}/include"]
                       + ([VULKAN_INCLUDE] if VULKAN_INCLUDE else []),
        extra_defines=[f"NKENTSEU_ENABLE_VULKAN_BACKEND={1 if WANT_VULKAN else 0}"],
    )

    # Backend UI NKGui->NKRHI (static lib d'integration, hors registre des modules
    # coeur) : lie par dependance projet brute.
    dependson(["NKGuiIntegration"])

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    apppublisher("Rihen Universe")
    appversion("0.1.0")
    licensefile("../../LICENSE")

    # ===== Windows ================================================================
    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        windowedapp()
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        if VULKAN_LIB:
            libdirs([VULKAN_LIB])
        _WIN_LINKS = [
            "user32", "gdi32", "opengl32", "dwmapi", "shell32",
            "mf", "mfplat", "mfreadwrite", "mfuuid",
            "uuid", "ole32", "dinput8", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
            "winmm",  # timeBeginPeriod/timeEndPeriod (NKRenderer NkRendererImpl)
        ]
        if USE_NKGLSLANG:    _WIN_LINKS.append("NKGLSlang")
        if USE_NKSPIRVCROSS: _WIN_LINKS.append("NKSPIRVCross")
        if WANT_VULKAN:
            _WIN_LINKS.append("vulkan-1")
        links(_WIN_LINKS)

    # ===== Linux XLib (defaut) ===================================================
    with filter("system:Linux && options:linux-backend=xlib || system:Linux && !options:linux-backend && !options:headless"):
        windowedapp()
        usetoolchain("clang-native")
        defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
        links(["pthread", "X11", "Xext", "GL"])

    # ===== macOS ==================================================================
    with filter("system:macOS"):
        windowedapp()
        usetoolchain("clang-native")
        frameworks(["Cocoa", "QuartzCore", "OpenGL"])

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

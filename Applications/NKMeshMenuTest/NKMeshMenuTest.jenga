#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""NKMeshMenuTest -- COMBIEN d'entrees le menu de maillage montre-t-il, EN CONSOLE.

AUTEUR : TEUGUIA TADJUIDJE Rodolf Séderis — Rihen

Rodolf dit voir « un menu Extruder » SEUL en mode edition. La table du menu
contextuel (NkModelerMeshMenu.h) declare QUATORZE commandes et filtre par
sous-mode. Les deux ne peuvent pas etre vrais ensemble : ce banc compte.

Sans fenetre et sans device, comme NKEditTargetTest -- meme moule, meme raison.
La construction de la liste est du CALCUL PUR ; seule `NkMeshMenuRun` appelle la
facade demo:: (NkDemo3D.cpp, device requis), et le banc ne l'appelle JAMAIS.

Il a fallu retirer de NkModelerMeshMenu.h un include de NkEditorContextMenu.h
dont ce fichier n'utilisait rien : il tirait NKGui tout entier et rendait le
calcul pur inatteignable hors fenetre. Le seul consommateur, NkModelerViewport.h,
prend deja le kit par NkModelerInput.h.

NE MESURE PAS : la peinture (NkCtxMenuDraw), le clic, le survol, ni l'etat du
viseur. Le dire ici plutot que de laisser croire que « le menu est teste ».
"""
from Jenga import *
from jengaconfig import *
import os


with project("NKMeshMenuTest"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    # NKEditorKit pour NkShortcutTable (et NKEvent, dont il tire NkKeyboardEvent).
    # NKGui figure dans la liste parce que NKEditorKit l'exporte : le retirer ici
    # ne le retirerait pas du graphe, cela masquerait seulement d'ou il vient.
    nkentseudependson(
        ["NKEditorKit", "NKGui", "NKWindow", "NKFont", "NKImage", "NKFileSystem",
         "NKEvent", "NKMath", "NKTime", "NKStream", "NKLogger",
         "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading"],
        extra_includes=["src", "%{wks.location}/Applications/NK3DModeler/src"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        links(["user32", "gdi32", "opengl32", "dwmapi", "shell32", "uuid", "ole32"])

    with filter("system:Linux"):
        usetoolchain("clang-native")
        links(["pthread", "m"])

    with filter("system:macOS"):
        usetoolchain("clang-native")

"""NkNetWorldDemo — preuve d'exécution CPU-only pour Noge/ECS/Replication/NkNetWorld.

Contexte : `jenga test` / `Noge_Tests` sont bloqués par une politique de
workspace ("Unit-test compilation/execution is disabled by workspace
policy") — indépendante de ce code. Cette petite application console
contourne le blocage (elle n'est PAS une TestSuite), même schéma que
Applications/NkEditableMeshDemo et Applications/NkAudioECSDemo : elle prouve,
par une exécution réelle, que Engine/Noge/src/Noge/ECS/Replication/NkNetWorld
(pont ECS -> net::NkNetWorld réel de NKNetwork, ROADMAP.md Phase I1, item 1)
fonctionne -- deux entités ECS enregistrées via NkNetSystem convergent d'un
"serveur" vers un "client" en loopback 127.0.0.1, vérifié par assertions.
Zéro contexte GPU requis (sockets + CPU uniquement).
"""
from Jenga import *
from jengaconfig import *

with project("NkNetWorldDemo"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    nkentseudependson(
        ["Noge", "NKNetwork", "NKRenderer", "NKRHI", "NKSL", "NKCollision", "NKPhysics",
         "NKRL", "NKAgent", "NKAudio", "NKMedia", "NKSerialization", "NKFileSystem", "NKFont",
         "NKImage", "NKGlad", "NKECS", "NKEvent", "NKWindow", "NKMath", "NKTime",
         "NKLogger", "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading"],
        extra_includes=["src", "%{Noge.location}/src"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        links(["user32", "gdi32", "opengl32", "dwmapi", "shell32",
               "d3d11", "d3d12", "dxgi", "dxguid", "d3dcompiler", "uuid", "ole32",
               "ws2_32"])

    with filter("system:Linux"):
        usetoolchain("clang-native")
        links(["pthread"])

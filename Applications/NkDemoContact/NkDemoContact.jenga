#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# =============================================================================
# NkDemoContact — LA DEMO DU CONTACT (26/09/2026)
# =============================================================================
# Une bille tombe sur un plan et s'arrete. Une case coupe la collision : elle
# traverse. Le negatif se voit A L'OEIL, pas dans un journal.
#
# POURQUOI ELLE EXISTE : NKCollision et NKPhysics sont ecrits et mesures, mais
# AUCUNE application produit ne montrait deux corps se rencontrer — les
# « demos » de Noge sont toutes des applications CONSOLE. Un jeu ne se prouve
# pas dans une console.
#
# ⚠️ ELLE PASSE PAR LE VRAI PONT : `Noge/ECS/Systems/NkPhysicsSystem`, celui que
#    `NkEngineLayer` enregistre. Ce qu'elle montre est le CABLAGE, pas le module.
#
# `--mesure` : le meme montage de scene, sans fenetre, avec un verdict chiffre
# et son negatif. Une seule fonction construit la scene dans les deux modes.
# =============================================================================

from Jenga import *
from jengaconfig import *

import os


with project("NkDemoContact"):
    windowedapp()
    language("C++")
    cppdialect("C++17")
    location(".")

    files(["src/**.cpp"])

    nkentseudependson(
        ["Noge", "NKCanvas", "NKPhysics", "NKCollision", "NKECS",
         "NKFont", "NKImage", "NKStream", "NKTime", "NKGlad"],
        extra_includes=["src", "%{Noge.location}/src"],
        extra_defines=[
            # OpenGL seul : cette demo ne mesure pas le rendu, elle montre un contact.
            "NKENTSEU_ENABLE_VULKAN_BACKEND=0",
        ],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    # La police chargee au demarrage ("Resources/Fonts/Antonio-Bold.ttf").
    dependfiles(["../../Resources/Fonts"])

    # ===== Windows ===========================================================
    # ⚠️ NKCanvas COMPILE TOUS SES DORSAUX : le lien reclame DX11/DX12/Vulkan
    #    meme si la demo demande OpenGL. Meme liste que ConquerorProto, qui
    #    construit — reprise telle quelle plutot que devinee ligne a ligne.
    with filter("system:Windows"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        if VULKAN_LIB:
            libdirs([VULKAN_LIB])
        links([
            "user32", "gdi32", "opengl32", "dwmapi", "shell32", "ole32", "uuid",
            "dinput8", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
            "vulkan-1",
        ])

    # ===== Linux (XLib) ======================================================
    with filter("system:Linux && !options:linux-backend=wayland"):
        usetoolchain("clang-native")
        defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
        links(["pthread", "X11", "Xrandr", "Xext", "GL", "m"])

    with filter("config:Debug"):
        defines(["_DEBUG"]); optimize("Off"); symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"]); optimize("Speed"); symbols(False)

"""NkMsaaVulkanCheck -- ToVkSamples() exerce sur une VRAIE carte Vulkan.

CE QUI LE DISTINGUE DE NkMsaaDeviceCheck, ET C EST TOUT SON INTERET.
NkMsaaDeviceCheck essaie DX11, puis DX12, puis OpenGL, et S ARRETE AU PREMIER
QUI S OUVRE. Sur la machine de mesure DX11 s ouvre : le chemin Vulkan n a
JAMAIS ete parcouru, et NkVulkanDevice::ToVkSamples() -- l origine ecrite de
toute cette affaire -- restait une deduction par lecture.

Ce banc-ci n a PAS de chaine de repli. Il ouvre Vulkan ou il rend IGNORE. Un
repli vers un autre backend reproduirait exactement le defaut qui a empeche la
mesure : on croirait avoir mesure Vulkan alors qu on aurait mesure DX11.

IGNORE EST UN TROISIEME ETAT. Sur une machine sans pilote Vulkan, ce banc rend
77 -- ni 0 ni 1. config/bancs.list le declare par le verdict " code+ignore:77 ",
qui le compte et le NOMME a part. Un banc ignore qui rapporterait vert ferait
croire la question mesuree.

Dependances identiques a NkMsaaDeviceCheck : les backends graphiques lies, pas
la pile ML. Le lien vulkan-1 n est ajoute que si NK_ENABLE_VULKAN le veut ; sans
lui, le banc se construit et rend IGNORE a l execution, ce qui est la verite."""
from Jenga import *
from jengaconfig import *
import os


def _norm(p):
    return p.replace("\\", "/") if p else p


_VULKAN_SDK     = _norm(os.getenv("VULKAN_SDK", ""))
_VULKAN_INCLUDE = _norm(os.path.join(_VULKAN_SDK, "Include")) if _VULKAN_SDK else ""
_VULKAN_LIB     = _norm(os.path.join(_VULKAN_SDK, "Lib")) if _VULKAN_SDK else ""
_VULKAN_OPT     = os.getenv("NK_ENABLE_VULKAN", "auto").strip().lower()
if _VULKAN_OPT in ("0", "false", "off", "no"):
    _WANT_VULKAN = False
elif _VULKAN_OPT in ("1", "true", "on", "yes"):
    _WANT_VULKAN = True
else:
    _WANT_VULKAN = bool(_VULKAN_INCLUDE)

_GLSLANG_LIBS_WINDOWS = [
    "glslang", "SPIRV", "MachineIndependent", "GenericCodeGen",
    "glslang-default-resource-limits",
]
_IS_MINGW = "mingw" in TC_WINDOWS.lower()

with project("NkMsaaVulkanCheck"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    nkentseudependson(
        ["NKRHI", "NKSL", "NKWindow", "NKGlad", "NKMath", "NKTime", "NKStream",
         "NKLogger", "NKContainers", "NKMemory", "NKCore", "NKPlatform",
         "NKThreading", "NKGLSlang", "NKSPIRVCross"],
        extra_includes=["src", "%{NKGlad.location}/include"]
                       + ([_VULKAN_INCLUDE] if _VULKAN_INCLUDE else []),
        extra_defines=[f"NKENTSEU_ENABLE_VULKAN_BACKEND={1 if _WANT_VULKAN else 0}"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        if _VULKAN_LIB:
            libdirs([_VULKAN_LIB])
        _WIN_LINKS = [
            "NKGLSlang", "NKSPIRVCross",
            "user32", "gdi32", "opengl32", "dwmapi", "shell32",
            "uuid", "ole32", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
        ]
        if _WANT_VULKAN:
            _WIN_LINKS.append("vulkan-1")
            if not _IS_MINGW:
                _WIN_LINKS.extend(_GLSLANG_LIBS_WINDOWS)
        links(_WIN_LINKS)

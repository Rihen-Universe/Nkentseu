#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""NKDesignIABanc — le JEU D'EPREUVE de l'IA de design.

AUTEUR : TEUGUIA TADJUIDJE Rodolf Séderis — Rihen

Il lit les douze demandes ecrites A L'AVANCE dans
`Applications/NKUIDesign/exemples/ia/demandes.txt`, envoie chacune au dorsal
(le processus externe NKDesignLLM, ou le dorsal TEMOIN qui est le zero du banc),
et publie TROIS taux separes : le modele rend quelque chose / le document se lit
/ le document s'ouvre.

APPLICATION A PART ET NON UN DRAPEAU DE NKUIDesign : `main.cpp` et `Panels.h` de
NKUIDesign sont tenus par un autre chantier (extraction du module de conversation
IA). Un banc dans un binaire a part ne prend aucun fichier a personne, et il
n'ouvre AUCUNE fenetre -- ni GPU, ni entree, ni capture.

LE MONTAGE N'EST PAS ICI : le `.nkgui` produit est donne a
`NKGuiMonteTest --monter=<fichier>`. Deux instruments sans code commun.
"""
from Jenga import *
from jengaconfig import *


with project("NKDesignIABanc"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    # Le document, la mise en page, le pont `.nkgui` et le registre des
    # composants. Rien de graphique : pas de NKWindow, pas de NKRHI.
    # ── RESOLUTION DE FUSION (17/09) ────────────────────────────────────────
    # NKConverse est AJOUTE ICI, et ce n'est pas un ajustement cosmetique : ce
    # banc arrive de transit, ou `DesignAI.h` etait encore autonome. Dans
    # l'arbre du modeleur, ce fichier est devenu un RELAIS vers le module
    # `Kernel/System/NKConverse` (extraction du 17/09). Les deux cotes etaient
    # justes SEPAREMENT, et git n'avait rien a signaler : aucun des deux n'a
    # touche le fichier de l'autre. C'est la CONSTRUCTION qui l'a dit --
    # « 'NKConverse/NkConverse.h' file not found », 148/244.
    # Une fusion sans conflit n'est pas une fusion sure.
    nkentseudependson(
        ["NKConverse", "NKEditorKit", "NKGui", "NKSerialization", "NKReflection", "NKFileSystem",
         "NKFont", "NKImage", "NKStream", "NKEvent", "NKMath", "NKTime", "NKLogger",
         "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading"],
        extra_includes=["src", "../NKUIDesign/src"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows"):
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""RendererSandbox — projets Sandbox de la categorie Renderer (NKRenderer). Inclus par Sandbox.jenga.
Variables graphiques/Wayland partagees via useconfig (graphics.jenga/wayland.jenga)."""
from Jenga import *
from jengaconfig import *
from Jenga.Core.Api import androidallowrotation, harmonyets, harmonyassets
import os as _os

# Chemin ABSOLU vers les shaders NKRenderer (pour --preload-file Emscripten :
# emcc resout les chemins relatifs depuis SON cwd, pas depuis ce fichier).
# Le loader Jenga chdir dans le dossier du .jenga pendant l'exec -> on fige
# l'absolu ici, avec repli sur __file__ si le cwd n'est pas celui attendu.
_NK_SHADERS_DIR = _os.path.abspath(_os.path.join("..", "..", "Resources", "NKRenderer", "Shaders"))
if not _os.path.isdir(_NK_SHADERS_DIR):
    _NK_SHADERS_DIR = _os.path.abspath(_os.path.join(
        _os.path.dirname(str(globals().get('__file__', '.'))),
        "..", "..", "Resources", "NKRenderer", "Shaders"))
_NK_SHADERS_DIR = _NK_SHADERS_DIR.replace("\\", "/")


def sandboxusenkrenderer(project_name: str, source_files: list, app_id_suffix: str, needs_camera: bool = False, use_nkimage: bool = False, use_nkfont: bool = False, use_nkui: bool = False, use_nkgen: bool = False):
    with project(project_name):
        useappdeps("platform", "core", "memory", "containers", "math", "threading", "logger", "time", "event", "window", "image", "font", "ui", "rhi", "stream", "filesystem", "renderer", "serialization", "reflection", "NKMedia")
        windowedapp()
        language("C++")
        cppdialect("C++17")
        location(".")

        files(source_files)  # Now accepts a list of strings

        _SANDBOX_INCLUDE_DIRS = [
            "src",
            "%{wks.location}/Externals",
            "%{NKGlad.location}/include",
            "%{NKEvent.location}/src",
            "%{NKWindow.location}/src",
            "%{NKLogger.location}/src",
            "%{NKCore.location}/src",
            "%{NKPlatform.location}/src",
            "%{NKMath.location}/src",
            "%{NKTime.location}/src",
            "%{NKStream.location}/src",
            "%{NKFileSystem.location}/src",
            "%{NKMemory.location}/src",
            "%{NKContainers.location}/src",
            "%{NKThreading.location}/src",
            "%{NKRHI.location}/src",
            "%{NKSL.location}/src",
            "%{NKRenderer.location}/src",
            "%{NKSerialization.location}/src",
            "%{NKReflection.location}/src",
            "%{NKMedia.location}/src",
        ]
        if use_nkimage:
            _SANDBOX_INCLUDE_DIRS.append("%{NKImage.location}/src")
        if use_nkfont:
            _SANDBOX_INCLUDE_DIRS.append("%{NKFont.location}/src")
        if use_nkui:
            _SANDBOX_INCLUDE_DIRS.append("%{NKUI.location}/src")
        if use_nkgen:
            # Sous-systeme IA (Kernel/AI) : NKGen + sa pile (pour DemoNKGen).
            _SANDBOX_INCLUDE_DIRS.append("%{NKGen.location}/src")
            _SANDBOX_INCLUDE_DIRS.append("%{NKNN.location}/src")
            _SANDBOX_INCLUDE_DIRS.append("%{NKAutograd.location}/src")
            _SANDBOX_INCLUDE_DIRS.append("%{NKTensor.location}/src")

        if VULKAN_INCLUDE:
            _SANDBOX_INCLUDE_DIRS.append(VULKAN_INCLUDE)
        includedirs(_SANDBOX_INCLUDE_DIRS)

        _BASE_LINKS = [
            "NKMedia",  # avant NKImage/NKThreading (le linker mono-passe résout les refs vers l'aval)
            "NKEvent", "NKWindow", "NKGlad", "NKLogger",
            "NKMath", "NKTime", "NKStream", "NKFileSystem",
            "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading", "NKRHI", "NKRenderer", "NKSL",
            "NKSerialization", "NKReflection"
        ]
        if use_nkimage:
            _BASE_LINKS.append("NKImage")
        if use_nkfont:
            _BASE_LINKS.append("NKFont")
        if use_nkui:
            _BASE_LINKS.append("NKUI")
        if USE_NKGLSLANG:
            _BASE_LINKS.append("NKGLSlang")
        if USE_NKSPIRVCROSS:
            _BASE_LINKS.append("NKSPIRVCross")
        if use_nkgen:
            _BASE_LINKS.extend(["NKGen", "NKNN", "NKAutograd", "NKTensor"])

        links(_BASE_LINKS)
        dependson(_BASE_LINKS)
        defines([
            f"NKENTSEU_ENABLE_VULKAN_BACKEND={1 if WANT_VULKAN else 0}",
            "NKENTSEU_SERIALIZATION_STATIC_LIB",
        ])

        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
        targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

        with filter("system:Windows && options:windows-runtime=uwp"):
            objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-uwp/%{prj.name}")
            targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-uwp/%{prj.name}")

        # ===== Windows ================================================================
        with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
            windowedapp()
            usetoolchain(TC_WINDOWS)
            defines([
                "WIN32_LEAN_AND_MEAN",
                "_UNICODE", "UNICODE",
            ])
            if VULKAN_LIB:
                libdirs([VULKAN_LIB])
            if use_nkfont:
                libdirs(["%{NKFont.location}/lib"])
            _WIN_LINKS = [
                "user32", "gdi32", "opengl32", "dwmapi", "shell32",
                "mf", "mfplat", "mfreadwrite", "mfuuid",
                "uuid", "ole32", "dinput8", "dxguid",
                "d3d11", "d3d12", "dxgi", "d3dcompiler",
                "winmm"   # timeBeginPeriod(1) : Sleep 1 ms pour le pacing FPS moteur
            ]
            _IS_MINGW_R = "mingw" in TC_WINDOWS.lower()
            if WANT_VULKAN:
                _WIN_LINKS.append("vulkan-1")
                if not _IS_MINGW_R:
                    # glslang.lib (Vulkan SDK) compilé MSVC — incompatible avec MinGW
                    _WIN_LINKS.extend(GLSLANG_LIBS_WINDOWS)
            # NKGLSlang / NKSPIRVCross compilés source → compatibles MinGW, requis par NKRHI
            if USE_NKGLSLANG:    _WIN_LINKS.append("NKGLSlang")
            if USE_NKSPIRVCROSS: _WIN_LINKS.append("NKSPIRVCross")
            links(_WIN_LINKS)

        # ===== UWP ====================================================================
        with filter("system:UWP || system:Windows && options:windows-runtime=uwp"):
            windowedapp()
            usetoolchain("xbox-clang")
            defines(["NKENTSEU_PLATFORM_UWP"])
            links(["d3d12", "dxgi", "dxguid", "windowsapp"])

        # ===== Linux headless =========================================================
        with filter("system:Linux && options:linux-backend=headless || system:Linux && options:headless"):
            windowedapp()
            usetoolchain("clang-native")
            objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-headless/%{prj.name}")
            targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-headless/%{prj.name}")
            defines(["NKENTSEU_FORCE_WINDOWING_NOOP_ONLY"])
            links(["pthread"])

        # ===== Linux XLib =============================================================
        with filter("system:Linux && options:linux-backend=xlib || system:Linux && !options:linux-backend && !options:headless"):
            windowedapp()
            usetoolchain("clang-native")
            defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
            _LINUX_XLIB_LINKS = ["pthread", "X11", "Xrandr", "Xext", "GL", "asound", "m"]
            if WANT_VULKAN:
                _LINUX_XLIB_LINKS.append("vulkan")   # loader Vulkan sur la ligne de link finale
            links(_LINUX_XLIB_LINKS)

        # ===== Linux XCB ==============================================================
        with filter("system:Linux && options:linux-backend=xcb"):
            windowedapp()
            usetoolchain("clang-native")
            objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-xcb/%{prj.name}")
            targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-xcb/%{prj.name}")
            defines(["NKENTSEU_FORCE_WINDOWING_XCB_ONLY"])
            _LINUX_XCB_LINKS = ["pthread", "xcb", "xcb-image", "xcb-icccm", "xcb-randr", "xcb-xfixes", "X11", "X11-xcb", "Xext", "xkbcommon", "xkbcommon-x11", "GL"]
            if WANT_VULKAN:
                _LINUX_XCB_LINKS.append("vulkan")
            links(_LINUX_XCB_LINKS)
            ldflags(["-fuse-ld=lld"])

        # ===== Linux Wayland ==========================================================
        with filter("system:Linux && options:linux-backend=wayland"):
            windowedapp()
            usetoolchain("clang-native")
            objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-wayland/%{prj.name}")
            targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-wayland/%{prj.name}")
            defines(WAYLAND_DEFINES)
            _LINUX_WL_LINKS = list(WAYLAND_LINKS)
            if WANT_VULKAN:
                _LINUX_WL_LINKS.append("vulkan")
            links(_LINUX_WL_LINKS)

        # ===== macOS ==================================================================
        with filter("system:macOS"):
            windowedapp()
            usetoolchain("clang-native")
            frameworks(["Cocoa", "QuartzCore", "OpenGL"])

        # ===== Android ================================================================
        with filter("system:Android"):
            windowedapp()
            usetoolchain("android-ndk")
            _ANDROID_LINKS = ["android", "log", "EGL", "GLESv3"]
            if WANT_VULKAN:
                _ANDROID_LINKS.append("vulkan")
            links(_ANDROID_LINKS)
            androidapplicationid(f"com.nkentseu.{app_id_suffix}")
            androidminsdk(24)
            androidtargetsdk(34)
            androidcompilesdk(34)
            androidabis(["armeabi-v7a", "arm64-v8a", "x86", "x86_64"])
            androidnativeactivity(True)
            androidallowrotation(True)
            androidstl("c++_shared")
            # Shaders NKRenderer embarques dans l'APK (assets/). Sans eux, les 16
            # programmes de NkShaderLibrary sortent vides (scene 3D noire/vide).
            # Contenu copie RELATIF au dossier declare : assets/PBR/..., assets/
            # Include/..., etc. Cote C++, NkFile::SetAndroidAssetSubFolder(
            # "NKRenderer/Shaders") fait matcher les chemins
            # "Resources/NKRenderer/Shaders/<X>" -> asset "<X>" (cf. NkFile.cpp).
            # Textures/ (216 Mo) volontairement exclues : seuls les shaders sont
            # necessaires pour un rendu non vide.
            androidassets(["../../Resources/NKRenderer/Shaders"])
            if needs_camera:
                androidpermissions([
                    "android.permission.CAMERA",
                ])

        # ===== iOS ====================================================================
        with filter("system:iOS"):
            windowedapp()
            frameworks(["UIKit", "QuartzCore", "OpenGLES"])
            iosbundleid(f"com.nkentseu.{app_id_suffix}")
            iosversion("1.0")
            iosminsdk("14.0")
            iosbuildnumber(1)

        # ===== Web ====================================================================
        with filter("system:Web"):
            consoleapp()
            usetoolchain("emscripten")
            emscriptenshellfile("web/emscripten_fullscreen_nofavicon.html")
            emscriptencanvasid("canvas")
            emscripteninitialmemory(32)
            emscriptenextraflags([
                "-s", "ASYNCIFY",
                "-s", "DYNAMIC_EXECUTION",
                "-s", "EXPORTED_RUNTIME_METHODS=['ccall','cwrap','HEAPU8']",
                "-s", "INITIAL_MEMORY=67108864",
                "-s", "ALLOW_MEMORY_GROWTH=1",
                "-s", "FULL_ES3=1",
                "-s", "USE_WEBGL2=1",
                "-s", "ASSERTIONS=1",
                "-s", "NO_EXIT_RUNTIME=1",
                "-s", "SAFE_HEAP=1",
            ])
            # Shaders NKRenderer embarques dans le systeme de fichiers MEMFS
            # (renderdemo.data + XHR au chargement). Monte a la racine sous
            # /Resources/NKRenderer/Shaders : le cwd MEMFS est "/", donc les
            # chemins C++ relatifs "Resources/NKRenderer/Shaders/<X>" matchent
            # sans aucun changement cote moteur (equivalent Web de
            # androidassets, cf. filtre Android ci-dessus).
            if _os.path.isdir(_NK_SHADERS_DIR):
                emscriptenextraflags([
                    "--preload-file", f"{_NK_SHADERS_DIR}@/Resources/NKRenderer/Shaders",
                ])

        # ===== HarmonyOS ==============================================================
        with filter("system:HarmonyOS"):
            windowedapp()
            usetoolchain("ohos-ndk")
            # OHOS n'a PAS liblog (Android-only) : le logging natif passe par
            # libhilog_ndk.z.so. Linker "log" faisait echouer le link avec
            # « ld.lld: error: unable to find library -llog » (meme convention que
            # Pong / NkImageDemo / NkCameraDemos).
            # ace_ndk.z : API OH_NativeXComponent (pont surface, cf. NkHarmonyOS.h /
            # NkHarmonyWindow.cpp) — sans elle, le dlopen NAPI echoue sur
            # "OH_NativeXComponent_GetXComponentId: symbol not found".
            # native_window : API OHNativeWindow (meme convention que NKRHI.jenga).
            # ace_napi.z : napi_module_register (macro NAPI_MODULE de NkHarmonyOS.h).
            # rawfile.z : API OH_ResourceManager_* (lecture des shaders packages
            # dans resources/rawfile/ du HAP — repli NkFile, cf. NkFile.cpp).
            _HARMONY_LINKS = ["hilog_ndk.z", "EGL", "GLESv3", "ace_ndk.z", "ace_napi.z", "native_window", "rawfile.z"]
            if WANT_VULKAN:
                _HARMONY_LINKS.append("vulkan")
            links(_HARMONY_LINKS)
            harmonybundlename(f"com.nkentseu.{app_id_suffix}")
            harmonyminsdk(12)
            harmonytargetapi(12)
            # Page ArkTS avec XComponent (libraryname = lib<projet>.so) : remplace
            # le Index.ets "Hello World" du template DevEco dans harmony-build.
            # Sans elle, rien ne charge la .so et l'app reste sur le template.
            harmonyets(["harmony/ets/Index.ets"])
            # Shaders NKRenderer embarques dans le HAP (resources/rawfile/).
            # Equivalent HAP de androidassets : contenu copie RELATIF au dossier
            # declare -> rawfile/PBR/..., rawfile/Include/..., etc. Cote C++,
            # NkFile::SetAndroidAssetSubFolder("NKRenderer/Shaders") + repli
            # rawfile manager (NkFile.cpp) font matcher les chemins
            # "Resources/NKRenderer/Shaders/<X>" -> rawfile "<X>".
            harmonyassets(["../../Resources/NKRenderer/Shaders"])

        # ===== Xbox ===================================================================
        with filter("system:XboxSeries || system:XboxOne"):
            windowedapp()
            usetoolchain("xbox-clang")
            links(["d3d12", "dxgi", "dxguid", "xgameruntime"])

        with filter("config:Debug"):
            defines(["_DEBUG"])
            optimize("Off")
            symbols(True)
        with filter("config:Release"):
            defines(["NDEBUG"])
            optimize("Speed")
            symbols(False)

        # Tests unitaires/benchmarks (desktop uniquement)
        with filter("(system:Linux || system:macOS || (system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne)) && !system:Android && !system:iOS && !system:Web"):
            with test():
                testfiles(["tests/**.cpp"])
                with filter("system:Linux && options:linux-backend=wayland"):
                    defines(WAYLAND_DEFINES)
                    links(WAYLAND_TEST_LINKS)
                with filter("system:Linux && options:linux-backend=xcb"):
                    defines(["NKENTSEU_FORCE_WINDOWING_XCB_ONLY"])
                    links(["pthread", "xcb", "xcb-image", "xcb-icccm", "xcb-randr", "xcb-xfixes", "X11", "X11-xcb", "Xext", "xkbcommon", "xkbcommon-x11", "GL"])
                with filter("system:Linux && options:linux-backend=xlib || system:Linux && !options:linux-backend && !options:headless"):
                    defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
                    links(["pthread", "X11", "Xext", "GL"])
                with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
                    if VULKAN_LIB:
                        libdirs([VULKAN_LIB])
                    _WIN_TEST_LINKS = [
                        "user32", "gdi32", "opengl32", "dwmapi", "shell32",
                        "mf", "mfplat", "mfreadwrite", "mfuuid",
                        "uuid", "ole32", "dinput8", "dxguid",
                        "d3d11", "d3d12", "dxgi", "d3dcompiler"
                    ]
                    if WANT_VULKAN:
                        _WIN_TEST_LINKS.append("vulkan-1")
                    links(_WIN_TEST_LINKS)


# ── Demos de cette categorie ──
# =================================== NKRenderer UI =======================================================
# sandboxusenkrenderer("Scene", ["src/DemoNkentseu/Base05/NkRendererDemo.cpp"], "sandbox.scene.base04", use_nkimage=True, use_nkfont=True, use_nkui=True)
sandboxusenkrenderer("r2d01", ["src/DemoNkentseu/Base05/NkRenderer2DDemo.cpp"], "sandbox.scene.r2d01", use_nkimage=True, use_nkfont=True, use_nkui=True)
sandboxusenkrenderer("renderdemo", ["src/Demo/**.cpp"], "sandbox.render.demo", use_nkimage=True, use_nkfont=True, use_nkui=True, use_nkgen=True)
# Test CPU du loader glTF 2.0 (NkGLTFLoader) — pas de GPU requis.
sandboxusenkrenderer("gltftest", ["src/GLTFTest/**.cpp"], "sandbox.render.gltftest", use_nkimage=True, use_nkfont=True, use_nkui=True)

#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""RhiSandbox — projets Sandbox de la categorie RHI (NKRHI). Inclus par Sandbox.jenga.
Variables graphiques/Wayland partagees via useconfig (graphics.jenga/wayland.jenga)."""
from Jenga import *
from jengaconfig import *
from Jenga.Core.Api import androidallowrotation


# Parametre use_nkui retire le 2026-08-17 (campagne retrait NKUI, decision R1) :
# ses deux seuls consommateurs (NKUIDemo, NKUID) sont deregistres en bas de ce
# fichier — meme geste que RendererSandbox.jenga (commit 81c5615d).
def sandboxusenkrhi(project_name: str, source_files: list, app_id_suffix: str, needs_camera: bool = False, use_nkimage: bool = False, use_nkfont: bool = False):
    with project(project_name):
        windowedapp()
        language("C++")
        cppdialect("C++17")
        location(".")

        files(source_files)  # Now accepts a list of strings

        _DEPS = [
            "NKEvent", "NKWindow", "NKGlad", "NKLogger",
            "NKMath", "NKTime", "NKStream", "NKFileSystem",  # NKFileSystem requis : NkAndroidWindow appelle NkFile::SetAndroidAssetManager
            "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading", "NKRHI", "NKSL"
        ]
        if use_nkimage:
            _DEPS.append("NKImage")
        if use_nkfont:
            _DEPS.append("NKFont")
        _DEPS.append("NKGLSlang")
        _DEPS.append("NKSPIRVCross")

        nkentseudependson(
            _DEPS,
            extra_includes=["src", "%{wks.location}/Externals",
                            "%{NKGlad.location}/include"]
                           + ([VULKAN_INCLUDE] if VULKAN_INCLUDE else []),
            extra_defines=[f"NKENTSEU_ENABLE_VULKAN_BACKEND={1 if WANT_VULKAN else 0}"],
        )

        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
        targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

        with filter("system:Windows && options:windows-runtime=uwp"):
            objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-uwp/%{prj.name}")
            targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-uwp/%{prj.name}")

        # ===== Windows ================================================================
        with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
            windowedapp()
            usetoolchain(TC_WINDOWS)
            defines([
                "WIN32_LEAN_AND_MEAN",
                "_UNICODE", "UNICODE",
            ])
            if VULKAN_LIB:
                libdirs([VULKAN_LIB])
            if use_nkfont:
                libdirs(["%{NKFont.location}/lib"])
            _WIN_LINKS = [
                "user32", "gdi32", "opengl32", "dwmapi", "shell32",
                "mf", "mfplat", "mfreadwrite", "mfuuid",
                "uuid", "ole32", "dinput8", "dxguid",
                "d3d11", "d3d12", "dxgi", "d3dcompiler"
            ]
            _IS_MINGW_R = "mingw" in TC_WINDOWS.lower()
            if WANT_VULKAN:
                _WIN_LINKS.append("vulkan-1")
                if not _IS_MINGW_R:
                    # glslang.lib (Vulkan SDK) compilé MSVC — incompatible avec MinGW
                    _WIN_LINKS.extend(GLSLANG_LIBS_WINDOWS)
            # NKGLSlang / NKSPIRVCross compilés source → compatibles MinGW, requis par NKRHI
            if USE_NKGLSLANG:    _WIN_LINKS.append("NKGLSlang")
            if USE_NKSPIRVCROSS: _WIN_LINKS.append("NKSPIRVCross")
            links(_WIN_LINKS)

        # ===== UWP ====================================================================
        with filter("system:UWP || system:Windows && options:windows-runtime=uwp"):
            windowedapp()
            usetoolchain("xbox-clang")
            defines(["NKENTSEU_PLATFORM_UWP"])
            links(["d3d12", "dxgi", "dxguid", "windowsapp"])

        # ===== Linux headless =========================================================
        with filter("system:Linux && options:linux-backend=headless || system:Linux && options:headless"):
            windowedapp()
            usetoolchain("clang-native")
            objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-headless/%{prj.name}")
            targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-headless/%{prj.name}")
            defines(["NKENTSEU_FORCE_WINDOWING_NOOP_ONLY"])
            links(["pthread"])

        # ===== Linux XLib =============================================================
        with filter("system:Linux && options:linux-backend=xlib || system:Linux && !options:linux-backend && !options:headless"):
            windowedapp()
            usetoolchain("clang-native")
            defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
            links(["pthread", "X11", "Xext", "GL"])

        # ===== Linux XCB ==============================================================
        with filter("system:Linux && options:linux-backend=xcb"):
            windowedapp()
            usetoolchain("clang-native")
            objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-xcb/%{prj.name}")
            targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-xcb/%{prj.name}")
            defines(["NKENTSEU_FORCE_WINDOWING_XCB_ONLY"])
            links(["pthread", "xcb", "xcb-image", "xcb-icccm", "xcb-randr", "xcb-xfixes", "X11", "X11-xcb", "Xext", "xkbcommon", "xkbcommon-x11", "GL"])
            ldflags(["-fuse-ld=lld"])

        # ===== Linux Wayland ==========================================================
        with filter("system:Linux && options:linux-backend=wayland"):
            windowedapp()
            usetoolchain("clang-native")
            objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-wayland/%{prj.name}")
            targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-wayland/%{prj.name}")
            defines(WAYLAND_DEFINES)
            links(WAYLAND_LINKS)

        # ===== macOS ==================================================================
        with filter("system:macOS"):
            windowedapp()
            usetoolchain("clang-native")
            frameworks(["Cocoa", "QuartzCore", "OpenGL"])

        # ===== Android ================================================================
        with filter("system:Android"):
            windowedapp()
            usetoolchain("android-ndk")
            _ANDROID_LINKS = ["android", "log", "EGL", "GLESv3", "NKGlad"]   # ← AJOUTER NKGlad
            if WANT_VULKAN:
                _ANDROID_LINKS.append("vulkan")
            links(_ANDROID_LINKS)
            androidapplicationid(f"com.nkentseu.{app_id_suffix}")
            androidminsdk(24)
            androidtargetsdk(34)
            androidcompilesdk(34)
            androidabis(["armeabi-v7a", "arm64-v8a", "x86", "x86_64"])
            androidnativeactivity(True)
            androidallowrotation(True)
            androidstl("c++_shared")
            if needs_camera:
                androidpermissions([
                    "android.permission.CAMERA",
                ])

        # ===== iOS ====================================================================
        with filter("system:iOS"):
            windowedapp()
            frameworks(["UIKit", "QuartzCore", "OpenGLES"])
            iosbundleid(f"com.nkentseu.{app_id_suffix}")
            iosversion("1.0")
            iosminsdk("14.0")
            iosbuildnumber(1)

        # ===== Web ====================================================================
        with filter("system:Web"):
            consoleapp()
            usetoolchain("emscripten")
            emscriptenshellfile("web/emscripten_fullscreen_nofavicon.html")
            emscriptencanvasid("canvas")
            emscripteninitialmemory(32)
            emscriptenextraflags([
                "-s", "ASYNCIFY",
                "-s", "DYNAMIC_EXECUTION",
                "-s", "EXPORTED_RUNTIME_METHODS=['ccall','cwrap','HEAPU8']",
                "-s", "INITIAL_MEMORY=67108864",
                "-s", "ALLOW_MEMORY_GROWTH=1",
                "-s", "FULL_ES3=1",
                "-s", "USE_WEBGL2=1",
                "-s", "ASSERTIONS=1",
                "-s", "NO_EXIT_RUNTIME=1",
                "-s", "SAFE_HEAP=1",
            ])

        # ===== HarmonyOS ==============================================================
        with filter("system:HarmonyOS"):
            windowedapp()
            links(["log", "EGL", "GLESv3"])

        # ===== Xbox ===================================================================
        with filter("system:XboxSeries || system:XboxOne"):
            windowedapp()
            usetoolchain("xbox-clang")
            links(["d3d12", "dxgi", "dxguid", "xgameruntime"])

        with filter("config:Debug"):
            defines(["_DEBUG"])
            optimize("Off")
            symbols(True)
        with filter("config:Release"):
            defines(["NDEBUG"])
            optimize("Speed")
            symbols(False)

        # Tests unitaires/benchmarks (desktop uniquement)
        with filter("(system:Linux || system:macOS || (system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne)) && !system:Android && !system:iOS && !system:Web"):
            with test():
                testfiles(["tests/**.cpp"])
                with filter("system:Linux && options:linux-backend=wayland"):
                    defines(WAYLAND_DEFINES)
                    links(WAYLAND_TEST_LINKS)
                with filter("system:Linux && options:linux-backend=xcb"):
                    defines(["NKENTSEU_FORCE_WINDOWING_XCB_ONLY"])
                    links(["pthread", "xcb", "xcb-image", "xcb-icccm", "xcb-randr", "xcb-xfixes", "X11", "X11-xcb", "Xext", "xkbcommon", "xkbcommon-x11", "GL"])
                with filter("system:Linux && options:linux-backend=xlib || system:Linux && !options:linux-backend && !options:headless"):
                    defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
                    links(["pthread", "X11", "Xext", "GL"])
                with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
                    if VULKAN_LIB:
                        libdirs([VULKAN_LIB])
                    _WIN_TEST_LINKS = [
                        "user32", "gdi32", "opengl32", "dwmapi", "shell32",
                        "mf", "mfplat", "mfreadwrite", "mfuuid",
                        "uuid", "ole32", "dinput8", "dxguid",
                        "d3d11", "d3d12", "dxgi", "d3dcompiler"
                    ]
                    if WANT_VULKAN:
                        _WIN_TEST_LINKS.append("vulkan-1")
                    links(_WIN_TEST_LINKS)


# ── Demos de cette categorie ──
# =================================== Renderer RHI =======================================================
sandboxusenkrhi("NkRHIDemoFull", ["src/DemoNkentseu/Base03/NkRHIDemoFull.cpp"], "sandbox.rhidemo.full")
sandboxusenkrhi("NkRHIInterpTest", ["src/DemoNkentseu/Base03/NkRHIInterpTest.cpp"], "sandbox.rhidemo.interptest")
sandboxusenkrhi("NkSWRasterPrimitives", ["src/DemoNkentseu/Base03/NkSWRasterPrimitives.cpp"], "sandbox.sw.raster.primitives")
sandboxusenkrhi("NkRHIDemoFullImage", ["src/DemoNkentseu/Base03/NkRHIDemoFullImage.cpp"], "sandbox.rhidemo.fullimage", use_nkimage=True)
sandboxusenkrhi("NkFontDemo", ["src/DemoNkentseu/Base03/NkFontDemoFromScratch.cpp"], "sandbox.nkfont.demo", use_nkfont=True)
sandboxusenkrhi("NkFDV2", ["src/DemoNkentseu/Base03/NkFontDemoVI.cpp"], "sandbox.nkfont.demov2", use_nkfont=True)
# ─────────────────────────────────────────────────────────────────────────────
# DEMOS DE TEXTE DESACTIVEES — ancienne API NKFont, disparue (2026-08-15)
#
# Ces cibles consomment une GENERATION D'API NKFont qui n'existe plus. Ce n'est
# pas un symbole qui a derive, c'est toute une surface remplacee sans que ses
# consommateurs suivent :
#
#   demande par les demos : NkFontLibrary, NkFontLibraryDesc, NkFontResult,
#                           NkTextShaper, NkShapeResult, nk_handle,
#                           NK_INVALID_HANDLE, NK_LOAD_OUTLINES, NK_LOAD_KERNING
#   expose par NKFont      : NkFont, NkFontAtlas, NkFontGlyph, NkFontFaceInfo,
#                           NkRasterizer, NkShape, NkFontVertexBuffer, ...
#
# AUCUN des symboles demandes n'existe. Les porter n'est pas une correction
# mecanique : c'est une REECRITURE de chaque demo contre la nouvelle API.
#
# POURQUOI ON DESACTIVE PLUTOT QUE DE PORTER, ET POURQUOI C'EST ECRIT ICI.
# `NkRHIDemoText` bloquait le BUILD COMPLET du workspace a 61/205 : 144 cibles
# n'etaient jamais atteintes, donc jamais verifiees, donc libres de casser sans
# que personne le sache. Un blocage qui dure assez longtemps fait cesser de
# lancer la mesure -- et c'est exactement ce qui s'est produit : deux de ces
# quatre cibles (`NkRHIDemoFullText`, `oglfont` dans ContextSandbox.jenga)
# etaient DEJA commentees, sans un mot de raison. Le meme defaut a donc ete
# rencontre, neutralise en silence, et oublie.
#
# L'objectif n'est pas 203/203, c'est ZERO ECHEC INEXPLIQUE. Une cible qui ne
# peut pas construire et dont on SAIT pourquoi est reglee ; une cible qui bloque
# tout sans explication ne l'est pas.
#
# A ARBITRER PAR RODOLF -- deux issues, aucune n'est prise ici :
#   1. PORTER ces demos vers l'API actuelle (NkFontAtlas + NkRasterizer +
#      NkShape). Cout reel, elles couvrent le rendu de texte RHI.
#   2. LES SUPPRIMER. `NkFontDemo` et `NkFDV2` ci-dessus construisent et
#      couvrent deja NKFont sur la nouvelle API ; ces quatre-la ne testent
#      peut-etre plus rien que d'autres ne testent.
# Voir DETTE_LISIBILITE.md, chantier 11.
#
# Fichiers concernes SANS AUCUNE CIBLE (donc jamais compiles, ni avant ni
# maintenant) : Base03/NkFontDemo01.cpp, Base03/"NkRHIDemoText copy.cpp",
# Opengl/NkFontGLTestSimple.cpp, Opengl/"Nkfontgltest copy.cpp",
# Opengl/NkFontSimpleAdapter.h, Base04/tmp/NkUIFontIntegration.h,
# src/test_rasterizer.cpp -- meme API morte, meme arbitrage.
# ─────────────────────────────────────────────────────────────────────────────

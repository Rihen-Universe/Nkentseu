#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""NkOngletSonde — SONDE DE MESURE, pas un produit.

AUTEUR : TEUGUIA TADJUIDJE Rodolf Séderis — Rihen

Deux mesures du canal `onglets.questions.md`, dans UN seul binaire pour ne pas
comparer deux constructions qui pourraient differer par autre chose que ce
qu'on croit :

  (o1) la bande d'onglets PARTAGEE du kit, peinte par la coquille — elle doit
       occuper les pixels de sa metrique `band_h`, et bouger quand on mute
       cette metrique ;
  (o2) les ACCENTS — un « é » affiché et MESURE, avec un temoin NEGATIF : un
       glyphe hors de la plage par defaut de l'atlas, qui doit rester absent.
       Un banc qui ne sait dire que « oui » ne mesure rien.

Calque sur NkChromeProbe : meme fermeture de dependances.
"""

from Jenga import *
from jengaconfig import *


with project("NkOngletSonde"):
    windowedapp()
    language("C++")
    cppdialect("C++17")
    location(".")

    files(["src/**.cpp"])

    nkentseudependson(
        ["NKEditorKit", "NKCanvas", "NKGui", "NKReflection", "NKWindow", "NKEvent", "NKGlad",
         "NKFont", "NKImage", "NKLogger", "NKMath", "NKTime", "NKStream",
         "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading"],
        extra_includes=["src", "src/NkOngletSonde", "%{NKGlad.location}/include"]
                       + ([VULKAN_INCLUDE] if VULKAN_INCLUDE else []),
        extra_defines=[f"NKENTSEU_ENABLE_VULKAN_BACKEND={1 if WANT_VULKAN else 0}"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    apppublisher("Rihen Universe")
    appversion("0.1.0")
    licensefile("../../LICENSE")

    # ===== Windows ================================================================
    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        windowedapp()
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        if VULKAN_LIB:
            libdirs([VULKAN_LIB])
        _WIN_LINKS = [
            "user32", "gdi32", "opengl32", "dwmapi", "shell32",
            "mf", "mfplat", "mfreadwrite", "mfuuid",
            "uuid", "ole32", "dinput8", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
        ]
        if WANT_VULKAN:
            _WIN_LINKS.append("vulkan-1")
        links(_WIN_LINKS)

    # ===== Linux XLib (defaut) ===================================================
    with filter("system:Linux && options:linux-backend=xlib || system:Linux && !options:linux-backend && !options:headless"):
        windowedapp()
        usetoolchain("clang-native")
        defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
        links(["pthread", "X11", "Xext", "GL"])

    # ===== macOS ==================================================================
    with filter("system:macOS"):
        windowedapp()
        usetoolchain("clang-native")
        frameworks(["Cocoa", "QuartzCore", "OpenGL"])

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

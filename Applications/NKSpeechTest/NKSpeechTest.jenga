"""NKSpeechTest — tests headless du module de parole NKSpeech (NKAI).

Console pure (AUCUN device GPU) : exécute les self-tests (features MFCC ; ASR/TTS à venir).
Linke NKSpeech + le noyau Foundation transitif."""
from Jenga import *
from jengaconfig import *

with project("NKSpeechTest"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    nkentseudependson(
        ["NKSpeech", "NKMath", "NKLogger", "NKContainers", "NKMemory", "NKCore", "NKPlatform"],
        extra_includes=["src"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        links(["user32"])

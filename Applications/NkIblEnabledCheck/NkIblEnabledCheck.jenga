"""NkIblEnabledCheck -- cfg.ibl.enabled est-il HONORE ?

B4 des 25 capacites A-DATER. Le drapeau etait declare, documente, et n avait
AUCUNE lecture dans le depot : les onze autres champs de NkIBLConfig sont lus par
NkRendererImpl::InitEnvironment(), lui seul ne l etait pas.

Le correctif est UN if. Ce banc existe parce que la mesure disait aussi ZERO
ecriture de ibl.enabled dans tout l arbre : un if que personne n emprunte est du
code dont on ne sait pas s il est juste. Le if sans le banc serait une regression
deguisee en progres.

Mode COMPLET : il exige un peripherique GPU et un NkRenderer. Sur une machine
sans carte il rend 77 (IGNORE) -- ni OK, ni ECHEC. Son TEMOIN (ibl.enabled=true
doit donner un environnement) passe AVANT la mesure : sinon le cas mesure rendrait
nullptr pour une raison etrangere au drapeau.

Dependances : celles de NkMsaaVulkanCheck plus NKRenderer."""
from Jenga import *
from jengaconfig import *
import os


def _norm(p):
    return p.replace("\\", "/") if p else p


_VULKAN_SDK     = _norm(os.getenv("VULKAN_SDK", ""))
_VULKAN_INCLUDE = _norm(os.path.join(_VULKAN_SDK, "Include")) if _VULKAN_SDK else ""
_VULKAN_LIB     = _norm(os.path.join(_VULKAN_SDK, "Lib")) if _VULKAN_SDK else ""
_VULKAN_OPT     = os.getenv("NK_ENABLE_VULKAN", "auto").strip().lower()
if _VULKAN_OPT in ("0", "false", "off", "no"):
    _WANT_VULKAN = False
elif _VULKAN_OPT in ("1", "true", "on", "yes"):
    _WANT_VULKAN = True
else:
    _WANT_VULKAN = bool(_VULKAN_INCLUDE)

_GLSLANG_LIBS_WINDOWS = [
    "glslang", "SPIRV", "MachineIndependent", "GenericCodeGen",
    "glslang-default-resource-limits",
]
_IS_MINGW = "mingw" in TC_WINDOWS.lower()

with project("NkIblEnabledCheck"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    nkentseudependson(
        ["NKRenderer", "NKRHI", "NKSL", "NKWindow", "NKGlad", "NKMath", "NKTime", "NKStream",
         "NKLogger", "NKContainers", "NKMemory", "NKCore", "NKPlatform",
         "NKThreading", "NKGLSlang", "NKSPIRVCross"],
        extra_includes=["src", "%{NKGlad.location}/include"]
                       + ([_VULKAN_INCLUDE] if _VULKAN_INCLUDE else []),
        extra_defines=[f"NKENTSEU_ENABLE_VULKAN_BACKEND={1 if _WANT_VULKAN else 0}"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        if _VULKAN_LIB:
            libdirs([_VULKAN_LIB])
        _WIN_LINKS = [
            "NKGLSlang", "NKSPIRVCross",
            "user32", "gdi32", "opengl32", "dwmapi", "shell32",
            "uuid", "ole32", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
        ]
        if _WANT_VULKAN:
            _WIN_LINKS.append("vulkan-1")
            if not _IS_MINGW:
                _WIN_LINKS.extend(_GLSLANG_LIBS_WINDOWS)
        links(_WIN_LINKS)

"""NKQwen2SftGpuTest — jalon 6 du chantier QLoRA : l'affinage LoRA RÉEL du
Qwen2.5 7B sur GPU (NKInfer/NkQwen2LoraGpu + NkLoraGpu + NkQKGpuBackward).
Prouve : (a) le matmul transposé fusé Q4_K/Q6_K == référence CPU sur de VRAIS
tenseurs du blob ; (b) le gradient complet == différences finies directionnelles
sur les 20 M paramètres d'adaptateurs ; (c) la perte d'entraînement ET la perte
de validation (échantillon DISJOINT) sur un vrai corpus français ; (d) la
sauvegarde/rechargement NKLA redonne EXACTEMENT les mêmes logits ; (e) les mêmes
5 questions avant et après l'affinage.
Usage : NKQwen2SftGpuTest.exe [chemin_gguf_ou_blob_ollama]
Backend verrouillé sur Vulkan (NK_TENSOR_API) : output.weight = 447 Mo en Q6_K
dépasse les 128 Mo garantis par ressource en D3D11.
"""
from Jenga import *
from jengaconfig import *
import os


_GLSLANG_LIBS_WINDOWS = [
    "glslang", "SPIRV", "MachineIndependent", "GenericCodeGen",
    "glslang-default-resource-limits",
]
_IS_MINGW = "mingw" in TC_WINDOWS.lower()

with project("NKQwen2SftGpuTest"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    nkentseudependson(
        ["NKInfer", "NKFileSystem", "NKTensor", "NKAutograd",
         "NKRHI", "NKSL", "NKWindow", "NKGlad", "NKMath", "NKTime", "NKStream",
         "NKLogger", "NKContainers", "NKMemory", "NKCore", "NKPlatform",
         "NKThreading", "NKGLSlang", "NKSPIRVCross"],
        extra_includes=["src", "%{NKGlad.location}/include"]
                       + ([VULKAN_INCLUDE] if VULKAN_INCLUDE else []),
        extra_defines=[f"NKENTSEU_ENABLE_VULKAN_BACKEND={1 if WANT_VULKAN else 0}"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        if VULKAN_LIB:
            libdirs([VULKAN_LIB])
        _WIN_LINKS = [
            "NKGLSlang", "NKSPIRVCross",
            "user32", "gdi32", "opengl32", "dwmapi", "shell32",
            "uuid", "ole32", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
        ]
        if WANT_VULKAN:
            _WIN_LINKS.append("vulkan-1")
            if not _IS_MINGW:
                _WIN_LINKS.extend(_GLSLANG_LIBS_WINDOWS)
        links(_WIN_LINKS)

"""NKIlyana — le modele de Rihen : preparation des donnees, entrainement, dialogue."""
from Jenga import *
from jengaconfig import *
import os


_GLSLANG_LIBS_WINDOWS = [
    "glslang", "SPIRV", "MachineIndependent", "GenericCodeGen",
    "glslang-default-resource-limits",
]
_IS_MINGW = "mingw" in TC_WINDOWS.lower()

# TLS optionnel, ALIGNE sur NKNetwork.jenga (NK_ENABLE_TLS=1). Sans lui, aucune
# trace de mbed-TLS dans l'executable — c'est ce qui a permis d'isoler la
# regression du 2026-08-11 (lecture PDF disparue quand mbed-TLS etait lie).
_TLS_ON = os.getenv("NK_ENABLE_TLS", "").strip().lower() in ("1", "true", "on", "yes", "mbedtls")
_TLS_DEPS = ["NKMbedTLS"] if _TLS_ON else []
_TLS_WIN_LINKS = ["bcrypt"] if _TLS_ON else []

with project("NKIlyana"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    nkentseudependson(
        ["NKGpt", "NKTrain", "NKNN", "NKData", "NKOptim", "NKAutograd", "NKTensor", "NKRHI", "NKSL",
         "NKWindow", "NKGlad", "NKMath", "NKTime", "NKStream", "NKFileSystem",
         "NKLogger", "NKContainers", "NKMemory", "NKCore", "NKPlatform",
         "NKThreading", "NKGLSlang", "NKSPIRVCross", "NKImage", "NKMedia", "NKFont", "NKNetwork"] + _TLS_DEPS,
        extra_includes=["src", "%{NKGlad.location}/include"]
                       + ([VULKAN_INCLUDE] if VULKAN_INCLUDE else []),
        extra_defines=[f"NKENTSEU_ENABLE_VULKAN_BACKEND={1 if WANT_VULKAN else 0}"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        if VULKAN_LIB:
            libdirs([VULKAN_LIB])
        _WIN_LINKS = [
            "NKGLSlang", "NKSPIRVCross",
            "user32", "gdi32", "opengl32", "dwmapi", "shell32",
            "uuid", "ole32", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
        ] + _TLS_WIN_LINKS
        if WANT_VULKAN:
            _WIN_LINKS.append("vulkan-1")
            if not _IS_MINGW:
                _WIN_LINKS.extend(_GLSLANG_LIBS_WINDOWS)
        links(_WIN_LINKS)

        # Runtime C++/GCC EN STATIQUE. Sans cela l'exe (chaine ucrt64) charge
        # libstdc++/libgcc/libwinpthread depuis le PATH ; si /mingw64/bin y passe
        # avant /c/msys64/ucrt64/bin, il obtient un runtime bati sur msvcrt alors
        # qu'il libere via ucrtbase -> DEUX TAS. Le symptome n'est pas un echec de
        # chargement mais une corruption bien plus tard, dans glslang, au premier
        # noyau compute compile (constate 2026-08-09 : toute la voie GPU de NKAI
        # mourait en silence). Ces deux drapeaux rendent l'exe autonome.
        # Ne PAS ajouter -static seul ni -fuse-ld=lld : cela casse la selection lld.
        if _IS_MINGW:
            ldflags(["-static-libstdc++", "-static-libgcc"])

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

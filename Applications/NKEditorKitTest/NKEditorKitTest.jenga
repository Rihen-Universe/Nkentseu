#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""NKEditorKitTest — banc SANS FENETRE de NKEditorKit.

Mesure deux choses purement calculables, donc verifiables en integration
continue comme en local, sans GPU ni serveur d'affichage :

  A. la resolution des ROLES DE THEME (`NkResolveRole` / `NkRoleRegistry::Find`)
     et le repli franc qui l'accompagne ;
  B. le vocabulaire du CHOIX DE BACKEND graphique (`NkEditorGfxApi`), Metal
     compris, et son refus motive sur les plateformes qui ne le portent pas.

⚠️ POURQUOI UNE APPLICATION CONSOLE ET PAS UN `unitest()` : l'execution des
   tests unitaires est desactivee par la politique du workspace
   (« Unit-test execution is disabled by workspace policy »). Un banc qu'on ne
   peut pas EXECUTER ne mesure rien. Il est donc une application console, comme
   les autres bancs du depot, et il rend un code de sortie : 0 tout vert,
   1 des qu'un essai tombe.

⚠️ IL LIE TOUT LE KIT, ET C'EST VOULU. `NkTheme.h` est un en-tete pur — le banc
   pourrait se contenter de ses includes. Lier la bibliotheque fait en plus
   compiler `NkEditorShell.cpp` et `NkEditorCanvasRenderer.h`, donc verifie que
   l'enumeration `NkEditorGfxApi` reste traduisible par son implantation. Sans
   ca, ajouter une entree a l'enumeration passerait le banc tout en cassant le
   rendu.

Point d'extension : ajouter un essai = ajouter un `Check(...)` dans `src/main.cpp`.
Rien a toucher ici tant qu'aucune dependance nouvelle n'entre.
"""

from Jenga import *
from jengaconfig import *
import os


def _norm(p):
    return p.replace("\\", "/") if p else p


_VULKAN_SDK     = _norm(os.getenv("VULKAN_SDK", ""))
_VULKAN_INCLUDE = _norm(os.path.join(_VULKAN_SDK, "Include")) if _VULKAN_SDK else ""
_VULKAN_LIB     = _norm(os.path.join(_VULKAN_SDK, "Lib")) if _VULKAN_SDK else ""
_VULKAN_OPT     = os.getenv("NK_ENABLE_VULKAN", "auto").strip().lower()
if _VULKAN_OPT in ("0", "false", "off", "no"):
    _WANT_VULKAN = False
elif _VULKAN_OPT in ("1", "true", "on", "yes"):
    _WANT_VULKAN = True
else:
    _WANT_VULKAN = bool(_VULKAN_INCLUDE)

with project("NKEditorKitTest"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")

    files(["src/main.cpp"])

    nkentseudependson(
        ["NKEditorKit", "NKCanvas", "NKGui", "NKReflection", "NKWindow", "NKEvent", "NKGlad",
         "NKFont", "NKImage", "NKLogger", "NKMath", "NKTime", "NKStream",
         "NKFileSystem", "NKContainers", "NKMemory", "NKCore", "NKPlatform", "NKThreading"],
        extra_includes=["src", "%{NKGlad.location}/include"]
                       + ([_VULKAN_INCLUDE] if _VULKAN_INCLUDE else []),
        extra_defines=[f"NKENTSEU_ENABLE_VULKAN_BACKEND={1 if _WANT_VULKAN else 0}"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    # ===== Windows ================================================================
    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        if _VULKAN_LIB:
            libdirs([_VULKAN_LIB])
        _WIN_LINKS = [
            "user32", "gdi32", "opengl32", "dwmapi", "shell32",
            "mf", "mfplat", "mfreadwrite", "mfuuid",
            "uuid", "ole32", "dinput8", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
        ]
        if _WANT_VULKAN:
            _WIN_LINKS.append("vulkan-1")
        links(_WIN_LINKS)

    # ===== Linux ==================================================================
    with filter("system:Linux && options:linux-backend=xlib || system:Linux && !options:linux-backend && !options:headless"):
        usetoolchain("clang-native")
        defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
        links(["pthread", "X11", "Xext", "GL"])

    # ===== macOS ==================================================================
    with filter("system:macOS"):
        usetoolchain("clang-native")
        frameworks(["Cocoa", "QuartzCore", "OpenGL"])

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)
    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

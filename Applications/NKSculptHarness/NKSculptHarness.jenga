#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""NKSculptHarness -- la sculpture VOLUMIQUE agit-elle ? EN CONSOLE, sans GPU.

AUTEUR : TEUGUIA TADJUIDJE Rodolf Séderis — Rihen

Eprouve la chaine complete demandee par Rodolf le 19/09/2026 : un DESCRIPTEUR de
brosse lu depuis un fichier de donnees, un REGISTRE qui l'expose, et un trait
applique aux sommets reels d'un NkEditMesh.

LE CRITERE CENTRAL EST LE REGISTRE : une brosse deposee dans data/brushes/
apparait et AGIT sans recompiler. Le banc lit donc le DISQUE ; il n'embarque
aucune chaine. Un banc qui parserait un litteral prouverait le parseur, et la
demande n'est pas la.

BANC DEDIE PLUTOT QU'UNE FAMILLE DE NKEditMeshHarness, pour la meme raison que
NKNormalesTest : ce harnais-la porte une baseline comparee octet pour octet, et
y ajouter des cas obligerait a la regenerer -- donc a re-valider d'un geste tout
ce qu'elle protege.

AUCUN ATTENDU EN DUR. Tous les criteres sont des INVARIANTS : egalite AU BIT
pour le zero et l'annulation, SIGNE de la variation de volume pour la direction
(les deux sens exiges, sinon le hasard passe une fois sur deux), conservation du
nombre de bords pour la topologie. Un chiffre grave se perime, et en vert.

NE MESURE PAS : le rendu (ni GPU ni image), ni la sculpture 2.5D (espace ecran,
dossier Tools/PixolSculpt), ni le branchement dans NK3DModeler.
"""
from Jenga import *
from jengaconfig import *


_GLSLANG_LIBS_WINDOWS = [
    "glslang", "SPIRV", "MachineIndependent", "GenericCodeGen",
    "glslang-default-resource-limits",
]
_IS_MINGW = "mingw" in TC_WINDOWS.lower()

with project("NKSculptHarness"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    files(["src/main.cpp"])

    # NkEditMesh est du CPU pur mais vit dans NKRenderer : on tire sa chaine de
    # liaison, comme le fait NKEditMeshHarness pour la meme raison.
    nkentseudependson(
        ["NKRenderer", "NKRHI", "NKSL", "NKWindow", "NKEvent", "NKFont", "NKImage",
         "NKFileSystem", "NKSerialization", "NKReflection", "NKGlad", "NKMath", "NKTime",
         "NKStream", "NKLogger", "NKContainers", "NKMemory", "NKCore", "NKPlatform",
         "NKThreading", "NKGLSlang", "NKSPIRVCross"],
        extra_includes=["src", "%{NKGlad.location}/include"]
                       + ([VULKAN_INCLUDE] if VULKAN_INCLUDE else []),
        extra_defines=[f"NKENTSEU_ENABLE_VULKAN_BACKEND={1 if WANT_VULKAN else 0}"],
    )

    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        usetoolchain(TC_WINDOWS)
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        if VULKAN_LIB:
            libdirs([VULKAN_LIB])
        _WIN_LINKS = [
            "NKGLSlang", "NKSPIRVCross",
            "user32", "gdi32", "opengl32", "dwmapi", "shell32",
            "uuid", "ole32", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
        ]
        if WANT_VULKAN:
            _WIN_LINKS.append("vulkan-1")
            if not _IS_MINGW:
                _WIN_LINKS.extend(_GLSLANG_LIBS_WINDOWS)
        links(_WIN_LINKS)

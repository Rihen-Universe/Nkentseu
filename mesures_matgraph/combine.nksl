// ENGENDRE par NkMatCompileToNkSL -- ne pas editer a la main.
// Le graphe est la source ; ce fichier en est la trace lisible.
//
// Un « shader » est approxime a la EEVEE : quatre locales scalaires ou
// vectorielles (albedo, metallic, roughness, emission), et non une closure.
// NkSL n'accepte pas de variable locale de type struct utilisateur -- c'est
// pour cette raison, pas par gout, que les composantes sont separees.

@location(0) in vec3 vWorldPos;
@location(1) in vec3 vNormal;
@location(2) in vec2 vUV;
@location(3) in vec4 vColor;

@location(0) out vec4 fragColor;

@binding(set=0, binding=0)
uniform CameraUBO {
    mat4  view;
    mat4  proj;
    mat4  viewProj;
    mat4  invViewProj;
    vec4  camPos;
    vec4  camDir;
    vec2  viewport;
    float time;
    float deltaTime;
    float iblStrength;
} uCam;

@stage(fragment)
@entry
void main() {
    vec3 nkGeomN = normalize(vNormal);

    // mat.separer_xyz #3 -- Separate XYZ
    float n3_x = (vec3(0.25, 0.5, 0.75)).x;
    float n3_y = (vec3(0.25, 0.5, 0.75)).y;
    float n3_z = (vec3(0.25, 0.5, 0.75)).z;

    // mat.combiner_xyz #4 -- Combine XYZ
    vec3 n4_vector = vec3((n3_x), (n3_y), (n3_z));

    // mat.principled #2 -- Principled BSDF
    vec3 n2_albedo = n4_vector;
    float n2_metallic = 0.0;
    float n2_roughness = 0.349999994;
    vec3 n2_emission = vec3(0.0);
    vec3 n2_normal = nkGeomN;

    // mat.sortie #1 -- Material Output
    vec3 surfAlbedo = n2_albedo;
    float surfMetallic = n2_metallic;
    float surfRoughness = n2_roughness;
    vec3 surfEmission = n2_emission;
    vec3 surfNormal = n2_normal;

    vec3 N3 = normalize(surfNormal);
    vec3 L  = normalize(vec3(-0.3, 1.0, 0.4));
    vec3 V  = normalize(uCam.camPos.xyz - vWorldPos);
    vec3 H  = normalize(L + V);
    float NdotL = max(dot(N3, L), 0.0);
    float NdotH = max(dot(N3, H), 0.0);
    float specExp = mix(128.0, 2.0, surfRoughness);
    float spec = pow(NdotH, specExp);
    vec3 specColor = mix(vec3(1.0), surfAlbedo, surfMetallic);
    vec3 diffuse = surfAlbedo * (NdotL + 0.18);
    vec3 specular = specColor * spec * (surfMetallic * 0.7 + 0.3);
    fragColor = vec4(diffuse + specular + surfEmission, 1.0);
}

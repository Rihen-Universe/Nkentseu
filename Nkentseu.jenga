        pass



    with include("Applications/NKGpuBenchTest/NKGpuBenchTest.jenga"):

        pass



    with include("Applications/NKConvBenchTest/NKConvBenchTest.jenga"):

        pass



    with include("Applications/NKConvResidentBench/NKConvResidentBench.jenga"):


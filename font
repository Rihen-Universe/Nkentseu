        CS  = 7,   ///< Common Separator
        NSM = 8,   ///< Non-Spacing Mark
        BN  = 9,   ///< Boundary Neutral
        B   = 10,  ///< Paragraph Separator
        S   = 11,  ///< Segment Separator
        WS  = 12,  ///< Whitespace
        ON  = 13,  ///< Other Neutral

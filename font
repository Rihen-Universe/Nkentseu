/**
 * @File    NkFixed26_6.cpp
 * @Brief   Implémentation de NkFixed26_6, NkFixed16_16, NkMatrix2x2.
 * @Author  TEUGUIA TADJUIDJE Rodolf Séderis
 * @License Apache-2.0
 *
 * @Notes
 *  Tout est constexpr/inline dans le .h — aucune implémentation hors-ligne.
 *  Ce .cpp assure l'export MSVC des symboles de struct marqués NKENTSEU_FONT_API.
 */

#include "pch.h"

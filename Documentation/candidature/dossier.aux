\@writefile{toc}{\xpg@aux {}{french}}
\pgfsyspdfmark {pgfid1}{5216401}{50557805}
\@writefile{toc}{\contentsline {section}{\numberline {1}Le moteur de rendu - écrit sans aucune bibliothèque graphique}{2}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \xpg@aux {}{french}\ignorespaces Image produite par le moteur Nkentseu. Éclairage physique (PBR), ombres douces par cartes d'ombres virtualisées, halo lumineux, occlusion ambiante, correction colorimétrique cinéma (ACES). Aucune bibliothèque de rendu tierce n'intervient : le pipeline complet, du calcul de la lumière jusqu'au pixel, est écrit dans le projet. Les vignettes en haut et à droite sont des incrustations générées par le système de sortie du logiciel.}}{2}{figure.caption.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}NK3DModeler - le logiciel de modélisation 3D bâti sur le moteur}{3}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \xpg@aux {}{french}\ignorespaces NK3DModeler : interface complète de modélisation 3D construite sur le moteur. Hiérarchie de scène, panneaux de propriétés, gizmos de transformation, aimantation géométrique, système de sortie (rendu d'images et enregistrement vidéo). Toute l'interface est dessinée par le moteur lui-même.}}{3}{figure.caption.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}NKCode - l'environnement de développement, également écrit from-scratch}{4}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \xpg@aux {}{french}\ignorespaces NKCode lisant une vidéo produite par le moteur (format AVI/MJPEG, 1368$\times $639, 25 images/s) - le lecteur vidéo, le décodeur et le fichier proviennent tous du même projet. À gauche, la liste des modules du moteur : NKPlatform, NKCore, NKLogger, NKMath, NKMemory, NKContainers, NKImage, NKFont, NKAudio, NKMedia, NKTime, NKStream, NKThreading, NKFileSystem, NKReflection, NKNetwork, NKSerialization. En bas, la compilation en cours.}}{4}{figure.caption.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \xpg@aux {}{french}\ignorespaces Écran d'accueil de NKCode. L'espace de travail Nkentseu y déclare \textbf  {501 projets} compilables et \textbf  {8 plateformes} cibles. À droite, 28 exemples fournis avec Jenga, le système de compilation également développé pour ce projet. En bas à gauche : les versions réelles des deux outils.}}{5}{figure.caption.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Le dépôt public - activité et adoption}{5}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \xpg@aux {}{french}\ignorespaces Dépôt public \texttt  {github.com/Rihen-Universe/Nkentseu} : \textbf  {815 commits}, 4 branches, \textbf  {16 forks}, \textbf  {11 étoiles}, 2~contributeurs. Répartition des langages : \textbf  {C++ 82,6~\%}, C 12,5~\%, GLSL 1,4~\%, Python 1,3~\%, HLSL 0,8~\%. Les messages de commit, rédigés en français, décrivent des travaux d'ingénierie précis et datés.}}{6}{figure.caption.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Preuve d'usage par des tiers}{6}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \xpg@aux {}{french}\ignorespaces Rapports de bugs ouverts sur NKCode-Beta par des utilisateurs \emph  {extérieurs au projet} (comptes \texttt  {Nyeck-Abondo} et \texttt  {JustSmoking}) : \textbf  {13 tickets ouverts}, 2 résolus. Ils portent sur l'usage réel du logiciel - raccourcis clavier, création de fenêtres, intégration du système de compilation, ouverture de dossiers.}}{6}{figure.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}La transmission, à l'école et par le code}{7}{subsection.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}La transmission - un manuel de 196 pages}{7}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}L'intelligence artificielle et la langue ghomala}{7}{section.7}\protected@file@percent }

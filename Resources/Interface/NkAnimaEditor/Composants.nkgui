nkgui 0.4

// AUTEUR : TEUGUIA TADJUIDJE Rodolf Séderis — Rihen
//
// LES COMPOSANTS DE NkAnimaEditor — document 09 §3, mot pour mot.
//
// ═══════════════════════════════════════════════════════════════════════════
//  CE FICHIER EST UNE TRADUCTION, PAS UNE INVENTION
// ═══════════════════════════════════════════════════════════════════════════
//  Chaque composant ci-dessous est celui du §3 de
//  `design/09-interface-agent-nkanima.md`. Quand la spécification écrit un rôle
//  marqué ✚ (proposé) ou un rôle non monté, elle dit elle-même **ce qu'il faut
//  écrire aujourd'hui** : c'est cette écriture-là qui est ici, et la ligne
//  d'origine reste en commentaire juste au-dessus.
//
//  ⚠️ ON N'ÉCRIT PAS LE RÔLE PROPOSÉ « POUR QU'IL VOYAGE » ICI. Un rôle que le
//     monteur ne connaît pas est compté `rolesInconnus`, **et un document qui
//     nomme l'inconnaissable est REFUSÉ en entier** — ses voisins valides
//     compris. Le format sait faire voyager une intention (une section, un
//     attribut, un état), il ne sait pas faire voyager un RÔLE. La substitution
//     prescrite par la spécification n'est donc pas un pis-aller : c'est la
//     seule écriture qui laisse le document se monter.
//
//  ⚠️ LES COULEURS EN DUR PORTENT LEUR JETON EN COMMENTAIRE (P1). Le jour où
//     `@nom` arrive, un remplacement mécanique suffit — c'est la consigne
//     littérale du §1 P1.

// ── 3.1 `BoutonOutil` — un outil de la vue ────────────────────────────────
//  Spécification : `ToggleButton✚ "bouton"  icon: "?"  group: outils_vue`
//  Aujourd'hui : `Button`. L'état actif s'écrit en `appearance(Active)` —
//  compté, non peint, et c'est voulu (§1 P2 « en attendant »).
component "BoutonOutil" {
  widgets {
    Button "bouton" {
      label = "?"
      appearance {
        radius = 2
      }
      appearance(Active) {
        fill { color = #1177D1 }
        text { color = #FFFFFF }
      }
    }
  }
}

// ── 3.2 `BoutonTransport` — déjà livré le 26/09 ───────────────────────────
//  « Réutilisé tel quel » (§3.2). Ses états de survol et d'appui datent du
//  26/09 et sont PEINTS depuis le 27 : le pétrole de la charte éclairci au
//  survol, assombri à l'appui, encre blanche dans les deux.
component "BoutonTransport" {
  widgets {
    Button "bouton" {
      label = "?"
      appearance {
        radius = 3
      }
      appearance(Hover) {
        fill { color = #0E6B78 }
        text { color = #FFFFFF }
      }
      appearance(Pressed) {
        fill { color = #073F47 }
        text { color = #FFFFFF }
      }
    }
  }
}

// ── 3.3 `BoutonEcrit` — un bouton qui écrit une clé ───────────────────────
//  📌 « Composant et non copie : la couleur « écrit » ne doit exister qu'à UN
//     endroit. » C'est la raison d'être de ce fichier en une phrase.
component "BoutonEcrit" {
  widgets {
    Button "bouton" {
      label = "?"
      appearance {
        radius = 2
        fill { color = #F79A28 }  // @info.ecrit
        text { color = #10222B }
      }
      appearance(Hover) {
        fill { color = #FFB04A }  // @info.ecrit éclairci
      }
      appearance(Pressed) {
        fill { color = #D98517 }  // @info.ecrit assombri
      }
      appearance(Disabled) {
        fill { color = #7A6A55 }
        text { color = #C9BBA6 }
      }
    }
  }
}

// ── 3.4 `EnTetePanneau` — recherche en tête de panneau ────────────────────
//  `icon✚: search` sur le `TextField` n'existe pas (P12) : le `placeholder`
//  « Rechercher… » le remplace, comme la spécification le prescrit.
component "EnTetePanneau" {
  widgets {
    HBox "entete" {
      gap = 4
      align = Center

      TextField "recherche" {
        placeholder = "Rechercher…"
      }

      Button "filtres" {
        label = "Filtres"
        tooltip = "Filtres"
      }

      Button "options" {
        label = "Options"
        tooltip = "Options du panneau"
      }
    }
  }
}

// ── 3.5 `Categorie` — catégorie repliable du panneau Détails ──────────────
//  La spécification disait : « les lignes s'écrivent dans l'instance comme
//  enfants de `<instance>.corps` — si le développement ne le permet pas, c'est
//  exactement le besoin de P9 : signale-le. »
//
//  🔴 IL NE LE PERMETTAIT PAS, ET C'ÉTAIT SILENCIEUX. Mesure du 27/09 : le
//     développement REMPLACE l'instance par le patron, et les enfants écrits sur
//     l'instance n'étaient réinjectés nulle part — ils **disparaissaient**, sans
//     compteur ni refus. Un document qui écrivait ses lignes ici ressemblait à
//     un document plus pauvre, pas à un document cassé.
//
//  ✅ **P9 est livré le même jour** : `Slot "corps"` marque la place, et les
//     enfants de l'instance la prennent. Le banc le mesure sur `montes` — 2 sans
//     `Slot`, 4 avec — et non sur un compteur de `Slot`, qui serait vert même si
//     les enfants n'arrivaient nulle part.
component "Categorie" {
  widgets {
    Expander "categorie" {
      label = "?"
      expanded = true
      Slot "corps" { }
    }
  }
}

// ── 3.6 Les lignes de propriété ───────────────────────────────────────────
//  Même forme, valeur différente. `sizes` de `Grid` n'est pas honoré
//  aujourd'hui (`attributsNonHonores`) : « écris-le quand même » — §3.6.
//  `KeyDiamond✚` → `Button` icône `diamond`, identifiant
//  `commun.cle_propriete`, `tooltip` = le chemin (§1 P6 « en attendant »).

component "LigneNombre" {
  widgets {
    Grid "ligne" {
      columns = 4
      sizes = [0.40, 0.50, 0.05, 0.05]
      gap = 4

      Text "etiquette" {
        text = "?"
      }

      // Spécification : `Drag "valeur"  speed: 0.1` — `Drag` non monté.
      Slider "valeur" {
        min = 0
        max = 1
      }

      Button "commun.reinitialiser_propriete" {
        label = "↺"
        tooltip = "Revenir à la valeur par défaut"
        visible = false
      }

      Button "commun.cle_propriete" {
        label = "◆"
        tooltip = "?"
      }
    }
  }
}

component "LigneVec3" {
  widgets {
    Grid "ligne" {
      columns = 4
      sizes = [0.40, 0.50, 0.05, 0.05]
      gap = 4

      Text "etiquette" {
        text = "?"
      }

      // La valeur est un `ChampVec3` (§3.7) ; un composant ne s'instancie pas
      // dans un autre patron sans P9, donc les trois curseurs sont ici.
      HBox "vec" {
        gap = 2

        Slider "x" {
          min = -1
          max = 1
        }

        Slider "y" {
          min = -1
          max = 1
        }

        Slider "z" {
          min = -1
          max = 1
        }
      }

      Button "commun.reinitialiser_propriete" {
        label = "↺"
        tooltip = "Revenir à la valeur par défaut"
        visible = false
      }

      Button "commun.cle_propriete" {
        label = "◆"
        tooltip = "?"
      }
    }
  }
}

component "LigneListe" {
  widgets {
    Grid "ligne" {
      columns = 4
      sizes = [0.40, 0.50, 0.05, 0.05]
      gap = 4

      Text "etiquette" {
        text = "?"
      }

      Dropdown "valeur" {
        items = ["?"]
      }

      Button "commun.reinitialiser_propriete" {
        label = "↺"
        tooltip = "Revenir à la valeur par défaut"
        visible = false
      }

      Button "commun.cle_propriete" {
        label = "◆"
        tooltip = "?"
      }
    }
  }
}

component "LigneCase" {
  widgets {
    Grid "ligne" {
      columns = 4
      sizes = [0.40, 0.50, 0.05, 0.05]
      gap = 4

      Text "etiquette" {
        text = "?"
      }

      Checkbox "valeur" {
        label = ""
      }

      Button "commun.reinitialiser_propriete" {
        label = "↺"
        tooltip = "Revenir à la valeur par défaut"
        visible = false
      }

      Button "commun.cle_propriete" {
        label = "◆"
        tooltip = "?"
      }
    }
  }
}

// `ColorField` n'est pas monté : la valeur est un `Host`, qui DIT ce qu'il
// attend au lieu de faire semblant avec un bouton coloré.
component "LigneCouleur" {
  widgets {
    Grid "ligne" {
      columns = 4
      sizes = [0.40, 0.50, 0.05, 0.05]
      gap = 4

      Text "etiquette" {
        text = "?"
      }

      Host "valeur" {
        hint = "nuancier — ColorField n'est pas monté"
      }

      Button "commun.reinitialiser_propriete" {
        label = "↺"
        tooltip = "Revenir à la valeur par défaut"
        visible = false
      }

      Button "commun.cle_propriete" {
        label = "◆"
        tooltip = "?"
      }
    }
  }
}

// `CurveField✚` → `Host` avec `hint` (§1 P7 « en attendant »).
component "LigneCourbe" {
  widgets {
    Grid "ligne" {
      columns = 4
      sizes = [0.40, 0.50, 0.05, 0.05]
      gap = 4

      Text "etiquette" {
        text = "?"
      }

      Host "valeur" {
        hint = "courbe éditable en place — CurveField (P7)"
      }

      Button "commun.reinitialiser_propriete" {
        label = "↺"
        tooltip = "Revenir à la valeur par défaut"
        visible = false
      }

      Button "commun.cle_propriete" {
        label = "◆"
        tooltip = "?"
      }
    }
  }
}

// ── 3.7 `ChampVec3` — en attendant `VectorField` ──────────────────────────
//  Les liserés d'axe sont écrits en `appearance` : « comptés sur un rôle sans
//  surface », dit la spécification — donc comptés, non peints, et c'est su.
component "ChampVec3" {
  widgets {
    HBox "vec" {
      gap = 2

      Slider "x" {
        min = -1
        max = 1
        appearance {
          stroke { color = #D2362E }  // @axe.x
        }
      }

      Slider "y" {
        min = -1
        max = 1
        appearance {
          stroke { color = #5BA829 }  // @axe.y
        }
      }

      Slider "z" {
        min = -1
        max = 1
        appearance {
          stroke { color = #2F7FE0 }  // @axe.z
        }
      }
    }
  }
}

// ── 3.8 `PastilleOrigine` ─────────────────────────────────────────────────
//  `Badge✚` → `Text` avec `text { color }` du jeton (§1 P3 « en attendant »).
//  ⚠️ La pilule n'aura donc PAS de fond : `fill` n'est pas peint sur un `Text`
//     sans surface, et c'est précisément l'argument que P3 avance.
component "PastilleOrigine" {
  widgets {
    Text "pastille" {
      text = "M"
      tooltip = "Clé posée à la main"
      appearance {
        text { color = #D8D8D8 }  // @origine.main
      }
    }
  }
}

// ── 3.9 `CartePropo` — une proposition (IA, physique, agent) ──────────────
//  `pattern✚: Hatch` (P11) est écrit et compté. Le fond d'aperçu est
//  `@info.apercu` à 35 % : l'alpha s'écrit sur huit chiffres.
//  ⚠️ `BoutonEcrit` y est instancié : un composant DANS un composant — ET CE
//     CAS N'EST PAS ENCORE ÉPROUVÉ. Mesure du 27/09 : le document se charge,
//     17 composants sont définis, `rolesInconnus = 0` — mais **aucun document
//     n'instancie encore `CartePropo`**, donc le développement imbriqué n'a
//     jamais été exécuté. Un vert obtenu parce que le cas n'a pas été atteint
//     ne dit rien du cas. À vérifier quand l'Assistant IA (§5.13) l'emploiera.
component "CartePropo" {
  widgets {
    Panel "carte" {
      appearance {
        radius = 2
        fill { color = #9B6BF259 }  // @info.apercu à 35 %
        pattern = Hatch
      }

      VBox "corps" {
        gap = 4

        Host "apercu" {
          hint = "vignette animée de la proposition"
        }

        Text "resume" {
          text = "?"
          wrap = true
        }

        HBox "impact" {
          gap = 4

          Text "nbCles" {
            text = "?"
            appearance {
              text { color = #9B6BF2 }  // @info.apercu
            }
          }

          Text "canaux" {
            text = "?"
          }
        }

        HBox "actions" {
          gap = 4
          justify = End

          Button "ia.apercu" {
            label = "Aperçu"
          }

          BoutonEcrit "ia.appliquer" {
            label = "Appliquer"
          }

          Button "ia.rejeter" {
            label = "Rejeter"
          }
        }
      }
    }
  }
}

// ── 3.10 `TuileAction` — une action de l'espace Facile ────────────────────
//  `Tile✚` → « aujourd'hui : `Button` avec `label` » (§3.10).
component "TuileAction" {
  widgets {
    Button "tuile" {
      label = "?"
      size = (96, 96)
    }
  }
}

// ── 3.11 `CurseurParlant` — un réglage de l'espace Facile ─────────────────
//  Le titre va AU-DESSUS, hors composant : « un composant = une racine ».
component "CurseurParlant" {
  widgets {
    Grid "curseur" {
      columns = 3
      sizes = [0.30, 0.40, 0.30]

      Text "gauche" {
        text = "?"
        align = Right
      }

      Slider "valeur" {
        min = 0
        max = 1
      }

      Text "droite" {
        text = "?"
      }
    }
  }
}

// ── 3.12 `ModuleEffet` — un module de la Pile d'effets ────────────────────
//  `Switch` n'est pas monté : la spécification l'écrit quand même (« ils seront
//  comptés et non montés, c'est voulu »). Ici il RENDRAIT LE DOCUMENT REFUSÉ —
//  un rôle inconnu emporte tout le fichier. C'est donc `Checkbox`, qui est le
//  même sens avec une autre forme, et la ligne d'origine est au-dessus.
component "ModuleEffet" {
  widgets {
    Expander "module" {
      label = "?"
      expanded = false

      VBox "corps" {

        HBox "tete" {
          gap = 4

          // Spécification : `Switch "actif"  bind: ?.actif  label: "Actif"`
          Checkbox "actif" {
            label = "Actif"
          }

          Button "fx.preregler" {
            label = "Préréglages ▾"
          }

          Button "fx.supprimer_module" {
            label = "Supprimer"
            tooltip = "Supprimer ce module"
          }
        }
      }
    }
  }
}

nkgui 0.3

// AUTEUR : TEUGUIA TADJUIDJE Rodolf Séderis — Rihen
//
// LA BARRE D'OUTILS DE NkAnimaEditor, ET ELLE EST UNE DONNÉE.
// Ce fichier n'est pas de la documentation : c'est l'interface elle-même.
// Changez une ligne, relancez, la barre change. Rien à compiler.
//
// ═══════════════════════════════════════════════════════════════════════════
//  CE QU'ELLE PORTE, ET POURQUOI CET ORDRE
// ═══════════════════════════════════════════════════════════════════════════
//  La barre d'un atelier d'animation porte le TRANSPORT en premier — c'est le
//  geste qu'on fait cent fois par minute — puis l'édition de clés, puis la
//  pose, puis la vue. C'est l'ordre de Blender, de Cascadeur et d'iClone, et
//  il n'est pas arbitraire : la main revient toujours au même endroit.
//
//  ⚠️ LA BARRE NE RÉPÈTE PAS TOUT LE MENU. Elle porte ce qui se fait SOUVENT ;
//     le reste vit dans les menus. Une barre qui double le menu entier oblige
//     à lire deux fois la même chose pour trouver ce qu'on cherche.
//
//  L'IDENTIFIANT D'UN BOUTON EST LE NOM DE SON ACTION. Un nom que
//  l'application ne sert pas est COMPTÉ (`actionsInconnues`), jamais tu.

// ═══════════════════════════════════════════════════════════════════════════
//  UN COMPOSANT — un nom, un sous-arbre, son design (26/09)
// ═══════════════════════════════════════════════════════════════════════════
//  Les cinq boutons du transport ne different que par leur libelle et leur
//  action. Ecrits cinq fois, leur design se serait deja desynchronise a la
//  premiere retouche : c'est la definition meme d'un composant.
//
//  ⚠️ UNE SEULE RACINE, C'EST LE CONTRAT. La racine prend l'identifiant de
//     l'instance — donc le NOM DE L'ACTION — et les attributs de l'instance
//     l'emportent sur les siens. Sans cette surcharge, les cinq instances
//     seraient identiques et on aurait renomme la copie-colle.
//
//  ⚠️ ET LA DEFINITION NE SE MONTE PAS. Elle est retiree du document developpe
//     avant que le monteur ne le voie : un `widgets` de definition est un
//     patron, pas une vue. L'y laisser ferait compter des widgets montes nulle
//     part.
component "BoutonTransport" {
  widgets {
    Button "bouton" {
      label = "?"
      appearance {
        radius = 3
      }
    }
  }
}

widgets {

  HBox "outils" {
    gap = 6
    align = Center

    // ── LE TRANSPORT, en cinq instances d'un seul composant ───────────────
    BoutonTransport "anim.debut" {
      label = "|<"
    }

    BoutonTransport "anim.image_prec" {
      label = "<"
    }

    BoutonTransport "anim.jouer" {
      label = "Jouer / Pause"
    }

    BoutonTransport "anim.image_suiv" {
      label = ">"
    }

    BoutonTransport "anim.fin" {
      label = ">|"
    }

    Separator "sep_transport" {
      orientation = Vertical
    }

    // ── LES CLÉS ──────────────────────────────────────────────────────────
    Button "anim.inserer" {
      label = "Inserer une cle"
    }

    Button "anim.supprimer" {
      label = "Supprimer la cle"
    }

    Separator "sep_cles" {
      orientation = Vertical
    }

    Button "anim.annuler" {
      label = "Annuler"
    }

    Button "anim.refaire" {
      label = "Refaire"
    }

    Separator "sep_edition" {
      orientation = Vertical
    }

    // ── LA POSE ───────────────────────────────────────────────────────────
    //  ⚠️ « Editer la pose » et « Enregistrer » ne sont PAS le même bouton, et
    //     ils ne le seront jamais : entrer en édition ne doit pas écrire de
    //     clé, et enregistrer ne doit pas sortir du mode. Un bouton unique qui
    //     bascule ferait perdre une pose au premier clic de trop.
    Button "anim.pose_entrer" {
      label = "Editer la pose"
    }

    Button "anim.pose_enregistrer" {
      label = "Enregistrer en cle"
    }

    Separator "sep_pose" {
      orientation = Vertical
    }

    // ── LA VUE ────────────────────────────────────────────────────────────
    Button "anim.vue_solide" {
      label = "Solide"
    }

    Button "anim.vue_rendu" {
      label = "Rendu"
    }

    Button "anim.vue_filaire" {
      label = "Filaire"
    }
  }
}

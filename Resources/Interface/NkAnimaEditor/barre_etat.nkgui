nkgui 0.3

// AUTEUR : TEUGUIA TADJUIDJE Rodolf Séderis — Rihen
//
// LA BARRE D'ÉTAT DE NkAnimaEditor, ET ELLE EST UNE DONNÉE.
//
// ⚠️ ELLE EST LE TÉMOIN LE PLUS SIMPLE DU CHANTIER. Changez le texte ci-dessous,
//    relancez : le bas de la fenêtre change. Si rien ne change, le fil est
//    coupé, et c'est cette bande-là qu'il faut regarder en premier — elle n'a ni
//    valeur liée, ni comportement, ni zone hôte. Elle ne peut échouer que d'une
//    seule façon.

widgets {

  HBox "etat" {
    gap = 12
    align = Center

    Text "message" {
      text = "NkAnimaEditor — l'interface vient d'un document, pas du code"
    }

    Text "source" {
      text = "Resources/Interface/NkAnimaEditor/barre_etat.nkgui"
    }
  }
}

nkgui 0.4

// AUTEUR : TEUGUIA TADJUIDJE Rodolf Séderis — Rihen
//
// ═══════════════════════════════════════════════════════════════════════════
//  TOUTE L'INTERFACE DOCUMENTAIRE DE NKUIDesign, DANS UN SEUL FICHIER
// ═══════════════════════════════════════════════════════════════════════════
//  Quatre RACINES NOMMÉES, que la coquille monte à quatre instants différents :
//
//      widgets "menu"            -> SetAppMenu      (additif, dans la barre du kit)
//      widgets "barreOutils"    -> SetToolbar      (APRÈS les onglets de projet)
//      widgets "barreEtat"      -> SetStatusBarFn  (le bas de la fenêtre)
//      widgets "panneauOutils"  -> un panneau ancré à gauche
//
//  ⚠️ CE FICHIER N'AURAIT PAS PU EXISTER CE MATIN. `NkGuiMonteur::Monter` montait
//     TOUTES les sections `widgets` d'un document au curseur courant, et
//     `MonterCorps` est privée : il fallait un FICHIER par bande. NkAntenne en
//     avait 25 là où 5 suffisent, NkAnimaEditor 4, NKUIDesign 2 — et les trois
//     applications portaient la même phrase dans leurs commentaires : « il manque
//     `Monter(ctx, doc, "racine")` ». Il existe depuis le 27/09.
//
//  ⚠️ ET UNE FAUTE DE FRAPPE DANS UN NOM DE RACINE NE SE VOIT PAS À L'ŒIL : la
//     bande serait simplement vide, sans erreur. C'est pourquoi la sonde
//     `--sonde-coquille` vérifie que les QUATRE racines existent, et pourquoi le
//     rapport garde le dernier nom demandé en vain.

// ═══════════════════════════════════════════════════════════════════════════
//  LE MENU « Design » — additif, il ne remplace rien
// ═══════════════════════════════════════════════════════════════════════════
//  Monté par `SetAppMenu`, que la coquille appelle À L'INTÉRIEUR de sa propre
//  barre, après ses menus (`NkEditorShell.cpp:3497`). La barre est DÉJÀ ouverte —
//  y écrire un `MenuBar` en ouvrirait une seconde.
//
//  ⚠️ ON NE TOUCHE PAS À `SetMenuBar`. `DrawMenuBar` fait 447 lignes et porte
//     AUSSI la récolte de la génération IA — « le seul rappel appelé à CHAQUE
//     image sans condition », et une mesure du 14/09 a montré que la déplacer
//     dans le panneau IA la rendait inatteignable (« 0 image pendant l'attente »).
//     **On ne migre pas vers moins.**
//
//  L'identifiant d'un `MenuItem` EST le nom de l'action : c'est la convention de
//  cet hôte (celle de la zone `Host`), pas une extension du format. Un nom que
//  personne ne sert est COMPTÉ — un menu muet ne doit pas se faire prendre pour un
//  menu qui marche.

widgets "menu" {

  Menu "menuDesign" {
    label = "@t:design.ui.menuDesign"

    MenuItem "design.enregistrer" { label = "@t:design.enregistrer", shortcut = "Ctrl+S" }
    MenuItem "design.recharger"   { label = "@t:design.recharger" }
    MenuItem "design.nouveau"     { label = "@t:design.nouveau" }

    Separator "sep1" {}

    MenuItem "design.annuler"  { label = "@t:design.annuler", shortcut = "Ctrl+Z" }
    MenuItem "design.retablir" { label = "@t:design.retablir", shortcut = "Ctrl+Y" }

    Separator "sep2" {}

    MenuItem "design.grouper"   { label = "@t:design.grouperSelection", shortcut = "Ctrl+G" }
    MenuItem "design.degrouper" { label = "@t:design.degrouper", shortcut = "Ctrl+Maj+G" }
    MenuItem "design.dupliquer" { label = "@t:design.dupliquer", shortcut = "Ctrl+D" }

    Separator "sep3" {}

    MenuItem "design.exporter" { label = "@t:design.exporterPoints" }
  }

  Menu "menuVues" {
    label = "@t:design.ui.menuVues"

    MenuItem "design.vue.hierarchie" { label = "@t:design.vue.hierarchie", shortcut = "Ctrl+J" }
    MenuItem "design.vue.inspecteur" { label = "@t:design.vue.inspecteur" }

    // ⚠️ GRISÉES, PAS OMISES — et la raison est vérifiable. `CmdVuePalette`,
    //    `CmdVueComposition`, `CmdVueProprietes` et `CmdVuePreferences` vivent sous
    //    `#if NKUIDESIGN_ANCIENS_PANNEAUX` dans `main.cpp`, et ce drapeau est
    //    éteint : les fonctions n'existent pas dans cette construction. La règle de
    //    la maison est CÂBLER / GRISER / RETIRER — *une entrée qui s'affiche et ne
    //    fait rien est un mensonge ; une entrée grisée est une promesse datée* — et
    //    omettre ferait croire que ces vues ne sont pas prévues.
    //
    //    🔴 LA CONSTRUCTION A ATTRAPÉ MA PREMIÈRE VERSION : je les avais écrites
    //       actives et la table pointait sur quatre fonctions inexistantes. C'est
    //       le seul négatif qui n'a rien coûté.
    MenuItem "design.vue.palette"     { label = "@t:design.vue.palette",     enabled = false }
    MenuItem "design.vue.composition" { label = "@t:design.vue.composition", enabled = false }
    MenuItem "design.vue.proprietes"  { label = "@t:design.vue.proprietes",  enabled = false }
    MenuItem "design.vue.preferences" { label = "@t:design.vue.preferences", enabled = false }
  }
}

// ═══════════════════════════════════════════════════════════════════════════
//  LA BARRE D'OUTILS — elle s'AJOUTE aux onglets de projet
// ═══════════════════════════════════════════════════════════════════════════
//  ⚠️ `SetToolbar` N'ACCEPTE QU'UN SEUL RAPPEL, et `DrawProjectTabs` l'occupait :
//     il énumère les projets ouverts à l'exécution, et **le format ne sait pas
//     exprimer une liste engendrée**. Le remplacer aurait supprimé les onglets.
//
//     La coquille appelle donc un rappel qui fait les DEUX, dans cet ordre : les
//     onglets d'abord (le code qui marche), puis cette racine. Rien n'est retiré,
//     et le document gagne sa place dans la bande.

widgets "barreOutils" {

  HBox "outils" {
    gap = 6

    Button "design.annuler"   { label = "@t:design.annuler",   tooltip = "Annuler la derniere action", shortcut = "Ctrl+Z" }
    Button "design.retablir"  { label = "@t:design.retablir",  tooltip = "Refaire l'action annulee",   shortcut = "Ctrl+Y" }

    Separator "sep_o1" {}

    Button "design.grouper"   { label = "@t:design.grouper",   tooltip = "Grouper la selection", shortcut = "Ctrl+G" }
    Button "design.degrouper" { label = "@t:design.degrouper", tooltip = "Degrouper la selection" }
    Button "design.dupliquer" { label = "@t:design.dupliquer", tooltip = "Dupliquer la selection", shortcut = "Ctrl+D" }

    Separator "sep_o2" {}

    Button "design.enregistrer" { label = "@t:design.enregistrer", tooltip = "Enregistrer le document", shortcut = "Ctrl+S" }
    Button "design.exporter"    { label = "@t:design.exporter",    tooltip = "Exporter le document" }
  }
}

// ═══════════════════════════════════════════════════════════════════════════
//  LA BARRE D'ÉTAT — le témoin le plus simple du fil
// ═══════════════════════════════════════════════════════════════════════════
//  Changez le texte, relancez : le bas de la fenêtre change. Si rien ne change,
//  c'est cette racine qu'il faut regarder en premier — elle n'a ni valeur liée, ni
//  comportement, ni zone hôte. Elle ne peut échouer que d'une seule façon.
//
//  ⚠️ ET ELLE N'AFFICHE AUCUN CHIFFRE VIVANT, PARCE QU'ELLE NE LE PEUT PAS. Le
//     nombre de nœuds, le zoom, la sélection changent à chaque image ; le format
//     n'a pas de liaison en LECTURE SEULE vers une valeur de l'application (`bind`
//     écrit dans le magasin du document, il ne lit pas l'application). Écrire
//     « 0 nœud » en dur donnerait un chiffre juste une seconde et faux ensuite —
//     *un chiffre juste sous un nom faux coûte plus cher qu'un chiffre absent*. Le
//     chemin le plus court le jour où ce besoin revient est une zone `Host` ici.

widgets "barreEtat" {

  HBox "etat" {
    gap = 12
    align = Center

    Text "message" { text = "NKUIDesign — interface montee depuis un document .nkgui" }
    Text "source"  { text = "Resources/Interface/NKUIDesign/Interface.nkgui" }
  }
}

// ═══════════════════════════════════════════════════════════════════════════
//  LE PANNEAU « Outils » — le premier pas DANS `Panels.h`
// ═══════════════════════════════════════════════════════════════════════════
//  `Panels.h` fait 21 052 lignes. On n'en réécrit pas une seule : ce panneau-ci
//  s'AJOUTE, décrit par le document, et les autres continuent comme avant. C'est
//  le « doucement doucement » demandé le 27/09.
//
//  ⚠️ SON TITRE NE VIENT PAS DU DOCUMENT, et il faut le dire plutôt que de le
//     laisser croire. `NkEditorPanel` garde son titre dans un `char mTitle[64]`
//     posé à la construction et n'expose aucun `SetTitle` ; or le panneau se
//     construit AVANT que le document ne soit lu. Le rendre dynamique demanderait
//     de toucher NKEditorKit, qui appartient à un autre agent.
//     **CONDITION DE RETRAIT :** le jour où `NkEditorPanel` accepte un titre après
//     coup, il se lit sur le bloc racine ci-dessous et cette note disparaît.

widgets "panneauOutils" {

  VBox "outilsPanneau" {
    gap = 8

    Text "titre" { text = "Actions du document" }

    Separator "sep_p1" {}

    Button "design.nouveau"     { label = "@t:design.nouveau" }
    Button "design.recharger"   { label = "@t:design.recharger" }
    Button "design.enregistrer" { label = "@t:design.enregistrer", shortcut = "Ctrl+S" }

    Separator "sep_p2" {}

    Button "design.vue.hierarchie" { label = "@t:design.vue.hierarchieLong", shortcut = "Ctrl+J" }
    Button "design.vue.inspecteur" { label = "@t:design.vue.inspecteurLong" }
  }
}

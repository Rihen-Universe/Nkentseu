// carpaint.frag.nksl — NKRenderer — Carrosserie Fragment (VRAI dialecte NkSL).
// Base metallisee + PAILLETTES procedurales + VERNIS (clearcoat) : les trois
// couches qui font une peinture automobile. L'ancien .vk.glsl attendait une
// texture de paillettes dans le slot emissif et la disposition de varyings
// obsolete ; ici les paillettes sont generees (aucune texture requise).
@location(0) in vec3 vWorldPos;
@location(1) in vec3 vNormal;
@location(2) in vec2 vUV;
@location(3) in vec4 vColor;
@location(0) out vec4 fragColor;

@binding(set=0, binding=0)
uniform CameraUBO {
    mat4  view, proj, viewProj, invViewProj;
    vec4  camPos, camDir; vec2 viewport; float time, deltaTime;
    float iblStrength;
    float _p0, _p1, _p2;
    mat4  mirrorViewProj;
    vec4  reflectionFlags;
} uCam;

@binding(set=1, binding=1)
uniform ObjectUBO {
    mat4  model, normalMatrix; vec4 tint;
    float metallic, roughness, aoStrength, emissiveStrength;
    float normalStrength, clearcoat, clearcoatRoughness, subsurface;
    vec4  subsurfaceColor;
    vec4  shadowOverrides;
    vec4  triplanarParams;
} uObj;

@binding(set=0, binding=2)
uniform LightsUBO {
    vec4  positions[32], colors[32], directions[32], angles[32];
    int   count; int _pad0; int _pad1; int _pad2;
    // .x = loi d'attenuation (0 heritee, 1 physique 1/d^2 fenetree)
    // .y = largeur de la surfacique  .z = hauteur  .w reserve
    // En QUEUE de bloc : les shaders qui declarent la version courte lisent
    // `count` au meme endroit (regle du projet, cf. pbr.frag.nksl).
    vec4  extras[32];
} uLights;

#include "Include/NkLightCommon.glsli"

struct NkShadowSlot {
    mat4 shadowMatrix;
    vec4 tileUV;
    vec4 lightPosOrDir;
    vec4 packedIds;
};
@binding(set=0, binding=3)
uniform ShadowSlotsUBO {
    NkShadowSlot slots[256];
    vec4 firstSlotPerLight[8];
    vec4 slotCountPerLight[8];
    vec4 globalCfg;
    vec4 biasParams;
} uShadows;
@binding(set=0, binding=11) uniform sampler2DShadow tShadowAtlas;
@binding(set=0, binding=12) uniform sampler2D tShadowAtlasRaw;
#include "Include/NkShadowAtlas.glsli"

// `anisotropy` sert ici de DENSITE de paillettes, `sheen` de leur eclat —
// deux curseurs deja au panneau, reaffectes a ce type (comme UE reaffecte
// ses entrees selon le modele d'ombrage).
@binding(set=2, binding=8)
uniform MaterialUBO {
    vec4  albedo;
    vec4  emissive;
    float metallic;
    float roughness;
    float ao;
    float emissiveStrength;
    float normalStrength;
    float clearcoat;
    float clearcoatRough;
    float subsurface;
    vec4  subsurfaceColor;
    float anisotropy;
    float sheen;
    float reflFloorFaceMode;
    float reflBlend;
} uMat;

@binding(set=2, binding=3) uniform sampler2D tAlbedo;
@binding(set=0, binding=8) uniform samplerCube tEnvIrradiance;
@binding(set=0, binding=9) uniform samplerCube tEnvPrefilter;

float NkCpHash(vec2 p) {
    return fract(sin(p.x * 127.1 + p.y * 311.7) * 43758.5453);
}

@stage(fragment)
@entry
void main() {
    vec4 albSamp = texture(tAlbedo, vUV) * uMat.albedo * vColor;
    vec3 base    = albSamp.rgb;

    vec3 N = normalize(vNormal);
    vec3 camPosForV = uCam.camPos.xyz;
    if (uCam.reflectionFlags.x > 0.5) camPosForV.y = -camPosForV.y;
    vec3 V = normalize(camPosForV - vWorldPos);
    float NdotV = max(dot(N, V), 1e-4);

    // ── PAILLETTES : cellules pseudo-aleatoires en espace MONDE (elles ne
    // glissent pas sur la carrosserie quand la voiture tourne). Chaque
    // cellule allumee incline sa micro-normale : l'eclat scintille avec
    // l'angle, comme de vraies particules d'aluminium.
    float dens  = 40.0 + uMat.anisotropy * 260.0;
    vec3  cell  = floor(vWorldPos * dens);
    float rnd   = NkCpHash(cell.xy + cell.z * 17.0);
    float rnd2  = NkCpHash(cell.yz + cell.x * 31.0);
    vec3  flkN  = normalize(N + vec3(rnd - 0.5, rnd2 - 0.5, NkCpHash(cell.zx) - 0.5) * 0.7);
    float flkOn = step(0.82, rnd);
    float flake = pow(max(dot(reflect(-V, flkN), N), 0.0), 48.0) * flkOn;
    float flkAmt = max(uMat.sheen, 0.3);

    // ── VERNIS : couche speculaire nette par-dessus la base.
    float ccAmt   = max(uMat.clearcoat, 0.5);
    float ccRough = clamp(uMat.clearcoatRough, 0.02, 0.4);
    float ccPow   = 2.0 / (ccRough * ccRough) + 2.0;

    vec3 dWdx = dFdx(vWorldPos);
    vec3 dWdy = dFdy(vWorldPos);

    vec3 total = vec3(0.0);
    for (int i = 0; i < uLights.count && i < 32; i++) {
        vec4 lPos = uLights.positions[i];
        vec3 L    = (lPos.w < 0.5)
                  ? normalize(-uLights.directions[i].xyz)
                  : normalize(lPos.xyz - vWorldPos);
        float NdotL = max(dot(N, L), 0.0);
        if (NdotL <= 0.0) continue;

        float shadow = (uLights.angles[i].z > 0.5 && uObj.shadowOverrides.x > 0.5)
                       ? SampleLightShadowExD(i, vWorldPos, N, L, uObj.shadowOverrides.z, dWdx, dWdy) : 1.0;
        // SURFACIQUE : facteur de forme (cosinus + inverse carre inclus).
        float areaE = NkAreaFormFactor(i, vWorldPos, N);
        vec3  rad   = uLights.colors[i].rgb * uLights.colors[i].w * shadow
                    * ((areaE >= 0.0) ? NkAreaRangeWindow(i, vWorldPos)
                                      : NkLightAtt(i, vWorldPos));

        // Base : diffus teinte, assombri quand le materiau est metallise.
        float lamb = (areaE >= 0.0) ? areaE : NdotL * 0.31830989;
        total += base * lamb * rad * (1.0 - uMat.metallic * 0.75);

        // Vernis : lobe Blinn-Phong etroit, blanc (une laque ne teinte pas
        // son reflet).
        // Devant une surfacique, `rad` ne porte plus l'inverse carre (il vit
        // dans le facteur de forme) : le speculaire doit s'en nourrir aussi,
        // sinon la laque part en surexposition.
        float eSp = (areaE >= 0.0) ? areaE * 3.14159265 : 1.0;
        vec3  H  = normalize(L + V);
        float cc = pow(max(dot(N, H), 0.0), ccPow);
        total += rad * eSp * cc * ccAmt * 0.6;

        // Les paillettes accrochent la lumiere directe.
        total += rad * eSp * flake * flkAmt * 2.5;
    }

    // Reflet d'environnement : la base metallisee le teinte, le vernis non.
    vec3 R      = reflect(-V, N);
    vec3 envRef = textureLod(tEnvPrefilter, R, uMat.roughness * 4.0).rgb * uCam.iblStrength;
    float Fcc   = 0.04 + 0.96 * pow(1.0 - NdotV, 5.0);
    vec3 tintRf = mix(vec3(1.0), base, uMat.metallic);
    total += envRef * tintRf * (0.25 + 0.75 * uMat.metallic) + envRef * Fcc * ccAmt * 0.5;

    vec3 amb = textureLod(tEnvIrradiance, N, 0.0).rgb * uCam.iblStrength * base * uMat.ao * 0.25;
    total += amb;
    if (uLights.count == 0) total += base * 0.2;

    fragColor = vec4(total, albSamp.a);
}

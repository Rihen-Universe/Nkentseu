// AUTEUR : TEUGUIA TADJUIDJE Rodolf Séderis — Rihen
// Resources/NKRenderer/Shaders/PathTracer/NkSL/traceur_chemins.comp.nksl (10/11/2026, rendu-realiste)
// Le traceur de chemins en nuanceur de calcul, lu par NkTraceurGPU.cpp : la meme physique que
// NkTraceurChemins.cpp (processeur), ligne pour ligne autant que le langage le permet.
@binding(set=0, binding=0) buffer Scene { vec4 d[]; } S;
@binding(set=0, binding=1) buffer Cartes { uint t[]; } T;
@binding(set=0, binding=2) buffer Sortie { vec4 o[]; } O;
@binding(set=0, binding=3) uniform Params {
    vec4 oeil;
    vec4 fw;
    vec4 rt;
    vec4 up;
    vec4 p0;
    vec4 p1;
    vec4 sol;
    vec4 solE;
    vec4 zen;
    vec4 hor;
    vec4 drap;
    vec4 off0;
    vec4 off1;
    vec4 cartes[16]; // (10/11) 16 classes : + tissu, velours, placage ; cartes[12].w = la regularisation
} P;
layout(local_size_x = 8, local_size_y = 8) in;

uint gEtat;
// (10/11) le lustre des fibres de la surface courante (Surf l'ecrit, EvalBsdf le lit) : m2.z, m2.w
float gLustre;
float gLustreRug;
// (10/11) le vernis (clearcoat, normale lisse ns) et la normale de la BASE (paillettes) de la surface
// courante : P.cartes[13].w = decalage d'un vec4 par matiere (vernis, rugosite, paillettes, taille) ;
// 0 (executables d'avant) : ni vernis ni paillettes, la base seule comme avant
float gVernis;
float gVernisRug;
vec3 gNb;
// (11/11/2026, nkcraft-arbres) la feuille mince de la surface courante : la part transmise en diffus par
// l'autre face (Surf l'ecrit ; 0 : opaque, rien ne change)
float gTrans;
uint Pcg() {
    gEtat = gEtat * 747796405u + 2891336453u;
    uint w = ((gEtat >> ((gEtat >> 28u) + 4u)) ^ gEtat) * 277803737u;
    return (w >> 22u) ^ w;
}
float Rnd() {
    return float(Pcg() >> 8u) * (1.0 / 16777216.0);
}
float LumC(vec3 c) {
    return 0.2126 * c.x + 0.7152 * c.y + 0.0722 * c.z;
}
void BaseDe(vec3 n, out vec3 t, out vec3 b) {
    vec3 a = abs(n.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    t = normalize(cross(a, n));
    b = cross(n, t);
}
vec3 Inverse(vec3 d) {
    return vec3(1.0 / (abs(d.x) > 1e-12 ? d.x : 1e-12), 1.0 / (abs(d.y) > 1e-12 ? d.y : 1e-12),
                1.0 / (abs(d.z) > 1e-12 ? d.z : 1e-12));
}
bool Boite(int ni, vec3 o, vec3 inv, float tmax) {
    int base = floatBitsToInt(P.off0.x) + 2 * ni;
    vec3 t0 = (S.d[base].xyz - o) * inv;
    vec3 t1 = (S.d[base + 1].xyz - o) * inv;
    vec3 a = min(t0, t1);
    vec3 b = max(t0, t1);
    float tn = max(max(a.x, a.y), a.z);
    float tf = min(min(b.x, b.y), b.z);
    return tf >= max(tn, 0.0) && tn < tmax;
}
bool MT(int k, vec3 o, vec3 d, float tmax, out float t, out float u, out float v) {
    vec3 v0 = S.d[k].xyz;
    vec3 e1 = S.d[k + 1].xyz;
    vec3 e2 = S.d[k + 2].xyz;
    t = 0.0;
    u = 0.0;
    v = 0.0;
    vec3 pv = cross(d, e2);
    float det = dot(e1, pv);
    if (abs(det) < 1e-14) return false;
    float id = 1.0 / det;
    vec3 sv = o - v0;
    u = dot(sv, pv) * id;
    if (u < 0.0 || u > 1.0) return false;
    vec3 q = cross(sv, e1);
    v = dot(d, q) * id;
    if (v < 0.0 || u + v > 1.0) return false;
    t = dot(e2, q) * id;
    return t > 1e-4 && t < tmax;
}
// (11/11/2026, nkcraft-arbres) LES CARTES D'OBJET (P.cartes[15].w = decalage de la table, 0 : aucune ;
// NkTcEmpaqueter) : le texel RGBA8 de la carte `carte` au triangle de bloc `k`, barycentriques (b1, b2), UV
// du maillage repetees, v = 0 en HAUT de l'image -- le meme calcul que TexelObjet de NkTraceurChemins.cpp
uint TexelObjet(int k, int carte, float b1, float b2) {
    int X = floatBitsToInt(P.cartes[15].w);
    int bs = floatBitsToInt(P.off0.z);
    int i0 = floatBitsToInt(S.d[k + 1].w);
    int i1 = floatBitsToInt(S.d[k + 2].w);
    int i2 = floatBitsToInt(S.d[k + 3].x);
    float w0 = 1.0 - b1 - b2;
    vec4 de = S.d[floatBitsToInt(S.d[X].z) + carte];
    // (13/11) une PHOTO (de.w > 0, metres par repetition) : les UV divisees -- comme TexelCarte du processeur
    float ie = de.w > 0.0 ? 1.0 / de.w : 1.0;
    float u = (S.d[bs + 2 * i0].w * w0 + S.d[bs + 2 * i1].w * b1 + S.d[bs + 2 * i2].w * b2) * ie;
    float v = (S.d[bs + 2 * i0 + 1].x * w0 + S.d[bs + 2 * i1 + 1].x * b1 + S.d[bs + 2 * i2 + 1].x * b2) * ie;
    float fu = u - float(int(u));
    float fv = v - float(int(v));
    if (fu < 0.0) fu = fu + 1.0;
    if (fv < 0.0) fv = fv + 1.0;
    int w = int(de.y);
    int h = int(de.z);
    int x = clamp(int(fu * float(w)), 0, w - 1);
    int y = clamp(int(fv * float(h)), 0, h - 1);
    return T.t[floatBitsToInt(de.x) + y * w + x];
}
// le masque : faux si l'impact tombe sur un texel plus transparent que le seuil (feuille detouree)
bool AlphaPasse(int k, float b1, float b2) {
    int X = floatBitsToInt(P.cartes[15].w);
    if (X <= 0) return true;
    vec4 e = S.d[X + 1 + int(S.d[k].w)];
    if (e.x < 0.0 || e.y <= 0.0) return true;
    uint px = TexelObjet(k, int(e.x), b1, b2);
    return float(px >> 24u) >= e.y * 255.0;
}
bool Tracer(vec3 o, vec3 d, float tmax, out float th, out int tri, out float b1, out float b2) {
    vec3 inv = Inverse(d);
    int pile[64];
    int np = 0;
    pile[0] = 0;
    np = 1;
    th = tmax;
    tri = -1;
    b1 = 0.0;
    b2 = 0.0;
    int bt = floatBitsToInt(P.off0.y);
    while (np > 0) {
        np = np - 1;
        int ni = pile[np];
        if (!Boite(ni, o, inv, th)) continue;
        int base = floatBitsToInt(P.off0.x) + 2 * ni;
        int g = floatBitsToInt(S.d[base].w);
        int nb = int(S.d[base + 1].w);
        if (nb > 0) {
            for (int i = 0; i < nb; ++i) {
                float t;
                float u;
                float v;
                if (MT(bt + 4 * (g + i), o, d, th, t, u, v)) {
                    if (!AlphaPasse(bt + 4 * (g + i), u, v)) continue;
                    th = t;
                    tri = g + i;
                    b1 = u;
                    b2 = v;
                }
            }
        } else if (np < 62) {
            pile[np] = g + 1;
            pile[np + 1] = g;
            np = np + 2;
        }
    }
    return tri >= 0;
}
vec3 TransmissionSurfaces(vec3 o, vec3 d, float tmax) {
    vec3 tr = vec3(1.0, 1.0, 1.0);
    vec3 inv = Inverse(d);
    int pile[64];
    int np = 1;
    pile[0] = 0;
    int bt = floatBitsToInt(P.off0.y);
    int bm = floatBitsToInt(P.off0.w);
    while (np > 0) {
        np = np - 1;
        int ni = pile[np];
        if (!Boite(ni, o, inv, tmax)) continue;
        int base = floatBitsToInt(P.off0.x) + 2 * ni;
        int g = floatBitsToInt(S.d[base].w);
        int nb = int(S.d[base + 1].w);
        if (nb > 0) {
            for (int i = 0; i < nb; ++i) {
                int k = bt + 4 * (g + i);
                float t;
                float u;
                float v;
                if (!MT(k, o, d, tmax, t, u, v)) continue;
                if (!AlphaPasse(k, u, v)) continue;
                int mat = int(S.d[k].w);
                vec4 m1 = S.d[bm + 4 * mat + 1];
                if (m1.y > 0.5) {
                    tr = tr * S.d[bm + 4 * mat].xyz * 0.96;
                    if (LumC(tr) < 1e-3) return vec3(0.0, 0.0, 0.0);
                } else {
                    return vec3(0.0, 0.0, 0.0);
                }
            }
        } else if (np < 62) {
            pile[np] = g;
            pile[np + 1] = g + 1;
            np = np + 2;
        }
    }
    return tr;
}
// (13/11) LE MILIEU PARTICIPANT (cartes[5].w = decalage au bit pres de trois vec4 : (extinction, albedo, phase g, -),
// (boite min, -), (boite max, -) ; 0 : aucun) -- comme Milieu, IntervalleMilieu, TrMilieu de NkTraceurChemins.cpp
bool IntervalleMilieu(vec3 o, vec3 d, float tmax, int offM, out float t0, out float t1) {
    vec3 mn = S.d[offM + 1].xyz;
    vec3 mx = S.d[offM + 2].xyz;
    vec3 iv = vec3(1.0 / (abs(d.x) > 1e-12 ? d.x : 1e-12), 1.0 / (abs(d.y) > 1e-12 ? d.y : 1e-12), 1.0 / (abs(d.z) > 1e-12 ? d.z : 1e-12));
    vec3 a = (mn - o) * iv;
    vec3 b = (mx - o) * iv;
    vec3 lo = min(a, b);
    vec3 hi = max(a, b);
    t0 = max(max(lo.x, max(lo.y, lo.z)), 0.0);
    t1 = min(min(hi.x, min(hi.y, hi.z)), tmax);
    return t1 > t0;
}
float TrMilieu(vec3 o, vec3 d, float tmax) {
    int offM = floatBitsToInt(P.cartes[5].w);
    if (offM <= 0) return 1.0;
    float t0;
    float t1;
    if (!IntervalleMilieu(o, d, tmax, offM, t0, t1)) return 1.0;
    return exp(-S.d[offM].x * (t1 - t0));
}
float PhaseHG(float c, float g) {
    float den = 1.0 + g * g - 2.0 * g * c;
    return (1.0 - g * g) / (12.5663706 * den * sqrt(max(den, 1e-6)));
}
// la transmission d'un rayon d'ombre : les surfaces x le milieu
vec3 Transmission(vec3 o, vec3 d, float tmax) {
    vec3 ts = TransmissionSurfaces(o, d, tmax);
    if (ts.x <= 0.0 && ts.y <= 0.0 && ts.z <= 0.0) return ts;
    return ts * TrMilieu(o, d, tmax);
}
float Lin(uint c) {
    float x = float(c) / 255.0;
    return x <= 0.04045 ? x / 12.92 : pow((x + 0.055) / 1.055, 2.4);
}
// (10/11) LES PAILLETTES : une cellule cubique de cote `taille` = une paillette, de normale tiree autour
// de n (amplitude 0,6 x quantite par axe) ; le meme hachage entier que NkTraceurChemins.cpp
vec3 NormalePaillette(vec3 p, vec3 n, float q, float taille) {
    ivec3 c = ivec3(floor(p * (1.0 / taille)));
    uint e = (uint(c.x) * 73856093u) ^ (uint(c.y) * 19349663u) ^ (uint(c.z) * 83492791u);
    e = e * 747796405u + 2891336453u;
    uint w1 = ((e >> ((e >> 28u) + 4u)) ^ e) * 277803737u;
    w1 = (w1 >> 22u) ^ w1;
    e = e * 747796405u + 2891336453u;
    uint w2 = ((e >> ((e >> 28u) + 4u)) ^ e) * 277803737u;
    w2 = (w2 >> 22u) ^ w2;
    e = e * 747796405u + 2891336453u;
    uint w3 = ((e >> ((e >> 28u) + 4u)) ^ e) * 277803737u;
    w3 = (w3 >> 22u) ^ w3;
    vec3 r = vec3(float(w1 >> 8u), float(w2 >> 8u), float(w3 >> 8u)) * (2.0 / 16777216.0) - vec3(1.0, 1.0, 1.0);
    vec3 t = normalize(n + r * (0.6 * q));
    return dot(t, n) > 0.1 ? t : n;
}
// Surface au point d'impact : p, ng, ns, albedo, emission, rugosite, metal, verre
void Surf(int tri, float b1, float b2, vec3 o, vec3 d, float th, out vec3 p, out vec3 ng, out vec3 ns, out vec3 alb,
          out vec3 emis, out float rug, out float met, out bool verre) {
    int k = floatBitsToInt(P.off0.y) + 4 * tri;
    int i0 = floatBitsToInt(S.d[k + 1].w);
    int i1 = floatBitsToInt(S.d[k + 2].w);
    int i2 = floatBitsToInt(S.d[k + 3].x);
    int bs = floatBitsToInt(P.off0.z);
    float w0 = 1.0 - b1 - b2;
    p = o + d * th;
    vec4 a0 = S.d[bs + 2 * i0];
    vec4 a1 = S.d[bs + 2 * i1];
    vec4 a2 = S.d[bs + 2 * i2];
    ns = normalize(a0.xyz * w0 + a1.xyz * b1 + a2.xyz * b2);
    ng = normalize(cross(S.d[k + 1].xyz, S.d[k + 2].xyz));
    if (dot(ng, ns) < 0.0) ng = -ng;
    int mat = int(S.d[k].w);
    int bm = floatBitsToInt(P.off0.w) + 4 * mat;
    vec4 m0 = S.d[bm];
    vec4 m1 = S.d[bm + 1];
    vec4 m2 = S.d[bm + 2];
    vec4 m3 = S.d[bm + 3];
    verre = m1.y > 0.5;
    gLustre = m2.z;
    gLustreRug = m2.w;
    rug = max(m0.w, 0.03);
    met = m1.x;
    alb = m0.xyz;
    emis = alb * m1.z;
    int cl = int(m1.w);
    if (P.drap.w < 0.5 && cl >= 0) {
        float u = (a0.w * w0 + a1.w * b1 + a2.w * b2) / m2.x;
        float v = (S.d[bs + 2 * i0 + 1].x * w0 + S.d[bs + 2 * i1 + 1].x * b1 + S.d[bs + 2 * i2 + 1].x * b2) / m2.x;
        float fu = u - float(int(u));
        float fv = v - float(int(v));
        if (fu < 0.0) fu = fu + 1.0;
        if (fv < 0.0) fv = fv + 1.0;
        vec4 ci = P.cartes[cl];
        int w = int(ci.y);
        int h = int(ci.z);
        int x = clamp(int(fu * float(w)), 0, w - 1);
        int y = clamp(int((1.0 - fv) * float(h)), 0, h - 1);
        uint px = T.t[int(ci.x) + y * w + x];
        vec3 tx = vec3(Lin(px & 255u), Lin((px >> 8u) & 255u), Lin((px >> 16u) & 255u));
        if (m2.y > 0.5) {
            float kk = LumC(alb) / max(0.02, LumC(m3.xyz));
            alb = min(vec3(0.98, 0.98, 0.98), tx * kk);
        } else {
            alb = min(vec3(0.98, 0.98, 0.98), alb * tx / m3.xyz);
        }
    }
    // (11/11/2026) la carte de l'objet : texel x couleur (comme le temps reel) ; la feuille mince
    gTrans = 0.0;
    int X = floatBitsToInt(P.cartes[15].w);
    if (X > 0) {
        vec4 e = S.d[X + 1 + mat];
        if (!verre) gTrans = e.z;
        if (P.drap.w < 0.5 && e.x >= 0.0) {
            uint pxo = TexelObjet(k, int(e.x), b1, b2);
            vec3 to = vec3(Lin(pxo & 255u), Lin((pxo >> 8u) & 255u), Lin((pxo >> 16u) & 255u));
            alb = min(vec3(0.98, 0.98, 0.98), alb * to);
            // (13/11) une PHOTO CC0 (descripteur .w > 0) : l'alpha est la rugosite (orm.g) x celle de la matiere
            if (S.d[floatBitsToInt(S.d[X].z) + int(e.x)].w > 0.0) rug = max(m0.w * float(pxo >> 24u) / 255.0, 0.03);
        }
        // (13/11) LA NORMALE D'UNE PHOTO (e.w = carte + 1) : T = derivee des UV du triangle, B = cross(N, T) comme
        // le temps reel ; le vert de la carte cuite suit B -- le meme calcul que Surf de NkTraceurChemins.cpp
        if (P.drap.w < 0.5 && e.w > 0.5) {
            uint pn = TexelObjet(k, int(e.w) - 1, b1, b2);
            vec3 tn = vec3(float(pn & 255u), float((pn >> 8u) & 255u), float((pn >> 16u) & 255u)) / 127.5 - vec3(1.0, 1.0, 1.0);
            float du1 = a1.w - a0.w;
            float du2 = a2.w - a0.w;
            float dv1 = S.d[bs + 2 * i1 + 1].x - S.d[bs + 2 * i0 + 1].x;
            float dv2 = S.d[bs + 2 * i2 + 1].x - S.d[bs + 2 * i0 + 1].x;
            float det = du1 * dv2 - du2 * dv1;
            if (abs(det) > 1e-12) {
                vec3 tg = (S.d[k + 1].xyz * dv2 - S.d[k + 2].xyz * dv1) / det;
                tg = tg - ns * dot(ns, tg);
                if (dot(tg, tg) > 1e-12) {
                    tg = normalize(tg);
                    vec3 bt = cross(ns, tg);
                    ns = normalize(tg * tn.x + bt * tn.y + ns * tn.z);
                }
            }
        }
    }
    if (!verre && dot(ng, d) > 0.0) {
        ng = -ng;
        ns = -ns;
    }
    if (!verre && dot(ns, d) > 0.0) ns = ns - ng * (2.0 * dot(ns, ng));
    ns = normalize(ns);
    gNb = ns;
    gVernis = 0.0;
    gVernisRug = 0.03;
    if (floatBitsToInt(P.cartes[13].w) > 0 && !verre) { // (13/11) le decalage au bit pres
        vec4 vv = S.d[floatBitsToInt(P.cartes[13].w) + mat];
        gVernis = vv.x;
        gVernisRug = max(vv.y, 0.03);
        if (vv.z > 0.0) gNb = NormalePaillette(p, ns, vv.z, vv.w);
    }
    // (10/11) LE MODE ARGILE (P.cartes[14].w = 1) : blanc mat 0,8, rugosite 0,6 ; le verre reste, l'emission
    // (calculee plus haut de la couleur de la matiere) reste -- comme NkTraceurChemins.cpp
    if (P.cartes[14].w > 0.5 && !verre) {
        alb = vec3(0.8, 0.8, 0.8);
        rug = 0.6;
        met = 0.0;
        gLustre = 0.0;
        gVernis = 0.0;
        gNb = ns;
        gTrans = 0.0;
    }
}
float DGgx(float nh, float a2) {
    float d = nh * nh * (a2 - 1.0) + 1.0;
    return a2 / (3.14159265 * d * d + 1e-12);
}
float G1(float nx, float a2) {
    return 2.0 * nx / (nx + sqrt(a2 + (1.0 - a2) * nx * nx) + 1e-12);
}
vec3 Schlick(vec3 f0, float c) {
    float k = 1.0 - c;
    float k5 = k * k * k * k * k;
    return f0 + (vec3(1.0, 1.0, 1.0) - f0) * k5;
}
// la BASE autour de la normale donnee (ns, ou celle de la paillette gNb)
vec3 EvalBase(vec3 ng, vec3 ns, vec3 alb, float rug, float met, vec3 wo, vec3 wi) {
    float nl = dot(ns, wi);
    float nv = dot(ns, wo);
    if (nl <= 0.0 || nv <= 0.0 || dot(ng, wi) <= 0.0) return vec3(0.0, 0.0, 0.0);
    vec3 f0 = vec3(0.04, 0.04, 0.04) * (1.0 - met) + alb * met;
    vec3 h = normalize(wo + wi);
    float r2 = rug * rug;
    float a2 = r2 * r2;
    vec3 F = Schlick(f0, max(0.0, dot(wo, h)));
    float spec = DGgx(max(0.0, dot(ns, h)), a2) * G1(nl, a2) * G1(nv, a2) / (4.0 * nl * nv + 1e-8);
    float invPi = 1.0 / 3.14159265;
    vec3 kd = alb * (vec3(1.0, 1.0, 1.0) - F) * ((1.0 - met) * invPi);
    // (10/11) le lustre des fibres : Charlie + Neubelt, comme NkTraceurChemins.cpp et pbr.frag.nksl
    vec3 lus = vec3(0.0, 0.0, 0.0);
    if (gLustre > 0.0) {
        float nhs = max(0.0, dot(ns, h));
        float al = max(gLustreRug, 0.07);
        float inv = 1.0 / al;
        float sin2 = max(0.0, 1.0 - nhs * nhs);
        float Dc = (2.0 + inv) * pow(max(sin2, 1e-8), 0.5 * inv) / 6.28318531;
        float Vn = 1.0 / (4.0 * (nl + nv - nl * nv) + 1e-6);
        lus = (alb * 0.5 + vec3(0.5, 0.5, 0.5)) * (gLustre * Dc * Vn);
    }
    return (kd + F * spec + lus) * nl;
}
// (10/11) la base (normale de paillette), puis le vernis (normale lisse) : la base x (1 - albedo du
// vernis vu), comme NkTraceurChemins.cpp et le Principled de Cycles
vec3 EvalBsdf(vec3 ng, vec3 ns, vec3 alb, float rug, float met, vec3 wo, vec3 wi) {
    // (11/11) la feuille mince : de l'autre cote, un Lambert x translucide (sans translucide : rien ne change)
    if (gTrans > 0.0 && dot(ng, wi) < 0.0) return alb * (gTrans * max(0.0, -dot(ns, wi)) / 3.14159265);
    if (gVernis <= 0.0) return EvalBase(ng, gNb, alb, rug, met, wo, wi);
    float nl = dot(ns, wi);
    float nv = dot(ns, wo);
    if (nl <= 0.0 || nv <= 0.0 || dot(ng, wi) <= 0.0) return vec3(0.0, 0.0, 0.0);
    vec3 base = EvalBase(ng, gNb, alb, rug, met, wo, wi);
    vec3 h = normalize(wo + wi);
    float r2 = gVernisRug * gVernisRug;
    float a2 = r2 * r2;
    float kh = 1.0 - max(0.0, dot(wo, h));
    float Fc = 0.04 + 0.96 * kh * kh * kh * kh * kh;
    float sc = DGgx(max(0.0, dot(ns, h)), a2) * G1(nl, a2) * G1(nv, a2) / (4.0 * nl * nv + 1e-8);
    float kv = 1.0 - clamp(nv, 0.0, 1.0);
    float att = 1.0 - gVernis * (0.04 + 0.96 * kv * kv * kv * kv * kv);
    float c = gVernis * Fc * sc * nl;
    return base * att + vec3(c, c, c);
}
float ProbaSpec(float rug, float met) {
    return met > 0.5 ? 1.0 : (rug < 0.3 ? 0.4 : 0.15);
}
float ProbaVernis() {
    return gVernis > 0.0 ? min(0.5, 0.2 + 0.3 * gVernis) : 0.0;
}
float PdfBase(vec3 ns, float rug, float met, vec3 wo, vec3 wi) {
    float nl = dot(ns, wi);
    if (nl <= 0.0) return 0.0;
    vec3 h = normalize(wo + wi);
    float r2 = rug * rug;
    float a2 = r2 * r2;
    float nh = max(0.0, dot(ns, h));
    float ps = ProbaSpec(rug, met);
    float pSpec = DGgx(nh, a2) * nh / (4.0 * max(1e-6, dot(wo, h)));
    return ps * pSpec + (1.0 - ps) * nl / 3.14159265;
}
float PdfReflet(vec3 ns, float rug, float met, vec3 wo, vec3 wi) {
    float pb = PdfBase(gNb, rug, met, wo, wi);
    if (gVernis <= 0.0) return pb;
    float pc = 0.0;
    if (dot(ns, wi) > 0.0) {
        vec3 h = normalize(wo + wi);
        float r2 = gVernisRug * gVernisRug;
        float a2 = r2 * r2;
        float nh = max(0.0, dot(ns, h));
        pc = DGgx(nh, a2) * nh / (4.0 * max(1e-6, dot(wo, h)));
    }
    float pv = ProbaVernis();
    return (1.0 - pv) * pb + pv * pc;
}
// (11/11/2026) la feuille mince : une part pT = t / (1 + t) des tirages au lobe transmis (autre face)
float PdfBsdf(vec3 ng, vec3 ns, float rug, float met, vec3 wo, vec3 wi) {
    if (gTrans <= 0.0) return PdfReflet(ns, rug, met, wo, wi);
    float pT = gTrans / (1.0 + gTrans);
    if (dot(ng, wi) < 0.0) return pT * max(0.0, -dot(ns, wi)) / 3.14159265;
    return (1.0 - pT) * PdfReflet(ns, rug, met, wo, wi);
}
vec3 TirerBase(vec3 ns, float rug, float met, vec3 wo) {
    vec3 t;
    vec3 b;
    BaseDe(ns, t, b);
    float u1 = Rnd();
    float u2 = Rnd();
    if (Rnd() < ProbaSpec(rug, met)) {
        float r2 = rug * rug;
        float a2 = r2 * r2;
        float ct = sqrt(max(0.0, (1.0 - u1) / (1.0 + (a2 - 1.0) * u1)));
        float st = sqrt(max(0.0, 1.0 - ct * ct));
        float ph = 6.28318531 * u2;
        vec3 h = t * (st * cos(ph)) + b * (st * sin(ph)) + ns * ct;
        return h * (2.0 * dot(wo, h)) - wo;
    }
    float rr = sqrt(u1);
    float ph = 6.28318531 * u2;
    return normalize(t * (rr * cos(ph)) + b * (rr * sin(ph)) + ns * sqrt(max(0.0, 1.0 - u1)));
}
vec3 TirerBsdf(vec3 ns, float rug, float met, vec3 wo) {
    // (11/11) la feuille mince : un Lambert de l'autre cote ; sans translucide, AUCUN tirage de plus
    if (gTrans > 0.0) {
        if (Rnd() < gTrans / (1.0 + gTrans)) {
            vec3 nd = -ns;
            vec3 tt;
            vec3 bb;
            BaseDe(nd, tt, bb);
            float u1 = Rnd();
            float u2 = Rnd();
            float rr = sqrt(u1);
            float ph = 6.28318531 * u2;
            return normalize(tt * (rr * cos(ph)) + bb * (rr * sin(ph)) + nd * sqrt(max(0.0, 1.0 - u1)));
        }
    }
    // sans vernis : aucun tirage de plus (les rendus d'avant restent identiques)
    if (gVernis > 0.0) {
        if (Rnd() < ProbaVernis()) {
            vec3 t;
            vec3 b;
            BaseDe(ns, t, b);
            float u1 = Rnd();
            float u2 = Rnd();
            float r2 = gVernisRug * gVernisRug;
            float a2 = r2 * r2;
            float ct = sqrt(max(0.0, (1.0 - u1) / (1.0 + (a2 - 1.0) * u1)));
            float st = sqrt(max(0.0, 1.0 - ct * ct));
            float ph = 6.28318531 * u2;
            vec3 h = t * (st * cos(ph)) + b * (st * sin(ph)) + ns * ct;
            return h * (2.0 * dot(wo, h)) - wo;
        }
    }
    return TirerBase(gNb, rug, met, wo);
}
// (10/11/2026) le ciel en table (NkHosekCielTable) : off1.w = decalage dans la scene (0 : degrade),
// hor.w = largeur, solE.w = hauteur ; bilineaire, periodique en phi (meme lecture que le processeur)
vec3 CielTexel(float x, float y) {
    float W = P.hor.w;
    float H = P.solE.w;
    float xx = x - W * floor(x / W);
    float yy = clamp(y, 0.0, H - 1.0);
    return S.d[floatBitsToInt(P.off1.w) + int(yy) * int(W) + int(xx)].xyz;
}
vec3 Ciel(vec3 d) {
    if (floatBitsToInt(P.off1.w) > 0) { // (13/11) au bit pres
        float th = acos(clamp(d.y, -1.0, 1.0));
        // atan2(0, 0) est indefini sur la carte (NaN) : un rayon exactement vertical l'atteint
        float ph = (abs(d.x) + abs(d.z) > 1e-7) ? atan(d.z, d.x) : 0.0;
        if (ph < 0.0) ph = ph + 6.28318531;
        float fx = ph / 6.28318531 * P.hor.w - 0.5;
        float fy = th / 3.14159265 * P.solE.w - 0.5;
        float x0 = floor(fx);
        float y0 = floor(fy);
        float tx = fx - x0;
        float ty = fy - y0;
        vec3 a = mix(CielTexel(x0, y0), CielTexel(x0 + 1.0, y0), tx);
        vec3 b = mix(CielTexel(x0, y0 + 1.0), CielTexel(x0 + 1.0, y0 + 1.0), tx);
        return mix(a, b, ty) * P.zen.w;
    }
    if (d.y < 0.0) return P.hor.xyz * P.zen.w;
    float k = sqrt(d.y);
    return (P.hor.xyz * (1.0 - k) + P.zen.xyz * k) * P.zen.w;
}
float FacteurSpot(vec4 s1, vec3 wi) {
    float ca = -dot(wi, s1.xyz);
    return max(0.0, min(1.0, (ca - s1.w) / max(1e-3, (1.0 - s1.w) * 0.15)));
}
vec3 Directe(vec3 p, vec3 ng, vec3 ns, vec3 alb, float rug, float met, vec3 wo) {
    vec3 L = vec3(0.0, 0.0, 0.0);
    vec3 o = p + ng * 2e-3;
    // (11/11) la feuille mince recoit aussi la lumiere par son autre face : le rayon d'ombre part de ce cote-la
    vec3 oDos = p - ng * 2e-3;
    bool mince = gTrans > 0.0;
    if (P.drap.x < 0.5 && LumC(P.solE.xyz) > 0.0 && (dot(ng, P.sol.xyz) > 0.0 || mince)) {
        vec3 t;
        vec3 b;
        BaseDe(P.sol.xyz, t, b);
        float ct = 1.0 - Rnd() * (1.0 - P.sol.w);
        float st = sqrt(max(0.0, 1.0 - ct * ct));
        float ph = 6.28318531 * Rnd();
        vec3 wi = normalize(t * (st * cos(ph)) + b * (st * sin(ph)) + P.sol.xyz * ct);
        vec3 f = EvalBsdf(ng, ns, alb, rug, met, wo, wi);
        if (LumC(f) > 0.0) L = L + f * P.solE.xyz * (P.p1.z > 0.5 ? vec3(1.0, 1.0, 1.0) : Transmission((mince && dot(ng, wi) < 0.0) ? oDos : o, wi, 1e6));
    }
    int ns2 = int(P.off1.y);
    float ptot = P.off1.z;
    if (P.drap.z < 0.5 && ns2 > 0 && ptot > 0.0) {
        int bsrc = floatBitsToInt(P.off1.x);
        // (13/11) le nombre de candidates (cartes[6].w ; 0 : 8, l'image d'avant ; 32 au plus) -- comme Directe du processeur
        int M = P.cartes[6].w > 0.5 ? min(int(P.cartes[6].w), 32) : 8;
        int cand[32];
        float w[32];
        float somme = 0.0;
        for (int k = 0; k < M; ++k) {
            float u = Rnd() * ptot;
            int lo = 0;
            int hi = ns2 - 1;
            while (lo < hi) {
                int mi = (lo + hi) / 2;
                if (S.d[bsrc + 4 * mi + 3].z < u) lo = mi + 1; else hi = mi;
            }
            cand[k] = lo;
            vec4 s0 = S.d[bsrc + 4 * lo];
            vec4 s2 = S.d[bsrc + 4 * lo + 2];
            vec4 s3 = S.d[bsrc + 4 * lo + 3];
            vec3 dv = s0.xyz - p;
            float d2 = max(dot(dv, dv), s3.x * s3.x + 1e-4);
            vec3 wi = dv / sqrt(d2);
            float ph = s2.w * (mince ? abs(dot(ns, wi)) : max(0.0, dot(ns, wi))) / d2;
            if (s0.w > 0.5) ph = ph * FacteurSpot(S.d[bsrc + 4 * lo + 1], wi);
            float pr = s3.y / ptot;
            w[k] = pr > 0.0 ? ph / pr : 0.0;
            somme = somme + w[k];
        }
        if (somme > 0.0) {
            float u = Rnd() * somme;
            int k = 0;
            while (k < M - 1 && u >= w[k]) {
                u = u - w[k];
                k = k + 1;
            }
            int q = cand[k];
            vec4 s0 = S.d[bsrc + 4 * q];
            vec4 s1 = S.d[bsrc + 4 * q + 1];
            vec4 s2 = S.d[bsrc + 4 * q + 2];
            vec4 s3 = S.d[bsrc + 4 * q + 3];
            float z = 1.0 - 2.0 * Rnd();
            float ph2 = 6.28318531 * Rnd();
            float rz = sqrt(max(0.0, 1.0 - z * z));
            vec3 pl = s0.xyz + vec3(rz * cos(ph2), z, rz * sin(ph2)) * s3.x;
            vec3 dv = pl - p;
            float d2 = max(dot(dv, dv), 1e-4);
            float dl = sqrt(d2);
            vec3 wi = dv / dl;
            float I = s2.w;
            if (s0.w > 0.5) I = I * FacteurSpot(s1, wi);
            vec3 f = EvalBsdf(ng, ns, alb, rug, met, wo, wi);
            if (I > 0.0 && LumC(f) > 0.0) {
                vec3 tr = P.p1.z > 0.5 ? vec3(1.0, 1.0, 1.0) : Transmission((mince && dot(ng, wi) < 0.0) ? oDos : o, wi, dl - 2e-3);
                vec3 cen = s0.xyz - p;
                float dc2 = max(dot(cen, cen), s3.x * s3.x + 1e-4);
                vec3 cw = cen / sqrt(dc2);
                float phy = s2.w * (mince ? abs(dot(ns, cw)) : max(0.0, dot(ns, cw))) / dc2;
                if (s0.w > 0.5) phy = phy * FacteurSpot(s1, cw);
                if (phy > 0.0) {
                    float W = (somme / float(M)) / phy;
                    L = L + f * s2.xyz * (I / d2) * tr * W;
                }
            }
        }
    }
    return L;
}
// (13/11) la lumiere directe en un point du milieu : le soleil et une source tiree selon la puissance -- comme
// DirecteMilieu de NkTraceurChemins.cpp
vec3 DirecteMilieu(vec3 p, vec3 d, float g) {
    vec3 L = vec3(0.0, 0.0, 0.0);
    if (P.drap.x < 0.5 && LumC(P.solE.xyz) > 0.0) {
        vec3 tr = Transmission(p, P.sol.xyz, 1e6);
        L = L + P.solE.xyz * tr * PhaseHG(dot(d, P.sol.xyz), g);
    }
    int ns2 = int(P.off1.y);
    float ptot = P.off1.z;
    if (P.drap.z < 0.5 && ns2 > 0 && ptot > 0.0) {
        int bsrc = floatBitsToInt(P.off1.x);
        float u = Rnd() * ptot;
        int lo = 0;
        int hi = ns2 - 1;
        while (lo < hi) {
            int mi = (lo + hi) / 2;
            if (S.d[bsrc + 4 * mi + 3].z < u) lo = mi + 1; else hi = mi;
        }
        vec4 s0 = S.d[bsrc + 4 * lo];
        vec4 s1 = S.d[bsrc + 4 * lo + 1];
        vec4 s2 = S.d[bsrc + 4 * lo + 2];
        vec4 s3 = S.d[bsrc + 4 * lo + 3];
        float pr = s3.y / ptot;
        vec3 dv = s0.xyz - p;
        float d2 = max(dot(dv, dv), s3.x * s3.x + 1e-4);
        float dl = sqrt(d2);
        vec3 wi = dv / dl;
        float I = s2.w;
        if (s0.w > 0.5) I = I * FacteurSpot(s1, wi);
        if (I > 0.0 && pr > 0.0) {
            vec3 tr = Transmission(p, wi, dl - 2e-3);
            L = L + s2.xyz * tr * (I / d2 * PhaseHG(dot(d, wi), g) / pr);
        }
    }
    return L;
}
vec3 TirerHG(vec3 d, float g) {
    float u1 = Rnd();
    float u2 = Rnd();
    float ct = 1.0 - 2.0 * u1;
    if (abs(g) >= 1e-3) {
        float s = (1.0 - g * g) / (1.0 - g + 2.0 * g * u1);
        ct = (1.0 + g * g - s * s) / (2.0 * g);
    }
    ct = clamp(ct, -1.0, 1.0);
    float st = sqrt(max(0.0, 1.0 - ct * ct));
    float ph = 6.28318531 * u2;
    vec3 a = abs(d.x) > 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 t = normalize(cross(a, d));
    vec3 b = cross(d, t);
    return normalize(t * (st * cos(ph)) + b * (st * sin(ph)) + d * ct);
}
// (13/11) `aDir` : la part DIRECTE (tout jusqu'a la lumiere directe du premier impact non speculaire compris) ; le
// reste est l'INDIRECT -- comme Chemin de NkTraceurChemins.cpp
vec3 Chemin(vec3 o, vec3 d, out vec3 aAlb, out vec3 aNrm, out float aZ, out vec3 aDir) {
    vec3 L = vec3(0.0, 0.0, 0.0);
    vec3 beta = vec3(1.0, 1.0, 1.0);
    bool spec = true;
    bool aov = false;
    bool dirPris = false;
    aDir = vec3(0.0, 0.0, 0.0);
    aAlb = vec3(1.0, 1.0, 1.0);
    aNrm = -d;
    aZ = 1e4;
    int maxR = P.p1.w > 0.5 ? 1 : int(P.p0.z);
    float coneSol = 1.0 / (6.28318531 * (1.0 - P.sol.w));
    for (int rebond = 0; rebond <= maxR; ++rebond) {
        float th;
        int tri;
        float b1;
        float b2;
        bool touche = Tracer(o, d, 1e6, th, tri, b1, b2);
        // (13/11) LE MILIEU PARTICIPANT : vol libre dans la boite ; avant la surface (ou le ciel), le chemin diffuse --
        // comme Chemin de NkTraceurChemins.cpp
        int offM = floatBitsToInt(P.cartes[5].w);
        if (offM > 0) {
            float mt0;
            float mt1;
            if (IntervalleMilieu(o, d, touche ? th : 1e30, offM, mt0, mt1)) {
                vec4 mc = S.d[offM];
                float ts = mt0 - log(max(1e-7, 1.0 - Rnd())) / mc.x;
                if (ts < mt1) {
                    vec3 pm = o + d * ts;
                    beta = beta * mc.y;
                    if (!aov) {
                        aAlb = vec3(1.0, 1.0, 1.0);
                        aNrm = -d;
                        aZ = ts;
                        aov = true;
                    }
                    if (!dirPris) {
                        aDir = L;
                        dirPris = true;
                    }
                    L = L + beta * DirecteMilieu(pm, d, mc.z);
                    if (rebond == maxR) break;
                    d = TirerHG(d, mc.z);
                    o = pm;
                    spec = false;
                    if (rebond >= 3) {
                        float qm = min(0.95, max(beta.x, max(beta.y, beta.z)));
                        if (Rnd() > qm) break;
                        beta = beta / qm;
                    }
                    continue;
                }
            }
        }
        if (!touche) {
            if (P.drap.y < 0.5) L = L + beta * Ciel(d);
            if (spec && P.drap.x < 0.5 && dot(d, P.sol.xyz) >= P.sol.w) L = L + beta * P.solE.xyz * coneSol;
            break;
        }
        vec3 p;
        vec3 ng;
        vec3 ns;
        vec3 alb;
        vec3 emis;
        float rug;
        float met;
        bool verre;
        Surf(tri, b1, b2, o, d, th, p, ng, ns, alb, emis, rug, met, verre);
        // (10/11) contre les lucioles (P.cartes[12].w = 1) : rugosite regularisee apres le premier
        // rebond, emission vue apres un rebond ecretee (comme NkTraceurChemins.cpp)
        bool regul = P.cartes[12].w > 0.5;
        if (regul && rebond > 0 && !verre) {
            rug = max(rug, 0.3);
            gVernisRug = max(gVernisRug, 0.3);
        }
        if (spec && LumC(emis) > 0.0) {
            vec3 e = beta * emis;
            if (regul && rebond > 0) {
                float le = LumC(e);
                if (le > P.p0.w) e = e * (P.p0.w / le);
            }
            L = L + e;
        }
        if (verre) {
            bool entre = dot(d, ng) < 0.0;
            vec3 n = entre ? ng : -ng;
            float eta = entre ? 1.0 / 1.5 : 1.5;
            float ci = -dot(d, n);
            float s2 = eta * eta * (1.0 - ci * ci);
            float F = 1.0;
            vec3 dt = vec3(0.0, 0.0, 0.0);
            if (s2 < 1.0) {
                float ct = sqrt(1.0 - s2);
                float rs = (eta * ci - ct) / (eta * ci + ct);
                float rp = (ci - eta * ct) / (ci + eta * ct);
                F = 0.5 * (rs * rs + rp * rp);
                dt = d * eta + n * (eta * ci - ct);
            }
            if (Rnd() < F) {
                d = d + n * (2.0 * ci);
                o = p + n * 2e-3;
            } else {
                d = normalize(dt);
                o = p - n * 2e-3;
                beta = beta * alb;
            }
            spec = true;
            continue;
        }
        if (!aov) {
            aAlb = alb;
            aNrm = ns;
            aZ = th;
            aov = true;
        }
        vec3 wo = -d;
        vec3 Ld = Directe(p, ng, ns, alb, rug, met, wo);
        if (rebond > 0) {
            float l = LumC(beta * Ld);
            if (l > P.p0.w) Ld = Ld * (P.p0.w / l);
        }
        L = L + beta * Ld;
        if (!dirPris) {
            aDir = L;
            dirPris = true;
        }
        if (rebond == maxR) break;
        vec3 wi = TirerBsdf(ns, rug, met, wo);
        float pdf = PdfBsdf(ng, ns, rug, met, wo, wi);
        if (pdf <= 1e-8) break;
        vec3 f = EvalBsdf(ng, ns, alb, rug, met, wo, wi);
        if (LumC(f) <= 0.0) break;
        beta = beta * f / pdf;
        // (10/11) seul le verre garde la vue du disque et de l'emission (la lumiere directe les compte)
        spec = regul ? false : rug < 0.08;
        if (rebond >= 3) {
            float q = min(0.95, max(beta.x, max(beta.y, beta.z)));
            if (Rnd() > q) break;
            beta = beta / q;
        }
        o = p + ng * ((gTrans > 0.0 && dot(ng, wi) < 0.0) ? -2e-3 : 2e-3); // (11/11) transmis : de l'autre cote
        d = wi;
    }
    if (!dirPris) aDir = L; // aucun impact diffus (ciel, vitres) : tout est direct
    return L;
}

@stage(compute)
@entry
void main() {
    int L = int(P.rt.w);
    int H = int(P.up.w);
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y) + int(P.p1.x);
    if (x >= L || y >= H || y >= int(P.p1.x) + int(P.p1.y)) return;
    int pix = y * L + x;
    int N = L * H;
    // (13/11) L'ECHANTILLONNAGE ADAPTATIF (cartes[9].w = seuil d'erreur relative, 0 : sans ; cartes[8].w = minimum
    // d'echantillons ; cartes[7].w = plancher de luminance) : un pixel CONVERGE ne recoit plus rien -- le meme
    // critere que PixelConverge de NkTraceurChemins.cpp ; le nombre d'echantillons du pixel est en O[3N + pix].z
    if (P.cartes[9].w > 0.0) {
        vec4 a0 = O.o[pix];
        vec4 a3 = O.o[3 * N + pix];
        float nb = a3.z;
        if (nb >= max(P.cartes[8].w, 1.0)) {
            float m = LumC(a0.xyz) / nb;
            float v = max(0.0, a3.y / nb - m * m) / nb;
            if (sqrt(v) <= P.cartes[9].w * max(m, P.cartes[7].w)) return;
        }
    }
    vec3 sL = vec3(0.0, 0.0, 0.0);
    vec3 sA = vec3(0.0, 0.0, 0.0);
    vec3 sN = vec3(0.0, 0.0, 0.0);
    vec3 sD = vec3(0.0, 0.0, 0.0);
    float sZ = 0.0;
    float sL2 = 0.0;
    float sI2 = 0.0;
    int spp = int(P.p0.x);
    for (int s = 0; s < spp; ++s) {
        gEtat = uint(pix) * 1973u + uint(P.p0.y) * 9277u + uint(s) * 26699u + 1u;
        Pcg();
        Pcg();
        float px = (float(x) + Rnd()) / float(L) * 2.0 - 1.0;
        float py = 1.0 - (float(y) + Rnd()) / float(H) * 2.0;
        vec3 d = normalize(P.fw.xyz + P.rt.xyz * (px * P.oeil.w * P.fw.w) + P.up.xyz * (py * P.oeil.w));
        vec3 o = P.oeil.xyz;
        // (13/11) LA PROFONDEUR DE CHAMP (cartes[10].w = rayon de la lentille, cartes[11].w = distance nette ; 0 :
        // le stenope d'avant, sans tirage en plus) : lentille mince, disque concentrique -- comme Passe du processeur
        float rl = P.cartes[10].w;
        if (rl > 0.0) {
            vec3 pf = o + d * (P.cartes[11].w / dot(d, P.fw.xyz));
            float ua = 2.0 * Rnd() - 1.0;
            float ub = 2.0 * Rnd() - 1.0;
            float lr = 0.0;
            float lphi = 0.0;
            if (abs(ua) > abs(ub)) {
                lr = ua;
                lphi = 0.78539816 * (ub / ua);
            } else if (ub != 0.0) {
                lr = ub;
                lphi = 1.57079633 - 0.78539816 * (ua / ub);
            }
            o = o + P.rt.xyz * (lr * cos(lphi) * rl) + P.up.xyz * (lr * sin(lphi) * rl);
            d = normalize(pf - o);
        }
        vec3 a;
        vec3 nn;
        float zz;
        vec3 dc;
        vec3 c = Chemin(o, d, a, nn, zz, dc);
        if (!(c.x == c.x && c.y == c.y && c.z == c.z) || c.x > 1e20 || c.y > 1e20 || c.z > 1e20) c = vec3(0.0, 0.0, 0.0);
        if (!(dc.x == dc.x && dc.y == dc.y && dc.z == dc.z) || dc.x > 1e20 || dc.y > 1e20 || dc.z > 1e20) dc = vec3(0.0, 0.0, 0.0);
        // (10/11) le test x == x peut etre optimise par le compilateur HLSL : max/min ecartent un NaN
        // (semantique D3D : min(NaN, x) = x), la borne reste celle du processeur
        c = min(max(c, vec3(0.0, 0.0, 0.0)), vec3(1e20, 1e20, 1e20));
        dc = min(max(dc, vec3(0.0, 0.0, 0.0)), c);
        // (13/11) LES LUCIOLES : la part INDIRECTE de l'echantillon ecretee a P.p0.w (l'ecretage du chemin : il
        // bornait deja la lumiere directe et l'emission vues apres un rebond ; le CIEL vu apres un rebond y echappait,
        // et une reference a 4096 ech. gardait des points blancs, plus nombreux qu'a 256) -- avec la regularisation
        if (P.cartes[12].w > 0.5) {
            vec3 ci = c - dc;
            float li0 = LumC(ci);
            if (li0 > P.p0.w) c = dc + ci * (P.p0.w / li0);
        }
        sL = sL + c;
        sA = sA + a;
        sN = sN + nn;
        sZ = sZ + zz;
        sD = sD + dc;
        float l = LumC(c);
        sL2 = sL2 + l * l;
        float li = l - LumC(dc);
        sI2 = sI2 + li * li;
    }
    // (13/11) la part DIRECTE dans les .w des trois premieres sections (r, g, b), le nombre d'echantillons et le
    // carre de la luminance INDIRECTE dans la quatrieme (z, w) : le debruiteur 2 filtre direct et indirect a part
    O.o[pix] = O.o[pix] + vec4(sL, sD.x);
    O.o[N + pix] = O.o[N + pix] + vec4(sA, sD.y);
    O.o[2 * N + pix] = O.o[2 * N + pix] + vec4(sN, sD.z);
    O.o[3 * N + pix] = O.o[3 * N + pix] + vec4(sZ, sL2, float(spp), sI2);
}

// motiondbg.vert.nksl — NKRenderer — sonde de lecture des vecteurs de mouvement (VS)
// AUTEUR : TEUGUIA TADJUIDJE Rodolf Séderis — Rihen
//
// Triangle plein écran par gl_VertexID, aucun attribut de sommet.
//
// ⚠️ Le bloc push_constant doit être DÉCLARÉ À L'IDENTIQUE dans le VS et le FS,
// sinon le link OpenGL sort « type mismatch between shaders for uniform
// _PushConstants ». Et si un seul des deux étages vient du cache disque, l'erreur
// SURVIT à la correction : purger <exe>/cache/shaders après toute évolution de ce
// bloc. (Piège déjà payé par pp_taa, qui porte le même avertissement.)

@location(0) out vec2 vUV;

layout(push_constant) uniform PC {
    vec4 p0; // (amplification, yFlipUV, _, _)
} pc;

@stage(vertex)
@entry
void main() {
    vec2 pos = vec2((gl_VertexID == 1) ? 3.0 : -1.0,
                    (gl_VertexID == 2) ? 3.0 : -1.0);
    gl_Position = vec4(pos, 0.0, 1.0);
    vec2 uvBase = pos * 0.5 + 0.5;
    float yFlipUV = pc.p0.y;
    vUV = (yFlipUV < 0.0) ? vec2(uvBase.x, 1.0 - uvBase.y) : uvBase;
}

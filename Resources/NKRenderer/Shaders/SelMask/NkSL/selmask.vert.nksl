// selmask.vert.nksl — NKRenderer — Passe MASQUE de sélection (silhouette).
// Rend le/les objet(s) sélectionné(s) SEULS dans une cible offscreen : le
// fragment shader écrit du blanc plein -> silhouette pleine sur fond noir.
// Ce masque alimente ensuite la passe plein-écran de détection de bord
// (seloutline.*) qui en extrait le fin liseré orange façon Blender.
//
// Transform : viewProj de la CameraUBO (set=0, binding=0, MÊME UBO que le
// rendu principal -> alignement pixel-exact avec la scène) * model (push
// constant par objet). Pas de depth-test (silhouette pleine, l'ordre de
// rasterisation n'importe pas : tout le maillage projeté écrit du blanc).
@location(0) in vec3 aPos;

@binding(set=0, binding=0)
uniform CameraUBO {
    mat4  view;
    mat4  proj;
    mat4  viewProj;
    mat4  invViewProj;
    vec4  camPos;
    vec4  camDir;
    vec2  viewport;
    float time;
    float deltaTime;
    float iblStrength;
    float _p0;
    float _p1;
    float _p2;
    mat4  mirrorViewProj;
    vec4  reflectionFlags;
} uCam;

layout(push_constant) uniform PC {
    mat4 model;
} pc;

@stage(vertex)
@entry
void main() {
    gl_Position = uCam.viewProj * (pc.model * vec4(aPos, 1.0));
}

// glass.frag.nksl — NKRenderer — Verre Fragment (VRAI dialecte NkSL).
// Fresnel + reflet d'environnement + transmission teintee. L'ancien
// .vk.glsl lisait une texture de scene (tSceneColor) que le systeme de
// materiaux ne remplit jamais et une disposition de varyings obsolete
// (tangentes en location 2/3) : il rendait du noir. Ici, transmission =
// couleur du materiau attenuee, reflet = cubemap prefiltre, melange par
// Fresnel — le comportement que l'oeil attend d'une vitre.
@location(0) in vec3 vWorldPos;
@location(1) in vec3 vNormal;
@location(2) in vec2 vUV;
@location(3) in vec4 vColor;
@location(0) out vec4 fragColor;

@binding(set=0, binding=0)
uniform CameraUBO {
    mat4  view, proj, viewProj, invViewProj;
    vec4  camPos, camDir; vec2 viewport; float time, deltaTime;
    float iblStrength;
    float _p0, _p1, _p2;
    mat4  mirrorViewProj;
    vec4  reflectionFlags;
} uCam;

@binding(set=1, binding=1)
uniform ObjectUBO {
    mat4  model, normalMatrix; vec4 tint;
    float metallic, roughness, aoStrength, emissiveStrength;
    float normalStrength, clearcoat, clearcoatRoughness, subsurface;
    vec4  subsurfaceColor;
    vec4  shadowOverrides;
    vec4  triplanarParams;
} uObj;

@binding(set=0, binding=2)
uniform LightsUBO {
    vec4  positions[32], colors[32], directions[32], angles[32];
    int   count; int _pad0; int _pad1; int _pad2;
    // .x = loi d'attenuation (0 heritee, 1 physique 1/d^2 fenetree)
    // .y = largeur de la surfacique  .z = hauteur  .w reserve
    // En QUEUE de bloc : les shaders qui declarent la version courte lisent
    // `count` au meme endroit (regle du projet, cf. pbr.frag.nksl).
    vec4  extras[32];
} uLights;

#include "Include/NkLightCommon.glsli"

// Meme layout que NkPBRParams.
@binding(set=2, binding=8)
uniform MaterialUBO {
    vec4  albedo;
    vec4  emissive;
    float metallic;
    float roughness;
    float ao;
    float emissiveStrength;
    float normalStrength;
    float clearcoat;
    float clearcoatRough;
    float subsurface;
    vec4  subsurfaceColor;
    float anisotropy;
    float sheen;
    float reflFloorFaceMode;
    float reflBlend;
} uMat;

@binding(set=2, binding=3) uniform sampler2D tAlbedo;
@binding(set=0, binding=9) uniform samplerCube tEnvPrefilter;

@stage(fragment)
@entry
void main() {
    vec4 albSamp = texture(tAlbedo, vUV) * uMat.albedo * vColor;
    vec3 tintC   = albSamp.rgb;

    vec3 N = normalize(vNormal);
    vec3 camPosForV = uCam.camPos.xyz;
    if (uCam.reflectionFlags.x > 0.5) camPosForV.y = -camPosForV.y;
    vec3 V = normalize(camPosForV - vWorldPos);
    // Le verre est fin : la face vue de dos reflechit du meme cote.
    if (dot(N, V) < 0.0) N = -N;
    float cosV = max(dot(N, V), 0.0);

    // ── FRESNEL REGLABLE PAR L'INDICE DE REFRACTION ────────────────────
    // Par defaut la valeur PHYSIQUE du verre courant (n = 1.5, soit F0 =
    // 0.04) ; l'artiste peut l'outrepasser pour aller chercher un effet
    // (Rihen : « on active pour regler, du coup les artistes pourront faire
    // des choses waou »). Le champ `clearcoat` du MaterialUBO porte l'indice
    // pour ce type — meme principe qu'Unreal, qui reaffecte ses entrees
    // selon le modele d'ombrage (ici l'anisotropie sert de densite de
    // paillettes a la carrosserie).
    //   n = 1.0  aucun reflet (air)
    //   n = 1.33 eau          n = 1.5  verre a vitre — le defaut
    //   n = 2.4  diamant      n ~ 3.9  silicium
    //   n < 1    metamateriaux — la formule reste valide, F0 remonte
    // AUCUN PLAFOND : l'indice n'est pas borne par la physique. Ce qui l'est,
    // c'est le facteur F lui-meme, dans [0,1] par conservation d'energie — et
    // F0 = ((n-1)/(n+1))^2 le garantit pour tout n > 0 (relation exacte, pas
    // une approximation). Seul n <= 0 est refuse : la formule y diverge.
    float ior = (uMat.clearcoat > 0.0) ? uMat.clearcoat : 1.5;
    float f0r = (ior - 1.0) / (ior + 1.0);
    float F0g = f0r * f0r;
    float F = F0g + (1.0 - F0g) * pow(1.0 - cosV, 5.0);

    // Reflet : cubemap prefiltre, le niveau suit la rugosite. PAS multiplie
    // par iblStrength — une vitre reflechit son environnement meme quand la
    // scene baisse son apport d'IBL ; l'y soumettre eteignait le verre en
    // gris plat (capture 098).
    vec3 R    = reflect(-V, N);
    vec3 refl = textureLod(tEnvPrefilter, R, uMat.roughness * 4.0).rgb;

    // Transmission : la teinte du verre, a peine plus dense en incidence
    // rasante (loi de Beer tres attenuee — une vitre n'est pas un bloc).
    float thick = 1.0 / max(cosV, 0.25);
    vec3  trans = tintC * exp(-(1.0 - tintC) * (thick - 1.0) * 0.15);

    // Speculaire direct : un point brillant par lumiere, sans boucle
    // d'ombre (une vitre n'a pas d'ombre propre lisible).
    vec3 spec = vec3(0.0);
    for (int i = 0; i < uLights.count && i < 32; i++) {
        vec4 lPos = uLights.positions[i];
        vec3 L    = (lPos.w < 0.5)
                  ? normalize(-uLights.directions[i].xyz)
                  : normalize(lPos.xyz - vWorldPos);
        vec3 H    = normalize(L + V);
        float sh  = pow(max(dot(N, H), 0.0), 128.0);
        // Surfacique : facteur de forme au lieu de l'inverse carre.
        float aE  = NkAreaFormFactor(i, vWorldPos, N);
        float att = (aE >= 0.0) ? aE * 3.14159265 * NkAreaRangeWindow(i, vWorldPos)
                                : NkLightAtt(i, vWorldPos);
        spec += uLights.colors[i].rgb * sh * 0.6 * att;
    }

    // PLUS L'OPACITE MONTE, PLUS C'EST UNE SURFACE. Un verre translucide
    // laisse passer la lumiere (terme `trans`) ; un verre LAQUE, lui, est
    // une surface qui doit s'OMBRER — sans ce terme il restait un aplat
    // uniforme, blanc et plat (capture de Rihen a opacite 1, 10h29).
    vec3 dif = vec3(0.0);
    for (int j = 0; j < uLights.count && j < 32; j++) {
        vec4 lP = uLights.positions[j];
        vec3 Lj = (lP.w < 0.5) ? normalize(-uLights.directions[j].xyz)
                               : normalize(lP.xyz - vWorldPos);
        float aE2 = NkAreaFormFactor(j, vWorldPos, N);
        float e2  = (aE2 >= 0.0)
                  ? aE2 * NkAreaRangeWindow(j, vWorldPos)
                  : max(dot(N, Lj), 0.0) * 0.31830989 * NkLightAtt(j, vWorldPos);
        dif += uLights.colors[j].rgb * uLights.colors[j].w * e2;
    }
    vec3 surf = tintC * dif;
    vec3 body = mix(trans, surf, albSamp.a); // 0 = vitre, 1 = surface laquee
    vec3 col = mix(body, refl, F) + spec;
    // L'OPACITE EST UN PLANCHER, le Fresnel n'ajoute que par-dessus.
    // L'ancienne formule (opacite x (0.15 + 0.85 F)) plafonnait vers 0.2 MEME
    // a opacite 1 : le verre ne pouvait qu'etre transparent. Impossible d'en
    // faire un verre teinte sombre, laque, ou un miroir sans tain — alors que
    // ces verres-la existent et REFLETENT (Rihen, 12 aout). Desormais :
    //   opacite 1.0 -> opaque, et il reflete toujours (le reflet vit dans la
    //                  couleur, pas dans l'alpha) ;
    //   opacite 0.1 -> vitre claire, dont les bords rasants se densifient.
    float a = clamp(albSamp.a + (1.0 - albSamp.a) * F, 0.0, 1.0);
    fragColor = vec4(col, a);
}

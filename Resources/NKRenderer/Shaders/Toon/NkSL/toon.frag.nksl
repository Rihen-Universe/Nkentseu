// toon.frag.nksl — NKRenderer — Toon/Cel-shading Fragment (VRAI dialecte NkSL).
@location(0) in vec3 vWorldPos;
@location(1) in vec3 vNormal;
@location(2) in vec2 vUV;
@location(3) in vec4 vColor;
@location(0) out vec4 fragColor;

@binding(set=0, binding=0)
uniform CameraUBO {
    mat4  view, proj, viewProj, invViewProj;
    vec4  camPos, camDir; vec2 viewport; float time, deltaTime;
    float iblStrength;
    float _p0, _p1, _p2;
    mat4  mirrorViewProj;
    vec4  reflectionFlags;
} uCam;

@binding(set=1, binding=1)
uniform ObjectUBO {
    mat4  model, normalMatrix; vec4 tint;
    float metallic, roughness, aoStrength, emissiveStrength;
    float normalStrength, clearcoat, clearcoatRoughness, subsurface;
    vec4  subsurfaceColor;
    vec4  shadowOverrides;
    vec4  triplanarParams;
} uObj;

@binding(set=0, binding=2)
uniform LightsUBO {
    vec4  positions[32], colors[32], directions[32], angles[32];
    int   count;
    int   _pad0;
    int   _pad1;
    int   _pad2;
    // En QUEUE : attenuation + dimensions des surfaciques (cf. pbr.frag).
    vec4  extras[32];
} uLights;
#include "Include/NkLightCommon.glsli"

struct NkShadowSlot {
    mat4 shadowMatrix;
    vec4 tileUV;
    vec4 lightPosOrDir;
    vec4 packedIds;
};
@binding(set=0, binding=3)
uniform ShadowSlotsUBO {
    NkShadowSlot slots[256];
    vec4 firstSlotPerLight[8];
    vec4 slotCountPerLight[8];
    vec4 globalCfg;
    vec4 biasParams;
} uShadows;
@binding(set=0, binding=11) uniform sampler2DShadow tShadowAtlas;
// Atlas BRUT (non comparatif) : exige par le mode PCSS de NkShadowAtlas.glsli.
@binding(set=0, binding=12) uniform sampler2D tShadowAtlasRaw;
#include "Include/NkShadowAtlas.glsli"

@binding(set=2, binding=8)
uniform ToonUBO {
    vec4  albedoColor;
    vec4  shadowColor;
    float shadowThreshold;
    float shadowSmooth;
    float outlineWidth;
    float rimIntensity;
    vec4  outlineColor;
    vec4  rimColor;
    float specHardness;
    float metallic;
    float matcapStrength;
    float _pad;
} uToon;

@binding(set=2, binding=3) uniform sampler2D tAlbedo;
@binding(set=2, binding=4) uniform sampler2D tMatcap;

@stage(fragment)
@entry
void main() {
    vec3 N = normalize(vNormal);
    vec3 camPosForV = uCam.camPos.xyz;
    if (uCam.reflectionFlags.x > 0.5) camPosForV.y = -camPosForV.y;
    vec3 V = normalize(camPosForV - vWorldPos);
    float NdotV = dot(N, V);

    vec4 albedo = texture(tAlbedo, vUV) * uToon.albedoColor;

    // Derivees ecran de worldPos, prises UNE FOIS en flux uniforme : un dFdx
    // DANS la boucle des lumieres force fxc a la derouler (X3570/X3511) et la
    // creation du shader echouait — le Toon restait noir sur DX11.
    vec3 dWdx = dFdx(vWorldPos);
    vec3 dWdy = dFdy(vWorldPos);

    // ── CONTOUR ────────────────────────────────────────────────────────
    // UN SEUL marqueur : la VITESSE DE ROTATION DE LA NORMALE a l'ecran.
    // Il couvre les deux cas d'un trait toon, la ou chacun des autres
    // echoue :
    //   - arete vive d'un CUBE : la normale saute d'une face a l'autre ;
    //   - silhouette d'une SPHERE : la normale tourne tres vite par pixel
    //     quand la surface se derobe du regard.
    // Le test « 1 - N.V > seuil » de renderdemo, lui, ne vaut QUE pour les
    // surfaces courbes : sur un cube il noircissait une FACE ENTIERE des
    // qu'elle etait vue de biais (capture 106) — c'est ce que Rihen voyait
    // comme « les bordures ne fonctionnent pas ».
    if (uToon.outlineWidth > 0.0) {
        float w  = max(uToon.outlineWidth, 0.25);
        // Plus le trait demande est epais, plus on accepte une rotation
        // faible : le contour s'elargit sans jamais couvrir une face plane
        // (ou la derivee est nulle).
        if (length(fwidth(N)) > 0.55 / w) {
            fragColor = vec4(uToon.outlineColor.rgb, albedo.a);
            return;
        }
    }

    vec3 totalDiffuse = vec3(0.0);
    vec3 totalSpec    = vec3(0.0);

    // Meme forme de boucle que pbr.frag ; SANS gradient a l'interieur
    // (cf. dWdx/dWdy ci-dessus), fxc emet une vraie boucle.
    for (int i = 0; i < uLights.count && i < 32; i++) {
        vec4 lPos   = uLights.positions[i];
        vec3 L      = (lPos.w < 0.5)
                    ? normalize(-uLights.directions[i].xyz)
                    : normalize(lPos.xyz - vWorldPos);
        float NdotL = dot(N, L);

        // NkVSM v2 : overrides per-material (.x receiveShadow, .z biasMul).
        float shadow = (uLights.angles[i].z > 0.5 && uObj.shadowOverrides.x > 0.5)
                       ? SampleLightShadowExD(i, vWorldPos, N, L, uObj.shadowOverrides.z, dWdx, dWdy) : 1.0;

        float cel   = smoothstep(uToon.shadowThreshold - uToon.shadowSmooth,
                                 uToon.shadowThreshold + uToon.shadowSmooth,
                                 NdotL);
        // ECLAIREMENT DE LA SCENE, borne : un cel garde son APLAT (c'est son
        // interet), mais il doit rester dans l'echelle de la scene. Sans ce
        // facteur, le toon sortait ~albedo quelle que soit la lumiere et
        // l'auto-exposition le poussait au BLANC (constate 12 aout).
        float areaE = NkAreaFormFactor(i, vWorldPos, N);
        float E     = (areaE >= 0.0)
                    ? uLights.colors[i].w * areaE * 3.14159265 * NkAreaRangeWindow(i, vWorldPos)
                    : uLights.colors[i].w * NkLightAtt(i, vWorldPos);
        // PLAFOND A 1 : un cel tient sa couleur de son ALBEDO. Au-dela, les
        // canaux saturent un par un et un bleu vire au blanc (capture 108) —
        // exactement ce que « pas comme renderdemo » designait.
        E = clamp(E, 0.0, 1.0);
        vec3 lit    = uLights.colors[i].rgb * albedo.rgb * E;
        vec3 shad   = uToon.shadowColor.rgb  * albedo.rgb * E;
        totalDiffuse += mix(shad, lit, cel) * shadow;

        vec3 H         = normalize(L + V);
        float s        = step(0.5, pow(max(dot(N, H), 0.0), max(uToon.specHardness, 4.0)));
        vec3 specColor = mix(vec3(1.0), albedo.rgb, uToon.metallic);
        totalSpec     += uLights.colors[i].rgb * specColor * s * shadow * E * 0.35;
    }
    if (uLights.count == 0) totalDiffuse = albedo.rgb;

    float rim = pow(1.0 - max(NdotV, 0.0), 3.0) * uToon.rimIntensity;
    vec3 rimC = uToon.rimColor.rgb * rim;

    vec3 total = totalDiffuse + totalSpec + rimC;

    if (uToon.matcapStrength > 0.0) {
        vec3 viewN  = normalize(mat3(uCam.view) * N);
        vec2 mcUV   = viewN.xy * 0.5 + 0.5;
        vec3 mc     = texture(tMatcap, mcUV).rgb;
        total += mc * uToon.matcapStrength;
    }

    fragColor = vec4(total, albedo.a);
}

// NkLightCommon.glsli — NKRenderer — Ce que TOUT shader eclaire doit savoir
// des lumieres : l'attenuation par la distance et le facteur de forme d'une
// surfacique. Extrait de pbr.frag.nksl le 11 aout : les shaders de la famille
// realiste (Verre, Tissu, Carrosserie, Feuillage) le recopiaient mal ou pas du
// tout — une surfacique les cramait en blanc pendant que le PBR, seul a porter
// ce calcul, restait juste.
//
// PREREQUIS : le bloc uLights doit etre declare AVEC son tableau `extras`
// (version longue, cf. pbr.frag.nksl).
//
// REGLE fxc : ces fonctions sont de l'arithmetique pure — aucun gradient,
// donc appelables dans une boucle de lumieres sans declencher X3570/X3511.
#ifndef NK_LIGHT_COMMON_GLSLI
#define NK_LIGHT_COMMON_GLSLI

// Attenuation par la DISTANCE (directionnelle : 1). Meme lois que le PBR :
// .x des extras choisit la loi physique (1/d^2 fenetree par la portee) ou la
// loi heritee (lineaire au carre) que les scenes existantes ont reglee.
// NE S'APPLIQUE PAS a une surfacique : son facteur de forme porte deja
// l'inverse carre — l'appelant ne doit garder que la fenetre de portee.
float NkLightAtt(int i, vec3 wp) {
    if (uLights.positions[i].w < 0.5) return 1.0; // directionnelle
    vec3  d     = uLights.positions[i].xyz - wp;
    float dist  = length(d);
    float range = max(uLights.directions[i].w, 0.001);
    if (uLights.extras[i].x > 0.5) {
        float dm = max(dist, 0.01);
        float w  = clamp(1.0 - pow(dist / range, 4.0), 0.0, 1.0);
        return (w * w) / (dm * dm);
    }
    float a = max(1.0 - dist / range, 0.0);
    return a * a;
}

// FACTEUR DE FORME d'une lumiere SURFACIQUE (Baum 1989) : la fraction
// d'hemisphere que le rectangle occupe, vue du point et ponderee par la
// normale. Il contient DEJA le cosinus et l'inverse carre — c'est la valeur
// vers laquelle converge le diffus des tables LTC.
//   Retour : E >= 0 pour une surfacique, -1.0 pour tout autre type
//            (l'appelant garde alors son attenuation ponctuelle).
// L'irradiance equivalente vaut PI * radiance * E ; un diffus lambertien
// s'ecrit donc albedo * radiance * E, SANS N.L (le facteur le contient —
// c'est ce qui permet a un grand panneau d'eclairer une face rasante).
float NkAreaFormFactor(int i, vec3 wp, vec3 N) {
    if (abs(uLights.positions[i].w - 3.0) > 0.5) return -1.0; // pas une surfacique
    vec3 fwdA   = normalize(uLights.directions[i].xyz);
    vec3 upW    = abs(fwdA.y) > 0.99 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 rightA = normalize(cross(upW, fwdA));
    vec3 upA    = normalize(cross(fwdA, rightA));
    float hw    = max(uLights.extras[i].y, 0.01) * 0.5;
    float hh    = max(uLights.extras[i].z, 0.01) * 0.5;
    vec3 Pl     = uLights.positions[i].xyz;
    // UN SEUL COTE : derriere le panneau, rien.
    if (dot(fwdA, wp - Pl) <= 0.0) return 0.0;
    vec3 q0 = normalize(Pl - rightA * hw - upA * hh - wp);
    vec3 q1 = normalize(Pl + rightA * hw - upA * hh - wp);
    vec3 q2 = normalize(Pl + rightA * hw + upA * hh - wp);
    vec3 q3 = normalize(Pl - rightA * hw + upA * hh - wp);
    float E = 0.0;
    E += acos(clamp(dot(q0, q1), -1.0, 1.0)) * dot(normalize(cross(q0, q1)), N);
    E += acos(clamp(dot(q1, q2), -1.0, 1.0)) * dot(normalize(cross(q1, q2)), N);
    E += acos(clamp(dot(q2, q3), -1.0, 1.0)) * dot(normalize(cross(q2, q3)), N);
    E += acos(clamp(dot(q3, q0), -1.0, 1.0)) * dot(normalize(cross(q3, q0)), N);
    // SIGNE : avec cet ordre de sommets le parcours est horaire vu du
    // recepteur, la somme sort negative quand le panneau eclaire de face.
    return max(-E * 0.159154943, 0.0); // 1/(2PI)
}

// La fenetre de PORTEE seule (sans inverse carre) : ce qui reste a appliquer
// a une surfacique, dont le facteur de forme porte deja la geometrie.
float NkAreaRangeWindow(int i, vec3 wp) {
    float dist  = length(uLights.positions[i].xyz - wp);
    float range = max(uLights.directions[i].w, 0.001);
    if (uLights.extras[i].x > 0.5) {
        float w = clamp(1.0 - pow(dist / range, 4.0), 0.0, 1.0);
        return w * w;
    }
    float a = max(1.0 - dist / range, 0.0);
    return a * a;
}

#endif // NK_LIGHT_COMMON_GLSLI

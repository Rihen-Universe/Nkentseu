// =============================================================================
// NkShadowAtlas.glsli — helpers cross-API pour sampler le shadow atlas VSM.
//
// Doit etre #include apres :
//   - layout(std140, set=0, binding=3) uniform ShadowSlotsUBO ... uShadows;
//   - layout(set=0, binding=11) uniform sampler2DShadow tShadowAtlas;
//   - layout(set=0, binding=2) uniform LightsUBO ... uLights;
//
// API publique :
//   float SampleLightShadow(int lightIdx, vec3 worldPos, vec3 N, vec3 L)
//
// Dispatch interne selon le type de la light (encode dans uLights.positions[i].w
// par le runtime cote C++) :
//   - 0 = NK_DIRECTIONAL -> cascade selection + PCF
//   - 1 = NK_POINT       -> face selection + PCF
//   - 2 = NK_SPOT        -> 1 tile + PCF
//   - 3 = NK_AREA        -> 1.0 (pas de shadow V0)
// =============================================================================
#ifndef NK_SHADOW_ATLAS_GLSLI
#define NK_SHADOW_ATLAS_GLSLI

// Bias adaptatif slope-based : evite shadow acne sur surfaces rasantes a la
// lumiere. Plus N.L est faible, plus on pousse le bias.
// biasMul = multiplicateur per-material (uObj.shadowOverrides.z), default 1.0.
float NkShadowSlopeBias(vec3 N, vec3 L) {
    float NdL = max(dot(N, L), 0.0);
    return uShadows.biasParams.x * max(1.0, 4.0 * (1.0 - NdL));
}
float NkShadowSlopeBiasMul(vec3 N, vec3 L, float biasMul) {
    return NkShadowSlopeBias(N, L) * biasMul;
}

// Taille MONDE d'un texel du tile `slotIdx`, au point `worldPos`.
//
// C'est la grandeur qui calibre le normal bias : l'erreur de quantification
// d'une shadow map vaut par construction ~un texel, donc le decalage qui la
// compense doit se mesurer EN TEXELS, jamais en centimetres fixes.
//
// Lecture de la matrice (GLSL = colonne-majeure, m[col][row]) :
//   - ligne 0 (clip.x) : sa norme vaut 2/largeur_monde couverte par le tile ;
//   - ligne 3 (clip.w) : 1 pour une ortho (directionnelle), la profondeur
//     lumiere pour une perspective (omni/spot) -- le texel d'une perspective
//     GRANDIT avec la distance, et ce w le mesure exactement.
float NkShadowTexelWorld(int slotIdx, vec3 worldPos) {
    float sx = length(vec3(uShadows.slots[slotIdx].shadowMatrix[0][0],
                           uShadows.slots[slotIdx].shadowMatrix[1][0],
                           uShadows.slots[slotIdx].shadowMatrix[2][0]));
    float w  = uShadows.slots[slotIdx].shadowMatrix[0][3] * worldPos.x
             + uShadows.slots[slotIdx].shadowMatrix[1][3] * worldPos.y
             + uShadows.slots[slotIdx].shadowMatrix[2][3] * worldPos.z
             + uShadows.slots[slotIdx].shadowMatrix[3][3];
    vec4  tuv    = uShadows.slots[slotIdx].tileUV;
    float tilePx = max((tuv.z - tuv.x) * float(textureSize(tShadowAtlas, 0).x), 1.0);
    return 2.0 * max(abs(w), 1e-4) / (max(sx, 1e-6) * tilePx);
}

// Normal bias : pousse worldPos le long de N avant la projection shadow.
// Evite a la fois shadow acne ET peter panning. biasParams.y est un NOMBRE DE
// TEXELS, converti ici en unites monde via la taille reelle du texel du tile.
//
// POURQUOI PAR TILE, ET PLUS EN CONSTANTE MONDE (bug constate par Rihen : le
// cube semblait flotter, son ombre ne touchait pas son pied) : la constante
// (5 cm) etait calibree pour la cascade la plus LOINTAINE. Sur la cascade
// proche -- ou le texel vaut quelques millimetres -- le meme decalage etait
// 10 a 100 fois trop grand : applique a la normale VERTICALE du sol, il
// testait chaque point du sol 5 cm au-dessus de lui-meme, et le contact de
// l'ombre au pied des objets disparaissait sur ces 5 cm.
vec3 NkShadowNormalBiasOffsetSlot(int slotIdx, vec3 worldPos, vec3 N, vec3 L) {
    float NdL = max(dot(N, L), 0.0);
    // 1-NdL = grazing factor : push plus fort aux angles rasants ou les
    // artifacts sont plus visibles.
    float scale = (1.0 - NdL) * 0.5 + 0.5;
    return worldPos + N * (uShadows.biasParams.y * NkShadowTexelWorld(slotIdx, worldPos)) * scale;
}

// Sample un tile specifique de l'atlas (PCF 3x3 + biais du plan recepteur).
//
// slotIdx : index dans uShadows.slots[]
// worldPos : position du fragment en world space (apres un-mirror Y si mirror pass)
// bias : depth bias en NDC space
// dWdx/dWdy : derivees ECRAN de worldPos (dFdx/dFdy), calculees par l'appelant
//   en FLUX UNIFORME -- ici on est sous la selection de cascade, qui diverge
//   d'un pixel a l'autre, et une derivee prise dans un flux divergent est
//   indefinie par la spec.
float NkSampleShadowTile(int slotIdx, vec3 worldPos, float bias, vec3 dWdx, vec3 dWdy) {
    if (slotIdx < 0 || slotIdx >= 256) return 1.0;
    vec4 coord = uShadows.slots[slotIdx].shadowMatrix * vec4(worldPos, 1.0);
    if (coord.w <= 0.0) return 1.0;
    vec3 ndc = coord.xyz / coord.w;
    vec3 p = ndc;
    // NDC [-1,1] -> UV [0,1] dans le tile NDC. X/Y toujours remappes.
    p.x = p.x * 0.5 + 0.5;
    p.y = p.y * 0.5 + 0.5;
    // Y-flip atlas DX (globalCfg.w=1) : l'atlas est rendu sans flip viewport, mais la
    // convention NDC.y->ligne texture diffère (DX : NDC.y=+1=haut, mais V=0=haut →
    // p.y*0.5+0.5 échantillonne la ligne INVERSE). On flippe V sur DX uniquement.
    // VK/GL (globalCfg.w=0) : inchangé.
    p.y = mix(p.y, 1.0 - p.y, uShadows.globalCfg.w);
    // Z : sur OpenGL (globalCfg.z=1) le Z NDC est [-1,1] -> remap *0.5+0.5. Sur VK/DX
    // (globalCfg.z=0) clipZ01 est deja baked dans shadowMatrix -> Z deja en [0,1], NE
    // PAS refaire le remap (sinon p.z trop grand -> tout en ombre -> scene noire DX12).
    float zRemap = uShadows.globalCfg.z;
    p.z = mix(p.z, p.z * 0.5 + 0.5, zRemap) - bias;
    if (p.x < 0.0 || p.x > 1.0) return 1.0;
    if (p.y < 0.0 || p.y > 1.0) return 1.0;
    if (p.z < 0.0 || p.z > 1.0) return 1.0;

    // Remap (p.x, p.y) du NDC tile [0,1] vers les coordonnees UV du tile
    // dans l'atlas global (tileUV.xy = minUV, .zw = maxUV).
    vec4 tileUV = uShadows.slots[slotIdx].tileUV;
    vec2 atlasUV = mix(tileUV.xy, tileUV.zw, p.xy);

    // ── BIAIS DU PLAN RECEPTEUR (Isidoro) ────────────────────────────────────
    // Un tap PCF decale de quelques texels compare la profondeur du CENTRE a
    // celle d'un VOISIN : sur une surface inclinee face a la lumiere, l'ecart
    // est structurel, et c'est LUI qui imposait les gros biais -- lesquels
    // decollaient l'ombre du pied des objets. Ici on extrapole la profondeur
    // du plan du recepteur A LA POSITION DE CHAQUE TAP : l'ecart structurel
    // disparait, le biais constant peut rester minuscule, ET l'atlas garde
    // toutes ses faces (le culling front, essaye pour le meme but, eclairait
    // l'interieur des objets fermes -- capture de Rihen du 7 aout).
    //
    // Derivees : monde -> clip est lineaire (matrice), puis regle du quotient
    // pour la division perspective, puis les MEMES remaps que p ci-dessus.
    vec4 dcx = uShadows.slots[slotIdx].shadowMatrix * vec4(dWdx, 0.0);
    vec4 dcy = uShadows.slots[slotIdx].shadowMatrix * vec4(dWdy, 0.0);
    vec3 dnx = (dcx.xyz - ndc * dcx.w) / coord.w;
    vec3 dny = (dcy.xyz - ndc * dcy.w) / coord.w;
    float flipS = mix(1.0, -1.0, uShadows.globalCfg.w); // meme flip que p.y
    vec2  tileS = tileUV.zw - tileUV.xy;                 // echelle tile->atlas
    float au_x = dnx.x * 0.5 * tileS.x;
    float av_x = flipS * dnx.y * 0.5 * tileS.y;
    float au_y = dny.x * 0.5 * tileS.x;
    float av_y = flipS * dny.y * 0.5 * tileS.y;
    float az_x = mix(dnx.z, dnx.z * 0.5, zRemap);
    float az_y = mix(dny.z, dny.z * 0.5, zRemap);
    // dz/du et dz/dv (atlas UV) par resolution du systeme 2x2. Determinant
    // quasi nul = silhouette vue par la tranche : l'hypothese « plan » n'y
    // vaut rien, on retombe sur la comparaison classique (zu = zv = 0).
    float det = au_x * av_y - av_x * au_y;
    float zu = 0.0;
    float zv = 0.0;
    if (abs(det) > 1e-14) {
        zu = (az_x * av_y - az_y * av_x) / det;
        zv = (az_y * au_x - az_x * au_y) / det;
    }

    // PCF 3x3 cross-API. LE PAS SUIT LA DOUCEUR, comme le portage DX11 : sans
    // cela le reglage « Douceur » du panneau n'avait AUCUN effet sur Vulkan/GL
    // alors qu'il en avait un sur DX11 -- deux backends qui ne montraient pas la
    // meme image a partir des memes reglages.
    vec2 ts = 1.0 / vec2(textureSize(tShadowAtlas, 0));
    // RAYON de la penombre, en UV d'atlas. C'est la « Douceur » du panneau, et
    // elle seule : le MODE ne change pas la largeur de l'ombre, il change le
    // nombre et la place des echantillons DANS ce rayon. Sans cette separation,
    // passer en qualite superieure elargissait l'ombre -- l'utilisateur croyait
    // regler la douceur en changeant la qualite, et les deux reglages se
    // marchaient dessus.
    float pcfR = max(1.0, uShadows.biasParams.z * float(textureSize(tShadowAtlas, 0).x) * 0.25);
    vec2 R = ts * pcfR;

    // ── LE MODE DE FILTRAGE EST ENFIN LU ────────────────────────────────────
    // `globalCfg.y` porte la qualite (NkVSMShadowQuality). Elle etait calculee,
    // televersee... et lue par PERSONNE : PCF3x3, PCF5x5 et Poisson rendaient
    // rigoureusement la meme image, celle du 3x3 ci-dessous. Le reglage du
    // panneau ne faisait donc rien, ce que Rihen constatait sans pouvoir le
    // prouver (« j'ai toujours l'impression que toutes les qualites donnent la
    // meme chose » -- ce n'etait pas une impression).
    //
    // Chaque boucle a un COMPTE CONSTANT : fxc doit pouvoir les derouler, ce
    // sample etant inline dans des boucles a compte dynamique cote appelant.
    int q = int(uShadows.globalCfg.y + 0.5);
    float s = 0.0;

    // textureLod(..., 0.0) et non texture() : l'atlas est mono-mip, le LOD 0
    // explicite est donc exact ET sans gradient. Indispensable sur DX : un
    // sample a GRADIENT dans une boucle a compte variable fait echouer fxc
    // (X3570 -> deroulage impossible). SPIRV-Cross emet SampleCmpLevelZero.
    if (q >= 3) {
        // POISSON : douze taps en disque, sans alignement de grille. A nombre
        // d'echantillons egal, la grille laisse des MARCHES sur un bord oblique
        // la ou le disque laisse du grain -- l'oeil pardonne le grain, pas les
        // marches.
        const vec2 kPoisson[12] = vec2[12](
            vec2(-0.326, -0.406), vec2(-0.840, -0.074), vec2(-0.696,  0.457),
            vec2(-0.203,  0.621), vec2( 0.962, -0.195), vec2( 0.473, -0.480),
            vec2( 0.519,  0.767), vec2( 0.185, -0.893), vec2( 0.507,  0.064),
            vec2( 0.896,  0.412), vec2(-0.322, -0.933), vec2(-0.792, -0.598));
        for (int i = 0; i < 12; i++) {
            vec2 uv = clamp(atlasUV + kPoisson[i] * R, tileUV.xy + ts, tileUV.zw - ts);
            vec2 duv = uv - atlasUV;
            float dz = clamp(zu * duv.x + zv * duv.y, -0.005, 0.005);
            s += textureLod(tShadowAtlas, vec3(uv, p.z + dz), 0.0);
        }
        return s / 12.0;
    }
    if (q == 2) {
        // PCF 5x5 : MEME rayon, pas deux fois plus petit -- vingt-cinq taps au
        // lieu de neuf dans la meme penombre. C'est bien un gain de qualite, pas
        // un elargissement deguise.
        vec2 h = R * 0.5;
        for (int dx = -2; dx <= 2; dx++) {
            for (int dy = -2; dy <= 2; dy++) {
                vec2 uv = clamp(atlasUV + vec2(dx, dy) * h, tileUV.xy + ts, tileUV.zw - ts);
                vec2 duv = uv - atlasUV;
                float dz = clamp(zu * duv.x + zv * duv.y, -0.005, 0.005);
                s += textureLod(tShadowAtlas, vec3(uv, p.z + dz), 0.0);
            }
        }
        return s / 25.0;
    }
    // PCF 3x3 par defaut.
    for (int dx = -1; dx <= 1; dx++) {
        for (int dy = -1; dy <= 1; dy++) {
            vec2 uv = atlasUV + vec2(dx, dy) * R;
            // Clamp aux bornes du tile pour eviter le bleed vers tile voisin.
            uv = clamp(uv, tileUV.xy + ts, tileUV.zw - ts);
            // L'extrapolation part du deplacement REEL (apres clamp), et reste
            // bornee : au voisinage d'une silhouette la pente explose, et une
            // extrapolation demesuree percerait l'ombre.
            vec2  duv = uv - atlasUV;
            float dz  = clamp(zu * duv.x + zv * duv.y, -0.005, 0.005);
            s += textureLod(tShadowAtlas, vec3(uv, p.z + dz), 0.0);
        }
    }
    return s / 9.0;
}

// Variante pour la DIRECTIONNELLE : au bord de la zone couverte par la
// cascade, l'ombre FOND vers la lumiere au lieu de se couper net. La
// couverture vient de l'auto-fit des casters : un recepteur juste au-dela
// voyait son ombre coupee au cordeau (constate par Rihen -- chez Blender
// elle s'etire et disparait). Bande de fondu : 8% du tile. Reservee a la
// directionnelle : sur les faces d'une omni, ce fondu ECLAIRCIRAIT les
// coutures que la bande de garde vient de fermer.
float NkSampleShadowTileFaded(int slotIdx, vec3 worldPos, float bias, vec3 dWdx, vec3 dWdy) {
    if (slotIdx < 0 || slotIdx >= 256) return 1.0;
    vec4 coord = uShadows.slots[slotIdx].shadowMatrix * vec4(worldPos, 1.0);
    if (coord.w <= 0.0) return 1.0;
    vec3 p = coord.xyz / coord.w;
    p.x = p.x * 0.5 + 0.5;
    p.y = p.y * 0.5 + 0.5;
    p.y = mix(p.y, 1.0 - p.y, uShadows.globalCfg.w);
    float edge = min(min(p.x, 1.0 - p.x), min(p.y, 1.0 - p.y));
    float ef = clamp(edge / 0.08, 0.0, 1.0);
    if (ef <= 0.0) return 1.0;
    float s = NkSampleShadowTile(slotIdx, worldPos, bias, dWdx, dWdy);
    return mix(1.0, s, ef);
}

// Sample shadow pour une directional light. Selection de la cascade c selon
// la profondeur view-space, puis sample le tile correspondant.
//
// NkVSM v1 (2026-05-23) : cascade FADE active. Sur les 15% derniers de la
// cascade courante (proche du splitFar), on blend smooth avec la cascade
// suivante pour eviter la transition brutale (changement de resolution
// shadow tres visible quand cam bouge). Coût : 2 samples PCF au lieu d'1
// dans la bande de transition (~15% des fragments).
const float kCascadeFadeStart = 0.85;  // debut zone fade (0..1 du splitFar)

float NkSampleDirectionalShadow(int lightIdx, vec3 worldPos, vec3 N, vec3 L, float biasMul,
                                vec3 dWdx, vec3 dWdy) {
    if (lightIdx < 0 || lightIdx >= 32) return 1.0;
    int firstSlot = int(uShadows.firstSlotPerLight[lightIdx >> 2][lightIdx & 3]);
    int slotCount = int(uShadows.slotCountPerLight[lightIdx >> 2][lightIdx & 3]);
    if (firstSlot < 0 || slotCount <= 0) return 1.0;

    // Cascade selection : depth en view-space (negative dans la convention
    // OpenGL : camera regarde -Z, donc fragments avant la cam ont z < 0).
    // On compare abs(z) aux splits stockes positifs.
    float depth    = (uCam.view * vec4(worldPos, 1.0)).z;
    float absDepth = -depth;  // distance positive depuis la cam
    float bias     = NkShadowSlopeBiasMul(N, L, biasMul);

    for (int c = 0; c < slotCount && c < 4; c++) {
        int slotIdx = firstSlot + c;
        float splitFar = uShadows.slots[slotIdx].lightPosOrDir.w;
        if (absDepth < splitFar) {
            // Normal bias calcule PAR CASCADE, une fois celle-ci choisie : le
            // texel de la cascade 0 et celui de la cascade 3 different d'un
            // ordre de grandeur, leur decalage aussi.
            vec3  wp = NkShadowNormalBiasOffsetSlot(slotIdx, worldPos, N, L);
            float s0 = NkSampleShadowTileFaded(slotIdx, wp, bias, dWdx, dWdy);
            float fadeT = (absDepth / splitFar - kCascadeFadeStart)
                          / (1.0 - kCascadeFadeStart);
            if (fadeT > 0.0 && c + 1 < slotCount) {
                // La cascade suivante a SON texel, donc SON decalage.
                vec3  wp1 = NkShadowNormalBiasOffsetSlot(firstSlot + c + 1, worldPos, N, L);
                float s1 = NkSampleShadowTileFaded(firstSlot + c + 1, wp1, bias, dWdx, dWdy);
                return mix(s0, s1, clamp(fadeT, 0.0, 1.0));
            }
            // DERNIERE cascade : au lieu de couper net au splitFar, l'ombre
            // FOND vers la lumiere sur la meme bande -- symetrique du fondu
            // lateral de NkSampleShadowTileFaded, meme raison (Rihen).
            if (fadeT > 0.0)
                return mix(s0, 1.0, clamp(fadeT, 0.0, 1.0));
            return s0;
        }
    }
    return 1.0;  // hors-frustum cascade -> pas d'ombre
}

// Sample shadow pour un point light. Face cubemap selection via direction
// (light->frag), puis sample le tile correspondant.
float NkSamplePointShadow(int lightIdx, vec3 worldPos, vec3 N, vec3 L, float biasMul,
                          vec3 dWdx, vec3 dWdy) {
    if (lightIdx < 0 || lightIdx >= 32) return 1.0;
    int firstSlot = int(uShadows.firstSlotPerLight[lightIdx >> 2][lightIdx & 3]);
    if (firstSlot < 0) return 1.0;
    // LES SIX FACES OU AUCUNE. Le C++ garantit desormais l'invariant, mais on le
    // verifie ici aussi : `firstSlot + face` sur une omni incomplete lisait la
    // tuile d'une AUTRE lumiere, et rien dans l'image ne disait d'ou venait
    // l'ombre. Une garde a deux instructions contre un defaut de ce prix, c'est
    // gratuit. Le chemin directionnel garde deja sur slotCount ; c'est cette
    // dissymetrie qui avait laissé passer le trou.
    int slotCount = int(uShadows.slotCountPerLight[lightIdx >> 2][lightIdx & 3]);
    if (slotCount < 6) return 1.0;

    vec3 lightPos = uShadows.slots[firstSlot].lightPosOrDir.xyz;
    vec3 dir = worldPos - lightPos;
    // ── LE BIAIS D'UNE OMNI DEPEND DE LA DISTANCE ──────────────────────────
    // Une face de point light est une projection perspective a 90 deg : la
    // profondeur y est tres non lineaire, si bien qu'un biais constant en NDC
    // est enorme pres de la lumiere et NEGLIGEABLE plus loin. C'est ce qui
    // faisait qu'un cube portait sa propre ombre -- toute une face noircie
    // alors que la lumiere l'eclairait (constate par Rihen ; sans l'ombre
    // portee, la meme face redevenait claire, ce qui a designe la cause).
    // On compense en faisant croitre le biais avec la distance, rapportee a
    // la portee de la lumiere.
    float farP = max(uShadows.slots[firstSlot].lightPosOrDir.w, 0.001);
    float distN = clamp(length(dir) / farP, 0.0, 1.0);
    // Croissance MODEREE : a x24, le biais MANGEAIT l'ombre au-dela d'un
    // rayon -- une « sphere » au-dela de laquelle l'ombre se coupait net au
    // lieu de fondre (constate par Rihen). Ramenee a x5 : le plan lointain
    // des faces est passe a DEUX FOIS la portee, la profondeur garde donc de
    // la precision au bout de la portee et le gros biais n'est plus
    // necessaire -- c'etait lui qui creait une sphere d'ombre plus petite
    // que celle de la lumiere.
    biasMul *= 1.0 + 4.0 * distN * distN;
    vec3 absDir = abs(dir);
    // Selection de face : axe dominant. Convention faces :
    //   0:+X 1:-X 2:+Y 3:-Y 4:+Z 5:-Z (cf. AllocSlotsPoint cote C++)
    int face;
    if (absDir.x > absDir.y && absDir.x > absDir.z) {
        face = dir.x > 0.0 ? 0 : 1;
    } else if (absDir.y > absDir.z) {
        face = dir.y > 0.0 ? 2 : 3;
    } else {
        face = dir.z > 0.0 ? 4 : 5;
    }
    int slotIdx = firstSlot + face;
    float bias = NkShadowSlopeBiasMul(N, L, biasMul);
    // Par tile : le texel d'une face d'omni grandit avec la distance a la
    // lumiere (projection perspective), le decalage doit suivre.
    vec3  wp   = NkShadowNormalBiasOffsetSlot(slotIdx, worldPos, N, L);
    // AUCUNE LIMITE PROPRE A L'OMBRE (Rihen : il y avait DEUX spheres, celle
    // de la lumiere et une sphere d'ombre plus petite -- elles doivent etre
    // UNE SEULE). L'ombre multiplie la lumiere : elle meurt donc exactement
    // avec l'attenuation, sans fondu artificiel ni rayon a elle.
    return NkSampleShadowTile(slotIdx, wp, bias, dWdx, dWdy);
}

// Sample shadow pour un spot light. Un seul tile.
float NkSampleSpotShadow(int lightIdx, vec3 worldPos, vec3 N, vec3 L, float biasMul,
                         vec3 dWdx, vec3 dWdy) {
    if (lightIdx < 0 || lightIdx >= 32) return 1.0;
    int firstSlot = int(uShadows.firstSlotPerLight[lightIdx >> 2][lightIdx & 3]);
    if (firstSlot < 0) return 1.0;
    // Meme projection perspective que les omni, donc meme correction :
    // le biais doit croitre avec la distance a la lumiere.
    float farS  = max(uShadows.slots[firstSlot].lightPosOrDir.w, 0.001);
    float distS = clamp(length(worldPos - uShadows.slots[firstSlot].lightPosOrDir.xyz) / farS,
                        0.0, 1.0);
    // Meme moderation que les omni : x24 devorait l'ombre au loin, et le
    // plan lointain double rend le gros biais inutile.
    biasMul *= 1.0 + 4.0 * distS * distS;
    float bias = NkShadowSlopeBiasMul(N, L, biasMul);
    vec3  wp   = NkShadowNormalBiasOffsetSlot(firstSlot, worldPos, N, L);
    // Aucune limite propre a l'ombre (meme regle que les omni) : elle meurt
    // avec l'attenuation de la lumiere, pas avec un rayon a elle.
    return NkSampleShadowTile(firstSlot, wp, bias, dWdx, dWdy);
}

// Dispatch par type de light. Lit le type via uLights.positions[i].w
// (encode 0/1/2/3 pour DIR/POINT/SPOT/AREA cote C++).
// biasMul : multiplicateur per-material du shadowBias (1.0 default).
float SampleLightShadowEx(int lightIdx, vec3 worldPos, vec3 N, vec3 L, float biasMul) {
    int type = int(uLights.positions[lightIdx].w);
    // Derivees ecran de worldPos, prises ICI et pas plus bas : les appelants
    // (pbr/layered) invoquent cette fonction sous des branches UNIFORMES
    // (parametres d'objet et de lumiere, identiques pour tout le draw), alors
    // que la selection de cascade/face diverge pixel par pixel -- une derivee
    // y serait indefinie. Elles nourrissent le biais du plan recepteur du PCF.
    vec3 dWdx = dFdx(worldPos);
    vec3 dWdy = dFdy(worldPos);
    if (type == 0) return NkSampleDirectionalShadow(lightIdx, worldPos, N, L, biasMul, dWdx, dWdy);
    if (type == 1) return NkSamplePointShadow      (lightIdx, worldPos, N, L, biasMul, dWdx, dWdy);
    if (type == 2) return NkSampleSpotShadow       (lightIdx, worldPos, N, L, biasMul, dWdx, dWdy);
    // SURFACIQUE : meme echantillonnage qu'un spot, parce que le CPU lui alloue
    // desormais une tuile de type SPOT (cf. AllocSlotsForLights, cas NK_AREA).
    // Un panneau n'eclaire que d'un cote : un tronc perspectif large decrit donc
    // correctement ce qu'il occulte. Avant, ce cas retournait 1.0 -- une
    // surfacique traversait toute la geometrie sans jamais projeter d'ombre.
    if (type == 3) return NkSampleSpotShadow       (lightIdx, worldPos, N, L, biasMul, dWdx, dWdy);
    return 1.0;
}
// Wrapper backward-compatible : biasMul = 1.0 (utilise par Toon/Anime qui n'ont
// pas encore d'override shadow dans leur material UBO).
float SampleLightShadow(int lightIdx, vec3 worldPos, vec3 N, vec3 L) {
    return SampleLightShadowEx(lightIdx, worldPos, N, L, 1.0);
}

#endif // NK_SHADOW_ATLAS_GLSLI

// AUTEUR : TEUGUIA TADJUIDJE Rodolf Séderis — Rihen
// ============================================================================
// shadowskinned.vert.nksl — NKRenderer — Ombre des maillages A SQUELETTE (NkSL)
// Compilé par NkSLCompiler vers : GLSL-GL · GLSL-Vulkan · HLSL-DX11/DX12 · MSL
//
// (08/10/2026) Version depth-only du shader Skin : le MEME skinning linéaire
// (4 influences par sommet, os lus dans NkBonesUBO, set 1 binding 4), projeté
// dans l'atlas d'ombre par lightVP (push constant) au lieu de la caméra.
// Jusqu'ici la passe d'ombre ne parcourait que les objets statiques et les
// instanciés : un personnage animé ne projetait aucune ombre.
//
// LES ENTRÉES SONT CELLES DE skin.vert.nksl, DANS LE MÊME ORDRE, même si seules
// la position et les os servent : le générateur HLSL numérote les TEXCOORD dans
// l'ordre des déclarations (uv = TEXCOORD0, uv2 = TEXCOORD1, os = TEXCOORD2 et 3,
// cf. NkRender3D::EnsureSkinPipeline). En retirer une décalerait les os sur DX11
// et DX12.
//
// AUCUNE SORTIE (depth-only) : le générateur GL ne retourne donc pas Y, comme
// pour shadow.vert.nksl — cohérent avec l'échantillonnage de l'atlas.
// ============================================================================

@location(0) in vec3 aPos;
@location(1) in vec3 aNormal;
@location(2) in vec3 aTangent;
@location(3) in vec2 aUV;
@location(4) in vec2 aUV2;
@location(5) in vec4 aColor;
@location(6) in vec4 aBoneIdx;     // indices d'os (stockés en float)
@location(7) in vec4 aBoneWeight;  // poids du skinning linéaire

@binding(set=1, binding=1)
uniform ObjectUBO {
    mat4  model;
    mat4  normalMatrix;
    vec4  tint;
    float metallic;
    float roughness;
    float aoStrength;
    float emissiveStrength;
    float normalStrength;
    float clearcoat;
    float clearcoatRoughness;
    float subsurface;
    vec4  subsurfaceColor;
    vec4  shadowOverrides;
    vec4  triplanarParams;
} uObj;

// Les matrices d'os (= transformation globale x inverse de la pose de liaison).
@binding(set=1, binding=4)
uniform NkBonesUBO {
    mat4 bones[64];
} uBones;

// lightVP (push constant) — même convention que shadow.vert.nksl (la correction
// Z clip-space VK/DX est déjà bakée dans lightVP côté C++).
layout(push_constant) uniform PC {
    mat4 lightVP;
} pc;

@stage(vertex)
@entry
void main() {
    // Le skinning de skin.vert.nksl, à l'identique (un sommet sans influence
    // garde sa pose de liaison).
    ivec4 bi = clamp(ivec4(aBoneIdx + 0.5), ivec4(0), ivec4(63));
    mat4 skinMat = aBoneWeight.x * uBones.bones[bi.x]
                 + aBoneWeight.y * uBones.bones[bi.y]
                 + aBoneWeight.z * uBones.bones[bi.z]
                 + aBoneWeight.w * uBones.bones[bi.w];
    float wsum = aBoneWeight.x + aBoneWeight.y + aBoneWeight.z + aBoneWeight.w;
    bool noSkin = (wsum < 1e-4);
    vec4 skinnedPos = noSkin ? vec4(aPos, 1.0) : (skinMat * vec4(aPos, 1.0));
    gl_Position = pc.lightVP * uObj.model * skinnedPos;
}

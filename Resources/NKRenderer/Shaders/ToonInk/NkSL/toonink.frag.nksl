// toonink.frag.nksl — NKRenderer — Toon Encre / Manga Fragment (VRAI dialecte NkSL).
// Cel shading + hachures procedurales en zone d'ombre + contour a l'encre par
// derivees ecran. Liaisons MODERNES (NkToonParams set=2 binding=8, albedo
// set=2 binding=3) : l'ancien .vk.glsl declarait ToonUBO en set=0 binding=4 et
// tAlbedo en set=1 binding=4 — des emplacements que le systeme de materiaux ne
// remplit pas, le shader lisait du vide.
@location(0) in vec3 vWorldPos;
@location(1) in vec3 vNormal;
@location(2) in vec2 vUV;
@location(3) in vec4 vColor;
@location(0) out vec4 fragColor;

@binding(set=0, binding=0)
uniform CameraUBO {
    mat4  view, proj, viewProj, invViewProj;
    vec4  camPos, camDir; vec2 viewport; float time, deltaTime;
    float iblStrength;
    float _p0, _p1, _p2;
    mat4  mirrorViewProj;
    vec4  reflectionFlags;
} uCam;

@binding(set=1, binding=1)
uniform ObjectUBO {
    mat4  model, normalMatrix; vec4 tint;
    float metallic, roughness, aoStrength, emissiveStrength;
    float normalStrength, clearcoat, clearcoatRoughness, subsurface;
    vec4  subsurfaceColor;
    vec4  shadowOverrides;
    vec4  triplanarParams;
} uObj;

@binding(set=0, binding=2)
uniform LightsUBO {
    vec4  positions[32], colors[32], directions[32], angles[32];
    int   count; int _pad0; int _pad1; int _pad2;
} uLights;

struct NkShadowSlot {
    mat4 shadowMatrix;
    vec4 tileUV;
    vec4 lightPosOrDir;
    vec4 packedIds;
};
@binding(set=0, binding=3)
uniform ShadowSlotsUBO {
    NkShadowSlot slots[256];
    vec4 firstSlotPerLight[8];
    vec4 slotCountPerLight[8];
    vec4 globalCfg;
    vec4 biasParams;
} uShadows;
@binding(set=0, binding=11) uniform sampler2DShadow tShadowAtlas;
// Atlas BRUT (non comparatif) : exige par le mode PCSS de NkShadowAtlas.glsli.
@binding(set=0, binding=12) uniform sampler2D tShadowAtlasRaw;
#include "Include/NkShadowAtlas.glsli"

// Meme layout que NkToonParams (upload C++ partage Toon/ToonInk/Anime).
@binding(set=2, binding=8)
uniform ToonUBO {
    vec4  albedoColor;
    vec4  shadowColor;
    float shadowThreshold;
    float shadowSmooth;
    float outlineWidth;
    float rimIntensity;
    vec4  outlineColor;
    vec4  rimColor;
    float specHardness;
    float metallic;
    float matcapStrength;
    float _pad;
} uToon;

@binding(set=2, binding=3) uniform sampler2D tAlbedo;

@stage(fragment)
@entry
void main() {
    vec3 N = normalize(vNormal);
    vec3 camPosForV = uCam.camPos.xyz;
    if (uCam.reflectionFlags.x > 0.5) camPosForV.y = -camPosForV.y;
    vec3 V = normalize(camPosForV - vWorldPos);
    float NdotV = dot(N, V);

    vec4 albedo = texture(tAlbedo, vUV) * uToon.albedoColor;

    // Contour a l'encre : force du gradient ecran de N.V — silhouettes et
    // aretes vives. Derivees prises ICI, en flux uniforme (jamais en boucle :
    // X3570/X3511 sur fxc, le shader ne serait jamais cree).
    float edge    = length(vec2(dFdx(NdotV), dFdy(NdotV)));
    float inkLine = smoothstep(0.05, 0.1, edge) * clamp(uToon.outlineWidth, 0.0, 1.0);

    // Derivees ecran de worldPos pour le biais d'ombre (cf. Toon).
    vec3 dWdx = dFdx(vWorldPos);
    vec3 dWdy = dFdy(vWorldPos);

    // Hachures procedurales : rayures diagonales en espace UV, revelees dans
    // les zones d'ombre du cel — l'esthetique manga sans texture dediee.
    float hatch = step(0.5, fract((vUV.x + vUV.y) * 24.0));

    vec3 totalDiffuse = vec3(0.0);
    for (int i = 0; i < uLights.count && i < 32; i++) {
        vec4 lPos   = uLights.positions[i];
        vec3 L      = (lPos.w < 0.5)
                    ? normalize(-uLights.directions[i].xyz)
                    : normalize(lPos.xyz - vWorldPos);
        float NdotL = dot(N, L);

        // NkVSM v2 : overrides per-material (.x receiveShadow, .z biasMul).
        float shadow = (uLights.angles[i].z > 0.5 && uObj.shadowOverrides.x > 0.5)
                       ? SampleLightShadowExD(i, vWorldPos, N, L, uObj.shadowOverrides.z, dWdx, dWdy) : 1.0;

        float cel = smoothstep(uToon.shadowThreshold - uToon.shadowSmooth,
                               uToon.shadowThreshold + uToon.shadowSmooth,
                               NdotL);
        // Les hachures mordent la transition ombre/lumiere.
        float celH = clamp(cel - hatch * 0.3 * (1.0 - cel), 0.0, 1.0);
        // Pas de x intensite (.w) : meme convention que le Toon valide — le cel
        // est un aplat stylise, la radiance brute d'une surfacique le crame.
        vec3 lit   = uLights.colors[i].rgb * albedo.rgb;
        vec3 shad  = uToon.shadowColor.rgb * albedo.rgb;
        totalDiffuse += mix(shad, lit, celH) * shadow;
    }
    if (uLights.count == 0) totalDiffuse = albedo.rgb;

    float rim = pow(1.0 - max(NdotV, 0.0), 3.0) * uToon.rimIntensity;
    vec3 total = totalDiffuse + uToon.rimColor.rgb * rim;

    // L'encre par-dessus tout (silhouettes noires du manga).
    total = mix(total, uToon.outlineColor.rgb, inkLine);
    fragColor = vec4(total, albedo.a);
}

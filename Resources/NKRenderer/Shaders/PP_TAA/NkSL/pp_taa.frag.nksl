// pp_taa.frag.nksl — NKRenderer — Temporal AA (FS)
//
// PRINCIPE. Le rendu jitte la projection d'une fraction de pixel différente à
// chaque frame (séquence de Halton, cf. NkRender3D). Chaque frame échantillonne
// donc la scène à un endroit légèrement différent DANS le pixel ; en accumulant
// ces frames on obtient un super-échantillonnage gratuit, qui lisse les bords en
// escalier bien mieux que le FXAA (lequel ne fait que flouter des contrastes).
//
// REPROJECTION. Quand la caméra bouge, le pixel courant ne correspond plus au
// même point du monde que dans l'historique. On reconstruit donc la position
// MONDE du pixel depuis sa profondeur (invViewProj de la frame courante), puis
// on la reprojette avec la viewProj de la frame PRÉCÉDENTE pour savoir où lire
// l'historique. Les deux matrices sont DÉ-JITTRÉES : le jitter ne doit pas
// entrer dans la correspondance géométrique, seulement dans l'échantillonnage.
//
// LES VECTEURS DE MOUVEMENT (v2, 17/09/2026). La reprojection ci-dessus n'est
// exacte que pour la géométrie STATIQUE : un pixel d'OBJET MOBILE y est reprojeté
// comme s'il ne bougeait pas, donc il va chercher son historique là où se trouvait
// le FOND — il s'accumule avec lui, se délave et se dédouble. La cible `uMotion`
// corrige exactement cela : chaque pixel porte son propre déplacement.
//
// ⚠ CE QU'ELLE NE CORRIGE PAS, et il faut le savoir avant d'en attendre trop : la
// TRAÎNÉE derrière un objet. Un pixel de fond que l'objet vient de quitter est de
// la géométrie statique, son vecteur est nul, et son historique contient encore
// l'objet. Cela relève de la DÉSOCCLUSION, dont ce nuanceur n'a pas de test
// explicite — il faudrait la profondeur de l'image précédente, que le moteur ne
// conserve pas. C'est le clamp de voisinage qui en tient lieu, approximativement.
// Limite nommée plutôt que tue.
//
// CLAMP DE VOISINAGE. L'historique est borné à l'intervalle des 9 voisins du
// pixel courant (min/max 3x3). Dès que l'historique sort de cet intervalle il
// est incohérent (occlusion, objet mobile, changement d'éclairage) : le clamp le
// ramène dans la plage plausible, ce qui supprime le ghosting sans détecter
// explicitement les cas problématiques.

@location(0) in  vec2 vUV;
@location(0) out vec4 oColor;

@binding(set=0, binding=0) uniform sampler2D uCurrent;  // LDR tonemappé de cette frame
@binding(set=0, binding=1) uniform sampler2D uHistory;  // résultat TAA de la frame -1
@binding(set=0, binding=2) uniform sampler2D uDepth;    // profondeur de la frame courante
// VECTEURS DE MOUVEMENT (17/09/2026), RG16F, en fraction d'ecran :
//     motion = uvCourant - uvPrecedent
// Quand ils sont branches (p1.w = 1), ils REMPLACENT la reprojection par la
// profondeur pour tout pixel qui en porte un non nul. Leur interet n'est pas la
// camera -- la profondeur suffisait -- mais les OBJETS QUI BOUGENT, que la
// profondeur seule ne sait pas suivre.
@binding(set=0, binding=3) uniform sampler2D uMotion;

layout(push_constant) uniform PC {
    // Reprojection combinée = prevViewProj * invViewProj(courante) : envoie
    // directement le NDC courant (avec sa profondeur) dans le clip de la frame
    // précédente. Un seul mat4 -> 80 octets de push-constant, sous la garantie
    // Vulkan (128) et sous les root constants DX12.
    mat4  reproj;
    vec4  p0;            // (blendHistory, yFlipUV, invResW, invResH)
    vec4  p1;            // (ndcYSign, clampOn, debugMode, motionOn)
    vec4  p2;            // (motionYSign, _, _, _)
} pc;

@stage(fragment)
@entry
void main() {
    float blendHistory = pc.p0.x;
    // ndcYSign relie vUV.y au NDC Y de la frame courante. Il est DISTINCT du
    // yFlipUV d'échantillonnage du VS (p0.y) : sur DX il vaut +1 alors que le
    // yFlipUV vaut -1. Les confondre miroitait la position monde reconstruite,
    // donc lisait l'historique au mauvais endroit.
    float ndcYSign     = pc.p1.x;
    vec2  invRes       = vec2(pc.p0.z, pc.p0.w);

    vec3 current = texture(uCurrent, vUV).rgb;

    // Sonde 4 : PROFONDEUR brute en niveaux de gris. Placée AVANT tout early
    // return, car c'est justement l'early return « ciel » (depth >= 0.9999) qui
    // désactive silencieusement le TAA quand un backend ne rend pas le depth
    // lisible : l'image reste correcte mais sans aucun antialiasing.
    // ⚠️ BORNE HAUTE OBLIGATOIRE. Ce test s'écrivait `> 3.5`, donc il avalait
    // TOUS les modes suivants : la sonde 5, ajoutée le 17/09, rendait la carte de
    // profondeur au lieu du compte des rejets, et le banc lisait « 100 % sorti
    // tôt » — un chiffre parfaitement cohérent, et faux. Une sonde à borne
    // ouverte confisque tous les numéros au-dessus d'elle.
    if (pc.p1.z > 3.5 && pc.p1.z < 4.5) {
        float dz = texture(uDepth, vUV).r;
        oColor = vec4(dz, dz, dz, 1.0);
        return;
    }

    // Historique désactivé (première frame, ou blend nul) : passe-plat.
    if (blendHistory < 0.001) {
        oColor = vec4(current, 1.0);
        return;
    }

    // ── Voisinage 3x3 du pixel courant : intervalle de couleurs plausibles ──
    vec3 nMin = current;
    vec3 nMax = current;
    for (int y = -1; y <= 1; y = y + 1) {
        for (int x = -1; x <= 1; x = x + 1) {
            vec2 o = vec2(float(x), float(y)) * invRes;
            vec3 c = texture(uCurrent, vUV + o).rgb;
            nMin = min(nMin, c);
            nMax = max(nMax, c);
        }
    }

    // ── Reprojection : uv courant + depth -> monde -> uv précédent ──────────
    float depth = texture(uDepth, vUV).r;
    // Ciel / rien écrit : aucune position monde exploitable, on garde l'image
    // courante (le ciel ne bénéficie pas du TAA, il n'a pas de bord dur).
    if (depth >= 0.9999) {
        oColor = vec4(current, 1.0);
        return;
    }

    vec4 ndc = vec4(vUV.x * 2.0 - 1.0, ndcYSign * (vUV.y * 2.0 - 1.0), depth, 1.0);
    vec4 prevClip = pc.reproj * ndc;
    if (prevClip.w <= 1e-6) {           // derrière la caméra d'avant
        oColor = vec4(current, 1.0);
        return;
    }
    vec3 prevNdc = prevClip.xyz / prevClip.w;
    vec2 prevUV = vec2(prevNdc.x * 0.5 + 0.5,
                       (ndcYSign * prevNdc.y) * 0.5 + 0.5);

    // Hors écran : pas d'historique valide pour ce pixel (il vient d'entrer
    // dans le champ) -> pas d'accumulation, sinon on lirait un bord étiré.
    if (prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0) {
        oColor = vec4(current, 1.0);
        return;
    }

    // ── LES VECTEURS DE MOUVEMENT, QUAND ILS SONT BRANCHES ──────────────────
    // Politique de repli, ECRITE AVANT d'etre codee, et COMPTABLE (cf. la sonde 5
    // plus bas). Il n'y a pas de repli muet ici : chaque cas a un nom et une
    // couleur.
    //   VECTEUR    : le pixel porte un deplacement non nul  -> on l'utilise
    //   PROFONDEUR : deplacement nul (fond, ou objet statique) -> reprojection
    //                geometrique, le chemin d'avant
    //   HORS-ECRAN : l'UV vise sort de [0,1] -> aucune accumulation
    // ⚠️ La DESOCCLUSION n'a pas de test explicite : il faudrait la profondeur de
    // l'image -1, que le moteur ne conserve pas. C'est le clamp de voisinage qui
    // en tient lieu. Limite connue, ecrite plutot que tue.
    float source = 0.0; // 0 = PROFONDEUR, 1 = VECTEUR
    if (pc.p1.w > 0.5) {
        vec2 mv = texture(uMotion, vUV).rg;
        // Le signe Y relie la convention de la cible de mouvement (NDC du dorsal,
        // sans retournement) a celle des UV d'echantillonnage de CETTE passe.
        // Il est pousse par le C++ et mesurable en A/B : les deux conventions ne
        // s'accordent pas d'un dorsal a l'autre, et le deviner a deja coute une
        // nuit sur le yFlip du meme fichier.
        mv.y = mv.y * pc.p2.x;
        // Le seuil est la QUANTIFICATION du format, pas un reglage : sous un
        // demi-millieme d'ecran, un deplacement ne deplace aucun texel.
        if (abs(mv.x) > 0.0005 || abs(mv.y) > 0.0005) {
            prevUV = vUV - mv;
            source = 1.0;
            if (prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0) {
                // HORS-ECRAN : ce pixel n'existait pas dans l'image d'avant.
                oColor = vec4(current, 1.0);
                return;
            }
        }
    }

    vec3 history = texture(uHistory, prevUV).rgb;

    // Sonde 5 : LE COMPTE DES REJETS, rendu VISIBLE. Un repli qu'on ne peut pas
    // compter est un repli qu'on ne saura jamais trop frequent.
    //   rouge = VECTEUR (le deplacement a servi)
    //   vert  = PROFONDEUR (repli geometrique)
    // Les pixels HORS-ECRAN et SANS-HISTOIRE sont sortis plus haut : ils gardent
    // l'image courante, donc ils ne sont NI rouges NI verts, et c'est ainsi que le
    // banc les distingue.
    if (pc.p1.z > 4.5 && pc.p1.z < 5.5) {
        oColor = vec4(source, 1.0 - source, 0.0, 1.0);
        return;
    }

    // ── Sondes de diagnostic (p1.z, via NK_TAA_DEBUG) ───────────────────────
    // 1 = historique BRUT reprojeté : noir => l'historique n'arrive pas ;
    //     correct mais décalé => la reprojection est en cause.
    // 2 = historique lu à l'UV COURANT (sans reprojection) : isole la lecture
    //     de la texture du calcul de reprojection.
    // 3 = |prevUV - vUV| amplifié x20 (rouge=x, vert=y) : amplitude du décalage.
    if (pc.p1.z > 0.5) {
        if (pc.p1.z < 1.5) {
            oColor = vec4(history, 1.0);
        } else if (pc.p1.z < 2.5) {
            oColor = vec4(texture(uHistory, vUV).rgb, 1.0);
        } else {
            vec2 d = abs(prevUV - vUV) * 20.0;
            oColor = vec4(d.x, d.y, 0.0, 1.0);
        }
        return;
    }
    // Clamp de voisinage : borne l'historique aux couleurs présentes autour du
    // pixel courant. C'est ce qui tue le ghosting des objets mobiles.
    // Désactivable (p1.y = 0, via NK_TAA_CLAMP=0) parce qu'il MASQUE aussi les
    // erreurs de reprojection : c'est le seul moyen de mesurer en A/B si les
    // conventions Y d'un backend sont bonnes, l'erreur devenant alors visible.
    if (pc.p1.y > 0.5) {
        history = clamp(history, nMin, nMax);
    }

    oColor = vec4(mix(current, history, clamp(blendHistory, 0.0, 0.98)), 1.0);
}

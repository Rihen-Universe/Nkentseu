// pbr.vert.nksl — NKRenderer — PBR Vertex (VRAI dialecte NkSL)
// Traduit de PBR/VK/pbr.vert.vk.glsl. TBN + planar reflection (un-mirror Y en passe miroir).

@location(0) in vec3 aPos;
@location(1) in vec3 aNormal;
@location(2) in vec3 aTangent;
@location(3) in vec2 aUV;
@location(4) in vec2 aUV2;
@location(5) in vec4 aColor;

@binding(set=0, binding=0)
uniform CameraUBO {
    mat4  view;
    mat4  proj;
    mat4  viewProj;
    mat4  invViewProj;
    vec4  camPos;
    vec4  camDir;
    vec2  viewport;
    float time;
    float deltaTime;
    float iblStrength;
    float _p0;
    float viewMode;
    float matcapId;
    mat4  mirrorViewProj;
    vec4  reflectionFlags;
    vec4  viewOpts;      // non lu ici, mais OBLIGATOIRE : cf. note ci-dessous
} uCam;
// NOTE : en OpenGL, les deux etages d'un MEME programme doivent declarer un bloc
// uniforme A L'IDENTIQUE. Omettre viewOpts cote vertex fait echouer le LINK avec
// « struct type mismatch between shaders for uniform (named CameraUBO) », alors que
// chaque etage compile parfaitement de son cote. Toute evolution de CameraUBO doit
// donc etre appliquee AUX DEUX fichiers, meme si un seul s'en sert.

@binding(set=1, binding=1)
uniform ObjectUBO {
    mat4  model;
    mat4  normalMatrix;
    vec4  tint;
    float metallic;
    float roughness;
    float aoStrength;
    float emissiveStrength;
    float normalStrength;
    float clearcoat;
    float clearcoatRoughness;
    float subsurface;
    vec4  subsurfaceColor;
    vec4  shadowOverrides;
    vec4  triplanarParams;
} uObj;

@location(0) out vec3 vWorldPos;
@location(1) out vec3 vNormal;
@location(2) out vec3 vTangent;
@location(3) out vec3 vBitangent;
@location(4) out vec2 vUV;
@location(5) out vec2 vUV2;
@location(6) out vec4 vColor;

@stage(vertex)
@entry
void main() {
    vec4 worldPos_mirror = uObj.model * vec4(aPos, 1.0);
    vec4 worldPos_real   = worldPos_mirror;

    mat3 nm        = mat3(uObj.normalMatrix);
    vec3 N_mirror  = normalize(nm * aNormal);
    vec3 N_real    = N_mirror;

    // TANGENTE ROBUSTE (anti-NaN). L'ancien code faisait
    //     T = normalize(T - dot(T,N)*N)
    // SANS verifier que le residu de Gram-Schmidt est non nul. Si la tangente fournie
    // est COLINEAIRE a la normale (cas reel : maillage d'edition dont la tangente etait
    // figee a (1,0,0) -> faces +-X d'un cube), le residu vaut exactement 0 et
    // normalize(0) = 0/0 = NaN. Le NaN contamine T, B, puis N = normalize(TBN*nTs) dans
    // le fragment ; en mode d'affichage NORMAL (color = N*0.5+0.5, sans clamp) il sort
    // tel quel dans la cible HDR, puis la chaine de BLOOM l'etale en un gros RECTANGLE
    // BLANC aligne ecran. Identique sur GL/VK/DX (arithmetique IEEE, pas du RHI).
    // On retombe desormais TOUJOURS sur une base orthonormee valide.
    vec3 fallbackAxis = abs(N_mirror.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T_mirror;
    vec3 tRaw = nm * aTangent;
    tRaw = tRaw - dot(tRaw, N_mirror) * N_mirror; // Gram-Schmidt (non normalise)
    if (dot(tRaw, tRaw) > 1e-12) {
        T_mirror = normalize(tRaw);
    } else {
        T_mirror = normalize(cross(fallbackAxis, N_mirror));
    }
    vec3 T_real = T_mirror;

    // Passe miroir : un-mirror Y (espace "real geometry" pour lighting/shadow/IBL).
    if (uCam.reflectionFlags.x > 0.5) {
        worldPos_real.y = -worldPos_real.y;
        N_real.y        = -N_real.y;
        T_real.y        = -T_real.y;
    }
    vec3 B_real = cross(N_real, T_real);

    vWorldPos  = worldPos_real.xyz;
    vNormal    = N_real;
    vTangent   = T_real;
    vBitangent = B_real;

    vUV    = aUV;
    vUV2   = aUV2;
    vColor = aColor * uObj.tint;

    gl_Position = uCam.viewProj * worldPos_mirror;
}

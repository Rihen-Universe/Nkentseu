// pp_ssao.frag.nksl — NKRenderer — SSAO v1 « Alchemy » (VRAI dialecte NkSL).
//
// POURQUOI UNE V1 COMPLÈTE. La v0 comparait des profondeurs NDC brutes dans un
// disque ÉCRAN fixe, sans normale : toute face plane vue de biais avait un
// gradient de profondeur supérieur au biais et S'AUTO-OCCLUDAIT — les 16 taps
// entraient/sortaient un à un de la fenêtre le long du gradient, dessinant des
// anneaux d'iso-profondeur (le « moiré » constaté sur les faces du cube,
// 2026-08-09). Une AO qui ignore l'orientation de la surface ne peut pas
// distinguer « pente » de « occlusion » : le défaut était structurel, pas un
// réglage.
//
// CE QUE FAIT LA V1 (estimateur d'obscurance d'Alchemy, McGuire 2011) :
//   1. position MONDE reconstruite depuis la profondeur (invViewProj — la
//      matrice RÉELLEMENT utilisée par la frame, clipZ01 et jitter compris) ;
//   2. NORMALE reconstruite par différences de profondeur, en choisissant de
//      chaque côté le voisin le plus proche en profondeur (sinon la normale
//      d'un pixel de silhouette enjambe deux surfaces) ;
//   3. taps en spirale de Vogel dans un disque écran dont le rayon est un
//      RAYON MONDE projeté (métres -> pixels selon la distance ; constant en
//      ortho) — l'AO ne change plus d'échelle quand la caméra avance ;
//   4. rotation de la spirale par pixel via bruit IGN (Jimenez) — la
//      structure fixe devient du grain, que le flou 5x5 aval efface ;
//   5. occlusion = max(0, dot(v,N) - biais) / (dot(v,v) + eps) : nulle par
//      construction sur un plan (dot(v,N) = 0), forte pour la géométrie qui
//      SURPLOMBE. Pas de fenêtre de profondeur à régler.
//
// CONVENTIONS (les mêmes que le TAA, mesurées à l'écran sur GL/VK/DX) :
//   - la profondeur échantillonnée EST le NDC z en [0,1] sur TOUS les
//     backends (clipZ01 est composé dans la projection, GL compris via
//     glClipControl) ;
//   - ndc.y = ndcYSign * (2v - 1), ndcYSign = +1 DX, -1 GL/VK.
@location(0) in  vec2 vUV;
@location(0) out vec4 oColor;

@binding(set=0, binding=0) uniform sampler2D uDepth;

layout(push_constant) uniform PC {
    mat4 invViewProj;   // NDC (depth brute) -> MONDE
    vec4 camPos;        // .xyz position camera monde, .w = focalY (P11 du proj)
    vec4 camFwd;        // .xyz avant camera monde,    .w = aspect (w/h)
    vec4 p0;            // invResW, invResH, rayonMonde, intensite
    vec4 p1;            // yFlipUV, ndcYSign, biaisMonde, orthoFlag
} pc;

vec3 NkWorldPos(vec2 uv, float d, float ySign) {
    vec4 ndc = vec4(uv.x * 2.0 - 1.0, ySign * (uv.y * 2.0 - 1.0), d, 1.0);
    vec4 w = pc.invViewProj * ndc;
    return w.xyz / w.w;
}

@stage(fragment)
@entry
void main() {
    vec2  invRes    = vec2(pc.p0.x, pc.p0.y);
    float radiusW   = pc.p0.z;
    float intensity = pc.p0.w;
    float ySign     = pc.p1.y;
    float biasW     = pc.p1.z;
    float orthoOn   = pc.p1.w;

    float d = texture(uDepth, vUV).r;
    // Ciel / rien d'écrit : rien à occlure (même early-out que TAA/v0).
    if (d >= 0.9999) { oColor = vec4(1.0); return; }

    vec3 P = NkWorldPos(vUV, d, ySign);

    // ── Normale par différences de profondeur ────────────────────────────
    // De chaque côté on garde le voisin dont la profondeur est la plus
    // PROCHE du centre : au bord d'un objet, l'autre voisin appartient à une
    // surface différente et la normale croisée serait fausse (halo d'AO
    // autour des silhouettes).
    // « stepU/stepV » et non « du/dv » : le cross-compilateur HLSL emet deja
    // un symbole « du » — la redefinition faisait echouer CreateShader sur DX11.
    vec2 stepU = vec2(invRes.x, 0.0);
    vec2 stepV = vec2(0.0, invRes.y);
    float dL = texture(uDepth, vUV - stepU).r;
    float dR = texture(uDepth, vUV + stepU).r;
    float dD = texture(uDepth, vUV - stepV).r;
    float dU = texture(uDepth, vUV + stepV).r;
    vec3 dPdx = (abs(dR - d) < abs(dL - d))
        ? (NkWorldPos(vUV + stepU, dR, ySign) - P)
        : (P - NkWorldPos(vUV - stepU, dL, ySign));
    vec3 dPdy = (abs(dU - d) < abs(dD - d))
        ? (NkWorldPos(vUV + stepV, dU, ySign) - P)
        : (P - NkWorldPos(vUV - stepV, dD, ySign));
    vec3 N = normalize(cross(dPdx, dPdy));
    // Orientée vers l'observateur : direction de vue par pixel en
    // perspective, avant de caméra constant en ortho.
    vec3 toEye = mix(pc.camPos.xyz - P, -pc.camFwd.xyz, orthoOn);
    if (dot(N, toEye) < 0.0) N = -N;

    // ── Rayon MONDE -> rayon écran ───────────────────────────────────────
    // Perspective : un décalage monde r à distance z couvre P11*r/z en NDC
    // vertical, soit la moitié en UV. Ortho : P11 = 1/orthoSize, constant.
    // Le rayon UV est borné : caméra collée à la surface, un noyau immense
    // n'échantillonnerait que du bruit (et détruirait le cache texture).
    float zView = max(dot(P - pc.camPos.xyz, pc.camFwd.xyz), 0.05);
    float focalY = pc.camPos.w;
    float rUVy = mix(radiusW * focalY / zView, radiusW * focalY, orthoOn) * 0.5;
    rUVy = min(rUVy, 0.15);
    vec2 rUV = vec2(rUVy / max(pc.camFwd.w, 1e-3), rUVy);

    // ── Bruit IGN (Interleaved Gradient Noise, Jimenez 2014) ─────────────
    // Un angle par pixel, aucun binding de texture : la répartition spatiale
    // est déjà « bleue » à l'échelle du noyau du flou 5x5 qui suit.
    vec2 px = vUV / invRes;
    float ign = fract(52.9829189 * fract(0.06711056 * px.x + 0.00583715 * px.y));
    float baseAng = ign * 6.2831853;

    // ── Spirale de Vogel, 12 taps ────────────────────────────────────────
    // Angle d'or : chaque tap couvre un secteur différent, quel que soit le
    // nombre de taps. Le rayon en sqrt répartit les taps uniformément en
    // AIRE, pas en couronne.
    float occ = 0.0;
    for (int i = 0; i < 12; i++) {
        float fi  = float(i);
        float ang = baseAng + fi * 2.3999632;              // angle d'or
        float rad = sqrt((fi + 0.5) / 12.0);
        vec2 offs = vec2(cos(ang), sin(ang)) * rad * rUV;
        vec2 uvS  = vUV + offs;
        // Hors écran : le clamp du sampler étirerait le bord en fausse
        // géométrie proche -> on ignore le tap.
        if (uvS.x > 0.0 && uvS.x < 1.0 && uvS.y > 0.0 && uvS.y < 1.0) {
            float dS = texture(uDepth, uvS).r;
            if (dS < 0.9999) {
                vec3 Q = NkWorldPos(uvS, dS, ySign);
                vec3 v = Q - P;
                float vv = dot(v, v);
                float vn = dot(v, N) - biasW;
                // 1/(vv+eps) : un occludeur lointain pèse quadratiquement
                // moins -- c'est le falloff, aucune fenêtre à régler.
                occ += max(vn, 0.0) / (vv + 1e-4);
            }
        }
    }

    // Normalisation d'Alchemy : le facteur 2*rayon rend la somme (en 1/m)
    // sans dimension -- l'intensité garde le même sens à toute échelle.
    float ao = clamp(1.0 - occ * (2.0 * radiusW * intensity / 12.0), 0.0, 1.0);
    oColor = vec4(ao, 0.0, 0.0, 1.0);
}
